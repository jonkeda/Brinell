<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Brinell.Samples.Todo.Mixed.UITests</RootNamespace>
    <Description>UI tests that drive several Todo apps at once: Windows, Android and web, on one backend.</Description>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- RootDirectory null puts artifacts in the repository's TestResults (AD-007). -->
    <None Include="brinell.maui.config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Brinell.Samples.Todo.TestSupport.Apps\Brinell.Samples.Todo.TestSupport.Apps.csproj" />
  </ItemGroup>

</Project>
