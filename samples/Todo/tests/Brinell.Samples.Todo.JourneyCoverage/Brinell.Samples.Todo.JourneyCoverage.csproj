<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Brinell.Samples.Todo.JourneyCoverage</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The test projects whose traits are compared with journeys.md. Referenced only to read their
      attributes: nothing here runs their tests or launches the app. Unit and integration tests
      are loaded, so a theory's MemberData can be counted.
    -->
    <ProjectReference Include="..\Brinell.Samples.Todo.UnitTests\Brinell.Samples.Todo.UnitTests.csproj" />
    <ProjectReference Include="..\Brinell.Samples.Todo.IntegrationTests\Brinell.Samples.Todo.IntegrationTests.csproj" />
    <!--
      The UI tests are only built here, for their own TFMs (the Windows and mixed ones are
      net10.0-windows), and read from their output folders as metadata (TestCatalog.UiProjects).
    -->
    <ProjectReference Include="..\Brinell.Samples.Todo.UITests\Brinell.Samples.Todo.UITests.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=net10.0-windows" />
    <ProjectReference Include="..\Brinell.Samples.Todo.Web.UITests\Brinell.Samples.Todo.Web.UITests.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=net10.0" />
    <ProjectReference Include="..\Brinell.Samples.Todo.Mixed.UITests\Brinell.Samples.Todo.Mixed.UITests.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=net10.0-windows" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scenarios, parsed as tests of the tiers their head tags name (ScenarioCatalog). -->
    <ProjectReference Include="..\..\..\..\srcnew\Brinell.Uat\Brinell.Uat.csproj" />
    <None Include="..\Brinell.Samples.Todo.Uat\Features\**\*.feature.md" Link="Features\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Brinell.Samples.Todo.Mixed.Uat\Features\**\*.feature.md" Link="Features\mixed\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\journeys.md" Link="journeys.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\manual\charters.md" Link="charters.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Brinell.Bdd" />
  </ItemGroup>

</Project>
