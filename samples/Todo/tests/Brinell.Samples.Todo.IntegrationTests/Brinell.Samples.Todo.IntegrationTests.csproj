<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Brinell.Samples.Todo.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Brinell.Samples.Todo.TestSupport\Brinell.Samples.Todo.TestSupport.csproj" />
    <!-- The real API, run in process by the contract tests. -->
    <ProjectReference Include="..\..\src\Brinell.Samples.Todo.Api\Brinell.Samples.Todo.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The service head (Service/): the MAUI suite's scenario files, of which it runs the @service ones. -->
    <None Update="bdd.config.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Brinell.Samples.Todo.Uat\Features\**\*.feature.md" Link="Features\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Brinell.Samples.Todo.Uat\Features\**\*.steps.md" Link="Features\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="ExpectedFailures\*.feature.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
