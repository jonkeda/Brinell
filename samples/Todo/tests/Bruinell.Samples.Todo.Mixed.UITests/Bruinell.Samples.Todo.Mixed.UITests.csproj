<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bruinell.Samples.Todo.Mixed.UITests</RootNamespace>
    <Description>UI tests that drive several Todo apps at once: Windows, Android and web, on one backend.</Description>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- RootDirectory null puts artifacts in the repository's TestResults (AD-007). -->
    <None Include="bruinell.maui.config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinell.Samples.Todo.TestSupport.Apps\Bruinell.Samples.Todo.TestSupport.Apps.csproj" />
  </ItemGroup>

</Project>
