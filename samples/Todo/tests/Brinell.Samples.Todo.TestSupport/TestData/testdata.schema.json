{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Todo test set",
  "type": "object",
  "properties": {
    "now": {
      "type": "string",
      "format": "date-time"
    },
    "server": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "dueDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "status": {
            "enum": [
              "Open",
              "InProgress",
              "Done"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "notes",
          "dueDate",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false
      }
    },
    "local": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "syncState": {
            "enum": [
              "Synced",
              "Pending",
              "LocalOnly"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "dueDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "default": null
          },
          "status": {
            "enum": [
              "Open",
              "InProgress",
              "Done",
              null
            ],
            "default": null
          },
          "createdAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "default": null
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "default": null
          },
          "isDeleted": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "id",
          "syncState"
        ],
        "additionalProperties": false
      }
    },
    "users": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "Active",
              "OnLeave",
              "Inactive"
            ]
          },
          "allowedUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "role": {
            "enum": [
              "Member",
              "Lead",
              "Admin"
            ]
          },
          "hoursPerWeek": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          },
          "hourlyRate": {
            "type": [
              "string",
              "number"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
          },
          "startOfDay": {
            "type": "string",
            "format": "time"
          },
          "receivesReminders": {
            "type": "boolean"
          },
          "workload": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "status",
          "allowedUntil",
          "role",
          "hoursPerWeek",
          "hourlyRate",
          "startOfDay",
          "receivesReminders",
          "workload",
          "notes",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "default": null
    },
    "localUsers": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/properties/users/items"
      },
      "default": null
    },
    "$schema": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  },
  "required": [
    "now",
    "server",
    "local"
  ],
  "additionalProperties": false
}
