<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Brinell.Samples.Todo.TestSupport</RootNamespace>
    <Description>Test sets, the database seeder and the WireMock fake backend shared by the integration and UI tiers.</Description>
    <!-- A library the test projects use, not a test project itself. -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\srcnew\Brinell.Mocking\Brinell.Mocking.csproj" />
    <ProjectReference Include="..\..\..\..\srcnew\Brinell.TestData\Brinell.TestData.csproj" />
    <!-- The head-neutral steps (Uat/), shared by the UI suites and the service suite: no UI, so Brinell.Bdd only. -->
    <ProjectReference Include="..\..\..\..\srcnew\Brinell.Bdd\Brinell.Bdd.csproj" />
    <ProjectReference Include="..\..\src\Brinell.Samples.Todo.Contracts\Brinell.Samples.Todo.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Brinell.Samples.Todo.Infrastructure\Brinell.Samples.Todo.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test sets travel inside the assembly, so every consumer reads the same files. -->
    <EmbeddedResource Include="TestData\*.json" Exclude="TestData\*.schema.json" LogicalName="TestData.%(Filename)%(Extension)" />
    <!-- And next to it, so the validator finds them where the source tree is not at hand (a CI build with mapped paths). -->
    <None Include="TestData\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Recorded API responses, served by ReturnsSample and checked by the contract tests. -->
    <None Include="ContractSamples\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
