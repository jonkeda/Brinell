<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bruinet.Samples.Todo.JourneyCoverage</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The test projects whose traits are compared with journeys.md. Referenced only to read their
      attributes: nothing here runs their tests or launches the app. Unit and integration tests
      are loaded, so a theory's MemberData can be counted.
    -->
    <ProjectReference Include="..\Bruinet.Samples.Todo.UnitTests\Bruinet.Samples.Todo.UnitTests.csproj" />
    <ProjectReference Include="..\Bruinet.Samples.Todo.IntegrationTests\Bruinet.Samples.Todo.IntegrationTests.csproj" />
    <!--
      The UI tests are only built here, for their own TFMs (the Windows and mixed ones are
      net10.0-windows), and read from their output folders as metadata (TestCatalog.UiProjects).
      No SetTargetFramework: on a single-TFM project it is a second global property, so a
      solution build would build the project twice at once into one obj folder.
    -->
    <ProjectReference Include="..\Bruinet.Samples.Todo.UITests\Bruinet.Samples.Todo.UITests.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\Bruinet.Samples.Todo.Web.UITests\Bruinet.Samples.Todo.Web.UITests.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\Bruinet.Samples.Todo.Mixed.UITests\Bruinet.Samples.Todo.Mixed.UITests.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scenarios, parsed as tests of the tiers their head tags name (ScenarioCatalog). -->
    <ProjectReference Include="..\..\..\..\src\Bruinet.Uat\Bruinet.Uat.csproj" />
    <None Include="..\Bruinet.Samples.Todo.Uat\Features\**\*.feature.md" Link="Features\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Bruinet.Samples.Todo.Mixed.Uat\Features\**\*.feature.md" Link="Features\mixed\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\journeys.md" Link="journeys.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\manual\charters.md" Link="charters.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Bruinet.Bdd" />
  </ItemGroup>

</Project>
