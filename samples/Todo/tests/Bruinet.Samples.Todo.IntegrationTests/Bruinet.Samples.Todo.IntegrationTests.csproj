<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bruinet.Samples.Todo.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <!-- The service suite runs on the UAT test base: refusing a UI step (UATB013) needs the UI step patterns. -->
    <ProjectReference Include="..\..\..\..\srcnew\Bruinet.Uat\Bruinet.Uat.csproj" />
    <ProjectReference Include="..\Bruinet.Samples.Todo.TestSupport\Bruinet.Samples.Todo.TestSupport.csproj" />
    <!-- The real API, run in process by the contract tests. -->
    <ProjectReference Include="..\..\src\Bruinet.Samples.Todo.Api\Bruinet.Samples.Todo.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The service head (Service/): the MAUI suite's scenario files, of which it runs the @service ones. -->
    <None Update="bdd.config.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Bruinet.Samples.Todo.Uat\Features\**\*.feature.md" Link="Features\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Bruinet.Samples.Todo.Uat\Features\**\*.steps.md" Link="Features\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="ExpectedFailures\*.feature.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Bruinet.Bdd" />
  </ItemGroup>

</Project>
