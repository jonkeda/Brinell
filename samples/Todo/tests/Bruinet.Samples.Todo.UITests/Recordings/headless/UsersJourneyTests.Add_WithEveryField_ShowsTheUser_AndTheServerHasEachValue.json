    {
      "Index": 2,
      "Kind": "non-query",
      "Text": "INSERT INTO users (id, name, email, status, allowed_until, role, hours_per_week, hourly_rate_cents, start_minutes, receives_reminders, workload, notes, updated_at)\nVALUES ($id, $name, $email, $status, $until, $role, $hours, $rate, $start, $reminders, $workload, $notes, $updated)\nON CONFLICT(id) DO UPDATE SET\n    name = excluded.name,\n    email = excluded.email,\n    status = excluded.status,\n    allowed_until = excluded.allowed_until,\n    role = excluded.role,\n    hours_per_week = excluded.hours_per_week,\n    hourly_rate_cents = excluded.hourly_rate_cents,\n    start_minutes = excluded.start_minutes,\n    receives_reminders = excluded.receives_reminders,\n    workload = excluded.workload,\n    notes = excluded.notes,\n    updated_at = excluded.updated_at;",
      "Parameters": {
