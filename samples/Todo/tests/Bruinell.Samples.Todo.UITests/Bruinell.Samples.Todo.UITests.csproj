<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bruinell.Samples.Todo.UITests</RootNamespace>
    <!-- FlaUI drives the Windows app. -->
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\srcnew\Bruinell.Core\Bruinell.Core.csproj" />
    <ProjectReference Include="..\..\..\..\srcnew\Bruinell.Maui\Bruinell.Maui.csproj" />
    <ProjectReference Include="..\..\..\..\srcnew\Bruinell.Maui.CommunityToolkit\Bruinell.Maui.CommunityToolkit.csproj" />
    <ProjectReference Include="..\..\..\..\srcnew\Bruinell.Maui.FlaUI\Bruinell.Maui.FlaUI.csproj" />
    <!-- Loaded by name for an Android run; see Bruinell.Maui.UITests.csproj. -->
    <ProjectReference Include="..\..\..\..\srcnew\Bruinell.Maui.Appium\Bruinell.Maui.Appium.csproj" />
    <!-- UAT opt-in naming ([UatName]) for controls the name inference does not reach, e.g. Status. -->
    <ProjectReference Include="..\..\..\..\srcnew\Bruinell.Uat\Bruinell.Uat.csproj" />
    <!-- Scenarios, the database seeder and the WireMock fake backend, shared with the integration tier. -->
    <ProjectReference Include="..\Bruinell.Samples.Todo.TestSupport\Bruinell.Samples.Todo.TestSupport.csproj" />
    <!-- The real API, started in process by the live tier (Live/LiveTodoAppFixture). -->
    <ProjectReference Include="..\..\src\Bruinell.Samples.Todo.Api\Bruinell.Samples.Todo.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- RootDirectory null puts artifacts in the repository's TestResults (AD-007); without this
         file the default is %APPDATA%/bruinell-artifacts. PascalCase on purpose: the loader binds
         case-sensitively, so the lowercase keys of Bruinell's own config file are ignored. -->
    <None Include="bruinell.maui.config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Bruinell.Bdd" />
  </ItemGroup>

</Project>
