<Project>
  <!-- The repository's Directory.Build.props: language version, nullable, warnings as errors. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>

  <!-- xUnit Assert only (AD-006). -->
  <Target Name="CheckBannedPackages" BeforeTargets="ResolvePackageAssets">
    <Error Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'FluentAssertions'))"
           Text="FluentAssertions is banned. Use xUnit Assert (AD-006)." />
  </Target>
</Project>
