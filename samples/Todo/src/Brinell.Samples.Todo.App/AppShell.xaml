<?xml version="1.0" encoding="UTF-8" ?>
<!--
    One root page and two pushed routes; no tabs and no flyout, so none of the tab-bar
    differences between Windows and Android that made the sample app leave Shell apply here.
-->
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:Brinell.Samples.Todo.App.Pages"
       x:Class="Brinell.Samples.Todo.App.AppShell"
       Title="Brinell Todo"
       FlyoutBehavior="Disabled">

    <ShellContent Route="todos"
                  Title="Todos"
                  ContentTemplate="{DataTemplate pages:TodoListPage}" />

</Shell>
