<?xml version="1.0" encoding="utf-8" ?>
<!--
    The users. Ids are the contract with the page objects the users UI tests will add.

    Every row uses the same ids (UserRow_*); item scoping keeps them apart, as on the todo list.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Brinell.Samples.Todo.Core.ViewModels;assembly=Brinell.Samples.Todo.Core"
             x:Class="Brinell.Samples.Todo.App.Pages.UserListPage"
             x:DataType="vm:UserListViewModel"
             AutomationId="UserListPage"
             Title="Users">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add" AutomationId="UserList_Add" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <Label AutomationId="UserList_Offline"
               Text="{Binding OfflineNotice}"
               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}"
               IsVisible="{Binding IsOffline}" />

        <CollectionView Grid.Row="1"
                        AutomationId="UserList_Users"
                        ItemsSource="{Binding Items}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedItem}">
            <CollectionView.EmptyView>
                <Label AutomationId="UserList_Empty"
                       Text="No users yet"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:UserRowViewModel">
                    <Grid AutomationId="UserRow"
                          Padding="8"
                          ColumnDefinitions="*,80,80"
                          ColumnSpacing="12">
                        <Label AutomationId="UserRow_Name"
                               Text="{Binding Name}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               AutomationId="UserRow_Role"
                               Text="{Binding RoleText}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="2"
                               AutomationId="UserRow_State"
                               Text="{Binding StateText}"
                               FontAttributes="Italic"
                               IsVisible="{Binding HasState}"
                               VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
