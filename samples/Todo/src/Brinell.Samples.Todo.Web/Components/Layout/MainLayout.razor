@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject WebNavigator Navigator

<div class="app">
    <header class="app-bar">Brinell Todo</header>
    <main>
        @Body
    </main>
    <DialogHost />
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
</div>

@code {
    protected override void OnInitialized() => Navigator.Attach(Navigation);

    public void Dispose() => Navigator.Detach(Navigation);
}
