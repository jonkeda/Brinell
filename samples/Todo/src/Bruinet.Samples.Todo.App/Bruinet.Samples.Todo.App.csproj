<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows first, then Android. -->
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Bruinet.Samples.Todo.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <IsPackable>false</IsPackable>

    <!-- Compiled bindings everywhere (x:DataType), so a binding typo is a build error. -->
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

    <!-- Unpackaged and self-contained on Windows: a test launches the .exe directly. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <ApplicationTitle>Bruinet Todo</ApplicationTitle>
    <ApplicationId>com.bruinet.samples.todo</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

    <!-- A UI test installs only the APK; see the sample app for why Debug must embed assemblies. -->
    <EmbedAssembliesIntoApk Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="CommunityToolkit.Maui" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinet.Samples.Todo.Core\Bruinet.Samples.Todo.Core.csproj" />
    <ProjectReference Include="..\Bruinet.Samples.Todo.Infrastructure\Bruinet.Samples.Todo.Infrastructure.csproj" />
    <!--
      The Bruinet automation handlers and gesture bridge, referenced as a project - the route the
      MAUI sample app demonstrates. Copying its sources is the other supported route.
    -->
    <ProjectReference Include="..\..\..\Bruinet.Maui.AppSupport\Bruinet.Maui.AppSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
  </ItemGroup>

</Project>
