<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Todo app's pages, view models' hosts, services and resources on plain net10.0, for the
    MauiHeadless head (docs/guides/maui-headless.md). Every file is LINKED from Bruinet.Samples.Todo.App, never copied, so
    the headless run tests the app as it is. Platforms\ and MauiProgram (the app builder and its
    handlers) stay out; a test composes the app with TodoAppServices.AddTodoApp, as MauiProgram does.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>Bruinet.Samples.Todo.App</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- As the app: compiled bindings everywhere, so a binding typo is a build error here too. -->
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
  </PropertyGroup>

  <PropertyGroup>
    <App>..\Bruinet.Samples.Todo.App\</App>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="CommunityToolkit.Maui" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinet.Samples.Todo.Core\Bruinet.Samples.Todo.Core.csproj" />
    <ProjectReference Include="..\Bruinet.Samples.Todo.Infrastructure\Bruinet.Samples.Todo.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\Bruinet.Maui.AppSupport\Bruinet.Maui.AppSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(App)**\*.cs"
             Exclude="$(App)bin\**;$(App)obj\**;$(App)Platforms\**;$(App)MauiProgram.cs;$(App)**\*.xaml.cs"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiXaml Include="$(App)**\*.xaml"
              Exclude="$(App)bin\**;$(App)obj\**;$(App)Platforms\**"
              Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(App)**\*.xaml.cs"
             Exclude="$(App)bin\**;$(App)obj\**;$(App)Platforms\**"
             Link="%(RecursiveDir)%(Filename)%(Extension)"
             DependentUpon="%(Filename)" />
  </ItemGroup>

</Project>
