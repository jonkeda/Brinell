<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Brinell.Samples.Maui.App.ViewModels"
             xmlns:viewModels2="using:Brinell.Samples.Maui.App.ViewModels2"
             x:Class="Brinell.Samples.Maui.App.Views2.FormsView"
             AutomationId="FormsContent">

    <ContentView.BindingContext>
        <viewModels2:FormsViewModel />
    </ContentView.BindingContext>

    <ScrollView AutomationId="FormsScrollView">
        <VerticalStackLayout Spacing="15" Padding="20">

            <!-- Page Header - UserFormTitle for test compatibility -->
            <Label Text="User Registration" 
                   AutomationId="UserFormTitle"
                   FontSize="28" 
                   FontAttributes="Bold" />

            <!-- Personal Info Section -->
            <Border AutomationId="PersonalInfoSection" 
                    
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Personal Information" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="PersonalInfoLabel" />

                    <!-- First Name -->
                    <Label Text="First Name" FontAttributes="Bold" />
                    <Entry AutomationId="FirstNameEntry" 
                           Placeholder="Enter first name"
                           Text="{Binding FirstName}" />

                    <!-- Last Name -->
                    <Label Text="Last Name" FontAttributes="Bold" />
                    <Entry AutomationId="LastNameEntry" 
                           Placeholder="Enter last name"
                           Text="{Binding LastName}" />

                    <!-- Email -->
                    <Label Text="Email" FontAttributes="Bold" />
                    <Entry AutomationId="EmailEntry" 
                           Placeholder="Enter email"
                           Keyboard="Email"
                           Text="{Binding Email}" />

                    <!-- Phone -->
                    <Label Text="Phone" FontAttributes="Bold" />
                    <Entry AutomationId="PhoneEntry" 
                           Placeholder="Enter phone"
                           Keyboard="Telephone"
                           Text="{Binding Phone}" />

                    <!-- Bio Editor (multi-line) -->
                    <Label Text="Bio" FontAttributes="Bold" />
                    <Editor AutomationId="BioEditor" 
                            Placeholder="Tell us about yourself..."
                            HeightRequest="100"
                            Text="{Binding Bio}" />

                    <!-- Search Bar -->
                    <Label Text="Search Users" FontAttributes="Bold" />
                    <SearchBar AutomationId="UserSearchBar" 
                               Placeholder="Search..."
                               Text="{Binding SearchText}"
                               SearchCommand="{Binding SearchCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Preferences Section -->
            <Border AutomationId="PreferencesSection" 
                    
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Preferences" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="PreferencesLabel" />

                    <!-- Newsletter Switch -->
                    <HorizontalStackLayout Spacing="10">
                        <Switch AutomationId="NewsletterSwitch" 
                                IsToggled="{Binding NewsletterSubscribed}" />
                        <Label Text="Subscribe to newsletter" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Terms CheckBox -->
                    <HorizontalStackLayout Spacing="10">
                        <CheckBox AutomationId="TermsCheckBox" 
                                  IsChecked="{Binding AgreeToTerms}" />
                        <Label Text="I agree to Terms of Service" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Privacy CheckBox -->
                    <HorizontalStackLayout Spacing="10">
                        <CheckBox AutomationId="PrivacyCheckBox" 
                                  IsChecked="{Binding AgreeToPrivacy}" />
                        <Label Text="I agree to Privacy Policy" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Indeterminate CheckBox -->
                    <HorizontalStackLayout Spacing="10">
                        <CheckBox AutomationId="IndeterminateCheckBox" 
                                  IsChecked="{Binding IndeterminateOption}" />
                        <Label Text="Optional feature (indeterminate demo)" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Selection Section -->
            <Border AutomationId="SelectionSection" 
                    
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Subscription Tier" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="SelectionLabel" />

                    <!-- Radio Buttons -->
                    <RadioButton AutomationId="BasicRadio" 
                                 Content="Basic - Free"
                                 GroupName="SubscriptionTier"
                                 IsChecked="{Binding IsBasicSelected}" />
                    <RadioButton AutomationId="ProfessionalRadio" 
                                 Content="Professional - $9.99/mo"
                                 GroupName="SubscriptionTier"
                                 IsChecked="{Binding IsProfessionalSelected}" />
                    <RadioButton AutomationId="EnterpriseRadio" 
                                 Content="Enterprise - $29.99/mo"
                                 GroupName="SubscriptionTier"
                                 IsChecked="{Binding IsEnterpriseSelected}" />

                    <!-- Pickers -->
                    <Label Text="Country" FontAttributes="Bold" />
                    <Picker AutomationId="CountryPicker"
                            Title="Select country"
                            ItemsSource="{Binding Countries}"
                            SelectedItem="{Binding SelectedCountry}" />

                    <Label Text="Department" FontAttributes="Bold" />
                    <Picker AutomationId="DepartmentPicker"
                            Title="Select department"
                            ItemsSource="{Binding Departments}"
                            SelectedItem="{Binding SelectedDepartment}" />
                </VerticalStackLayout>
            </Border>

            <!-- DateTime Section -->
            <Border AutomationId="DateTimeSection" 
                    
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Date &amp; Time" 
                           FontSize="18" 
                           FontAttributes="Bold" />

                    <!-- Birth Date -->
                    <Label Text="Birth Date" FontAttributes="Bold" />
                    <DatePicker AutomationId="BirthDatePicker" 
                                MinimumDate="1900-01-01" 
                                MaximumDate="2025-12-31" 
                                Date="{Binding BirthDate}" />

                    <!-- Preferred Contact Time -->
                    <Label Text="Preferred Contact Time" FontAttributes="Bold" />
                    <TimePicker AutomationId="PreferredTimePicker" 
                                Time="{Binding PreferredTime}" />
                </VerticalStackLayout>
            </Border>

            <!-- Range Section -->
            <Border AutomationId="RangeSection" 
                    
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Range Controls" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="RangeLabel" />

                    <!-- Font Size Slider -->
                    <Label Text="Font Size" FontAttributes="Bold" />
                    <Slider AutomationId="FontSizeSlider" 
                            Minimum="8" 
                            Maximum="72" 
                            Value="{Binding FontSize}" />
                    <Label AutomationId="FontSizeLabel" 
                           Text="{Binding FontSizeText}" 
                           HorizontalOptions="Center" />

                    <!-- Volume Slider -->
                    <Label Text="Volume" FontAttributes="Bold" />
                    <Slider AutomationId="VolumeSlider" 
                            Minimum="0" 
                            Maximum="100" 
                            Value="{Binding Volume}" />
                    <Label AutomationId="VolumeLabel" 
                           Text="{Binding VolumeText}" 
                           HorizontalOptions="Center" />

                    <!-- Quantity Stepper -->
                    <Label Text="Quantity" FontAttributes="Bold" />
                    <HorizontalStackLayout Spacing="10">
                        <Stepper AutomationId="QuantityStepper" 
                                 Minimum="1" 
                                 Maximum="99" 
                                 Increment="1"
                                 Value="{Binding Quantity}" />
                        <Label AutomationId="QuantityLabel" 
                               Text="{Binding QuantityText}" 
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Form Actions -->
            <Border AutomationId="ActionsSection" 
                    
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Button AutomationId="SubmitButton" 
                                Text="Submit" 
                                Command="{Binding SubmitCommand}" />
                        <Button AutomationId="SaveDraftButton" 
                                Text="Save Draft" 
                                Command="{Binding SaveDraftCommand}" />
                        <Button AutomationId="ClearButton" 
                                Text="Clear" 
                                Command="{Binding ClearCommand}" />
                    </HorizontalStackLayout>

                    <!-- Result Message -->
                    <Label AutomationId="ResultMessage" 
                           Text="{Binding ResultMessage}" 
                           TextColor="Blue"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
