<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Brinell.Samples.Maui.App.ViewModels"
             xmlns:viewModels2="using:Brinell.Samples.Maui.App.ViewModels2"
             x:Class="Brinell.Samples.Maui.App.Views2.GesturesView"
             AutomationId="GesturesContent">

    <ContentView.BindingContext>
        <viewModels2:AdvancedViewModel />
    </ContentView.BindingContext>

    <ScrollView AutomationId="GesturesScrollView">
        <VerticalStackLayout Spacing="15" Padding="20">

            <!-- Page Header -->
            <Label Text="Gestures Demo" 
                   AutomationId="GesturesTitle"
                   FontSize="28" 
                   FontAttributes="Bold" />

            <Label Text="Gesture recognition and advanced interactions"
                   TextColor="Gray"
                   AutomationId="GesturesSubtitle" />

            <!-- Gesture Log -->
            <Border AutomationId="GestureLogBorder" 
                    
                   Padding="10"
                   BackgroundColor="#F0F0F0">
                <VerticalStackLayout>
                    <Label Text="Gesture Log" 
                           FontAttributes="Bold"
                           AutomationId="GestureLogLabel" />
                    <Label Text="{Binding GestureLog}"
                           FontSize="10"
                           FontFamily="Consolas"
                           AutomationId="GestureLogContent"
                           HeightRequest="80" />
                </VerticalStackLayout>
            </Border>

            <!-- Tap Gesture Section -->
            <Border AutomationId="TapSection" 
                    
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Tap Gesture" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="TapSectionLabel" />

                    <Border BackgroundColor="#E3F2FD" 
                           HeightRequest="100"
                           
                           AutomationId="TapArea">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TapCommand}"
                                                  NumberOfTapsRequired="1" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" 
                                             HorizontalOptions="Center">
                            <Label Text="Tap Here"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   AutomationId="TapAreaText" />
                            <Label Text="{Binding TapCountDisplay}"
                                   HorizontalOptions="Center"
                                   AutomationId="TapCountDisplay" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Double Tap Area -->
                    <Border BackgroundColor="#E8F5E9" 
                           HeightRequest="80"
                           
                           AutomationId="DoubleTapArea">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TapCommand}"
                                                  NumberOfTapsRequired="2" />
                        </Border.GestureRecognizers>
                        <Label Text="Double Tap Area"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               AutomationId="DoubleTapText" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Swipe Section -->
            <Border AutomationId="SwipeSection" 
                    
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Swipe Gestures" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="SwipeSectionLabel" />

                    <SwipeView AutomationId="SwipeViewDemo">
                        <SwipeView.LeftItems>
                            <SwipeItems>
                                <SwipeItem Text="Archive"
                                           BackgroundColor="Green"
                                           Command="{Binding SwipeRightCommand}"
                                           AutomationId="SwipeArchive" />
                            </SwipeItems>
                        </SwipeView.LeftItems>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete"
                                           BackgroundColor="Red"
                                           Command="{Binding SwipeLeftCommand}"
                                           AutomationId="SwipeDelete" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border BackgroundColor="#E1F5FE" 
                               HeightRequest="80"
                               
                               AutomationId="SwipeContent">
                            <Label Text="← Swipe Left or Right →"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   AutomationId="SwipeText" />
                        </Border>
                    </SwipeView>

                    <Label Text="{Binding SwipeResult}"
                           TextColor="Blue"
                           AutomationId="SwipeResult" />
                </VerticalStackLayout>
            </Border>

            <!-- Container Layout Section -->
            <Border AutomationId="LayoutSection" 
                    
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Container Layouts" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="LayoutSectionLabel" />

                    <!-- Grid Layout Demo -->
                    <Label Text="Grid Layout:" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*,*" 
                          RowDefinitions="50,50"
                          ColumnSpacing="5"
                          RowSpacing="5"
                          AutomationId="GridDemo">
                        <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#FFCDD2" AutomationId="GridCell_0_0">
                            <Label Text="0,0" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#F8BBD0" AutomationId="GridCell_0_1">
                            <Label Text="0,1" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2" BackgroundColor="#E1BEE7" AutomationId="GridCell_0_2">
                            <Label Text="0,2" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#D1C4E9" AutomationId="GridCell_1_0">
                            <Label Text="1,0" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#C5CAE9" AutomationId="GridCell_1_1">
                            <Label Text="1,1" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" BackgroundColor="#BBDEFB" AutomationId="GridCell_1_2">
                            <Label Text="1,2" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- FlexLayout Demo -->
                    <Label Text="FlexLayout:" FontAttributes="Bold" />
                    <FlexLayout Wrap="Wrap" 
                                JustifyContent="SpaceEvenly"
                                AutomationId="FlexLayoutDemo">
                        <Border WidthRequest="60" HeightRequest="40" BackgroundColor="#B2DFDB" Margin="2" AutomationId="FlexItem1">
                            <Label Text="1" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border WidthRequest="80" HeightRequest="40" BackgroundColor="#B2EBF2" Margin="2" AutomationId="FlexItem2">
                            <Label Text="2" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border WidthRequest="50" HeightRequest="40" BackgroundColor="#B3E5FC" Margin="2" AutomationId="FlexItem3">
                            <Label Text="3" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border WidthRequest="70" HeightRequest="40" BackgroundColor="#DCEDC8" Margin="2" AutomationId="FlexItem4">
                            <Label Text="4" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Reset Button -->
            <Button Text="Reset All"
                    Command="{Binding ResetCommand}"
                    AutomationId="ResetGesturesButton" />

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
