<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Brinell.Samples.Maui.App.ViewModels"
             xmlns:viewModels2="using:Brinell.Samples.Maui.App.ViewModels2"
             x:Class="Brinell.Samples.Maui.App.Views2.CollectionDemoView"
             AutomationId="CollectionDemoContent">

    <ContentView.BindingContext>
        <viewModels2:ListsViewModel />
    </ContentView.BindingContext>

    <ScrollView AutomationId="CollectionDemoScrollView">
        <VerticalStackLayout Spacing="15" Padding="20">

            <!-- Page Header -->
            <Label Text="Collections Demo"
                   AutomationId="CollectionDemoTitle"
                   FontSize="28"
                   FontAttributes="Bold" />

            <!-- CarouselView Section -->
            <Border AutomationId="CarouselViewSection"
                   
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="CarouselView"
                           FontSize="18"
                           FontAttributes="Bold"
                           AutomationId="CarouselViewLabel" />

                    <Label Text="Swipe left/right to navigate between items"
                           TextColor="Gray"
                           FontSize="12" />

                    <CarouselView ItemsSource="{Binding CarouselItems}"
                                  Position="{Binding CarouselPosition}"
                                  Loop="False"
                                  HeightRequest="200"
                                  MinimumHeightRequest="200"
                                  IndicatorView="{x:Reference CarouselIndicator}"
                                  AutomationId="DemoCarouselView">
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{Binding Color}"
                                       Padding="20"
                                       AutomationId="{Binding AutomationId}">
                                    <VerticalStackLayout VerticalOptions="Center"
                                                         HorizontalOptions="Center"
                                                         Spacing="10">
                                        <Label Text="{Binding Title}"
                                               FontSize="24"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalTextAlignment="Center"
                                               AutomationId="CarouselItemTitle" />
                                        <Label Text="{Binding Subtitle}"
                                               FontSize="14"
                                               TextColor="White"
                                               HorizontalTextAlignment="Center"
                                               AutomationId="CarouselItemSubtitle" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <IndicatorView x:Name="CarouselIndicator"
                                   IndicatorColor="LightGray"
                                   SelectedIndicatorColor="DarkGray"
                                   HorizontalOptions="Center"
                                   AutomationId="CarouselIndicator" />

                    <Label Text="{Binding CarouselPosition, StringFormat='Position: {0}'}"
                           AutomationId="CarouselPositionLabel" />
                </VerticalStackLayout>
            </Border>

            <!-- TableView Section -->
            <Border AutomationId="TableViewSection"
                   
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="TableView Settings"
                           FontSize="18"
                           FontAttributes="Bold"
                           AutomationId="TableViewLabel" />

                    <Label Text="Grouped settings using TableView"
                           TextColor="Gray"
                           FontSize="12" />

                    <TableView Intent="Settings"
                               HeightRequest="300"
                               AutomationId="DemoTableView">
                        <TableRoot>
                            <TableSection Title="Account">
                                <EntryCell Label="Username"
                                           Text="{Binding Username}"
                                           AutomationId="UsernameCell" />
                                <TextCell Text="Email"
                                          Detail="john@example.com"
                                          AutomationId="EmailCell" />
                            </TableSection>
                            <TableSection Title="Preferences">
                                <SwitchCell Text="Notifications"
                                            On="{Binding NotificationsEnabled}"
                                            AutomationId="NotificationsCell" />
                                <SwitchCell Text="Dark Mode"
                                            On="{Binding DarkModeEnabled}"
                                            AutomationId="DarkModeCell" />
                            </TableSection>
                            <TableSection Title="About">
                                <TextCell Text="Version"
                                          Detail="1.0.0"
                                          AutomationId="VersionCell" />
                                <TextCell Text="Licenses"
                                          AutomationId="LicensesCell" />
                            </TableSection>
                        </TableRoot>
                    </TableView>
                </VerticalStackLayout>
            </Border>

            <!-- PaginatedList Section -->
            <Border AutomationId="PaginatedListSection"
                   
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Paginated List"
                           FontSize="18"
                           FontAttributes="Bold"
                           AutomationId="PaginatedListLabel" />

                    <Label Text="Navigate pages with Previous / Next buttons"
                           TextColor="Gray"
                           FontSize="12" />

                    <CollectionView ItemsSource="{Binding PagedItems}"
                                    HeightRequest="250"
                                    AutomationId="PagedListView">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10" ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      AutomationId="{Binding AutomationId}">
                                    <Label Text="📋" FontSize="18" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="{Binding Title}"
                                               FontAttributes="Bold"
                                               AutomationId="PagedItemTitle" />
                                        <Label Text="{Binding Detail}"
                                               TextColor="Gray"
                                               FontSize="12"
                                               AutomationId="PagedItemDetail" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,5,0,0">
                        <Button Text="◀ Previous"
                                Command="{Binding PreviousPageCommand}"
                                AutomationId="PreviousPageButton" />
                        <Label Grid.Column="1"
                               Text="{Binding PageInfoText}"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               AutomationId="PageInfoLabel" />
                        <Button Grid.Column="2"
                               Text="Next ▶"
                               Command="{Binding NextPageCommand}"
                               AutomationId="NextPageButton" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
