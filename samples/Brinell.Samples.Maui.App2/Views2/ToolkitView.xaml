<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:Brinell.Samples.Maui.App.ViewModels"
             xmlns:viewModels2="using:Brinell.Samples.Maui.App.ViewModels2"
             x:Class="Brinell.Samples.Maui.App.Views2.ToolkitView"
             AutomationId="ToolkitContent">

    <ContentView.BindingContext>
        <viewModels2:ToolkitViewModel />
    </ContentView.BindingContext>

    <ScrollView AutomationId="ToolkitScrollView">
        <VerticalStackLayout Spacing="15" Padding="20">

            <!-- Page Header -->
            <Label Text="CommunityToolkit Demo" 
                   AutomationId="ToolkitTitle"
                   FontSize="28" 
                   FontAttributes="Bold" />

            <!-- Expander Section -->
            <Border AutomationId="ExpanderSection" 
                    
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Expander Controls" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="ExpanderLabel" />

                    <HorizontalStackLayout Spacing="10" Margin="0,0,0,10">
                        <Button Text="Expand All" 
                                Command="{Binding ExpandAllCommand}"
                                AutomationId="ExpandAllButton" />
                        <Button Text="Collapse All" 
                                Command="{Binding CollapseAllCommand}"
                                AutomationId="CollapseAllButton" />
                    </HorizontalStackLayout>

                    <!-- Expander 1 -->
                    <toolkit:Expander IsExpanded="{Binding Expander1Expanded}" 
                                      AutomationId="SimpleExpander1">
                        <toolkit:Expander.Header>
                            <Border BackgroundColor="#E3F2FD" Padding="10" >
                                <Label Text="Section 1: Introduction" 
                                       FontAttributes="Bold"
                                       AutomationId="Expander1Header" />
                            </Border>
                        </toolkit:Expander.Header>
                        <toolkit:Expander.Content>
                            <Border BackgroundColor="#F5F5F5" Padding="15" Margin="0,5,0,0"
                                   AutomationId="Expander1Content">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Welcome to the Brinell MAUI Sample App!" />
                                    <Label Text="This app demonstrates various UI controls and patterns." />
                                    <Label Text="Each section can be expanded or collapsed." />
                                </VerticalStackLayout>
                            </Border>
                        </toolkit:Expander.Content>
                    </toolkit:Expander>

                    <!-- Expander 2 -->
                    <toolkit:Expander IsExpanded="{Binding Expander2Expanded}"
                                      AutomationId="SimpleExpander2">
                        <toolkit:Expander.Header>
                            <Border BackgroundColor="#E8F5E9" Padding="10" >
                                <Label Text="Section 2: Features" 
                                       FontAttributes="Bold"
                                       AutomationId="Expander2Header" />
                            </Border>
                        </toolkit:Expander.Header>
                        <toolkit:Expander.Content>
                            <Border BackgroundColor="#F5F5F5" Padding="15" Margin="0,5,0,0"
                                   AutomationId="Expander2Content">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="• Data binding with MVVM pattern" />
                                    <Label Text="• UI automation with AutomationId" />
                                    <Label Text="• CommunityToolkit.Maui controls" />
                                    <Label Text="• Platform-specific implementations" />
                                </VerticalStackLayout>
                            </Border>
                        </toolkit:Expander.Content>
                    </toolkit:Expander>

                    <!-- Expander 3 -->
                    <toolkit:Expander IsExpanded="{Binding Expander3Expanded}"
                                      AutomationId="SimpleExpander3">
                        <toolkit:Expander.Header>
                            <Border BackgroundColor="#FFF3E0" Padding="10" >
                                <Label Text="Section 3: Getting Help" 
                                       FontAttributes="Bold"
                                       AutomationId="Expander3Header" />
                            </Border>
                        </toolkit:Expander.Header>
                        <toolkit:Expander.Content>
                            <Border BackgroundColor="#F5F5F5" Padding="15" Margin="0,5,0,0"
                                   AutomationId="Expander3Content">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Need help? Check out our resources:" />
                                    <Label Text="• Documentation" TextColor="Blue" />
                                    <Label Text="• GitHub Issues" TextColor="Blue" />
                                    <Label Text="• Community Forums" TextColor="Blue" />
                                </VerticalStackLayout>
                            </Border>
                        </toolkit:Expander.Content>
                    </toolkit:Expander>
                </VerticalStackLayout>
            </Border>

            <!-- Segmented Control Style (Button Group) Section -->
            <Border AutomationId="SegmentedSection" 
                    
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Segmented Button Group" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="SegmentedLabel" />

                    <!-- Custom segmented control using buttons -->
                    <HorizontalStackLayout Spacing="0" HorizontalOptions="Center">
                        <Button Text="Info" 
                                AutomationId="SegmentInfo"
                                Clicked="OnSegmentClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                WidthRequest="80" />
                        <Button Text="Settings" 
                                AutomationId="SegmentSettings"
                                Clicked="OnSegmentClicked"
                                BackgroundColor="LightGray"
                                TextColor="Black"
                                WidthRequest="80" />
                        <Button Text="About" 
                                AutomationId="SegmentAbout"
                                Clicked="OnSegmentClicked"
                                BackgroundColor="LightGray"
                                TextColor="Black"
                                WidthRequest="80" />
                    </HorizontalStackLayout>

                    <!-- Content panels for each segment -->
                    <Border BackgroundColor="#F5F5F5" 
                           Padding="15" 
                           AutomationId="SegmentContentBorder"
                           HeightRequest="120">
                        <VerticalStackLayout x:Name="SegmentContent" AutomationId="SegmentContent">
                            <Label x:Name="SegmentTitle" 
                                   Text="Information" 
                                   FontSize="16" 
                                   FontAttributes="Bold"
                                   AutomationId="SegmentContentTitle" />
                            <Label x:Name="SegmentDescription" 
                                   Text="This demonstrates a custom segmented control. Click different segments to switch content."
                                   AutomationId="SegmentContentDescription" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Popup/Snackbar Section -->
            <Border AutomationId="PopupSection" 
                    
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Popup &amp; Snackbar" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="PopupLabel" />

                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Show Popup" 
                                Clicked="OnShowPopupClicked"
                                AutomationId="ShowPopupButton" />
                        <Button Text="Show Snackbar" 
                                Clicked="OnShowSnackbarClicked"
                                AutomationId="ShowSnackbarButton" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding PopupResult}" 
                           AutomationId="PopupResultLabel"
                           TextColor="Blue" />
                    <Label Text="{Binding SnackbarMessage}" 
                           AutomationId="SnackbarResultLabel"
                           TextColor="Green" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
