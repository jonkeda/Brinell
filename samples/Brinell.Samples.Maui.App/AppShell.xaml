<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:Brinell.Samples.Maui.App"
       xmlns:pages="clr-namespace:Brinell.Samples.Maui.App.Pages"
       x:Class="Brinell.Samples.Maui.App.AppShell"
       Title="Brinell Sample App"
       AutomationId="AppShell"
       FlyoutBehavior="Locked"
       FlyoutWidth="250">

    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="20" 
                             BackgroundColor="#512BD4"
                             AutomationId="FlyoutHeader">
            <Label Text="Brinell Samples"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   AutomationId="FlyoutTitle" />
            <Label Text="MAUI Control Demo"
                   FontSize="14"
                   TextColor="LightGray"
                   HorizontalOptions="Center"
                   AutomationId="FlyoutSubtitle" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <!-- Main Page -->
    <FlyoutItem Title="Main" 
                AutomationId="FlyoutMain">
        <ShellContent Title="Main"
                      ContentTemplate="{DataTemplate local:MainPage}"
                      Route="main"
                      AutomationId="ShellMain" />
    </FlyoutItem>

    <!-- Dashboard -->
    <FlyoutItem Title="Dashboard" 
                AutomationId="FlyoutDashboard">
        <ShellContent Title="Dashboard"
                      ContentTemplate="{DataTemplate pages:DashboardPage}"
                      Route="dashboard"
                      AutomationId="ShellDashboard" />
    </FlyoutItem>

    <!-- User Form -->
    <FlyoutItem Title="User Form" 
                AutomationId="FlyoutUserForm">
        <ShellContent Title="User Form"
                      ContentTemplate="{DataTemplate pages:UserFormPage}"
                      Route="userform"
                      AutomationId="ShellUserForm" />
    </FlyoutItem>

    <!-- Data Grid -->
    <FlyoutItem Title="Data Grid" 
                AutomationId="FlyoutDataGrid">
        <ShellContent Title="Data Grid"
                      ContentTemplate="{DataTemplate pages:DataGridPage}"
                      Route="datagrid"
                      AutomationId="ShellDataGrid" />
    </FlyoutItem>

    <!-- Media Gallery -->
    <FlyoutItem Title="Media Gallery" 
                AutomationId="FlyoutMediaGallery">
        <ShellContent Title="Media Gallery"
                      ContentTemplate="{DataTemplate pages:MediaGalleryPage}"
                      Route="mediagallery"
                      AutomationId="ShellMediaGallery" />
    </FlyoutItem>

    <!-- Navigation Demo -->
    <FlyoutItem Title="Navigation" 
                AutomationId="FlyoutNavigation">
        <ShellContent Title="Navigation"
                      ContentTemplate="{DataTemplate pages:NavigationDemoPage}"
                      Route="navigation"
                      AutomationId="ShellNavigation" />
    </FlyoutItem>

    <!-- Validation -->
    <FlyoutItem Title="Validation" 
                AutomationId="FlyoutValidation">
        <ShellContent Title="Validation"
                      ContentTemplate="{DataTemplate pages:ValidationPage}"
                      Route="validation"
                      AutomationId="ShellValidation" />
    </FlyoutItem>

    <!-- Advanced -->
    <FlyoutItem Title="Advanced" 
                AutomationId="FlyoutAdvanced">
        <ShellContent Title="Advanced"
                      ContentTemplate="{DataTemplate pages:AdvancedPage}"
                      Route="advanced"
                      AutomationId="ShellAdvanced" />
    </FlyoutItem>

    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="10" 
                             BackgroundColor="#F0F0F0"
                             AutomationId="FlyoutFooter">
            <Label Text="Brinell Framework v1.0"
                   FontSize="10"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   AutomationId="FooterVersion" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

</Shell>
