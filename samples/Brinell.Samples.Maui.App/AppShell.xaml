<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Brinell.Samples.Maui.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Brinell.Samples.Maui.App"
    Shell.FlyoutBehavior="Disabled"
    Title="Brinell MAUI Sample">

    <TabBar>
        <!-- Buttons Tab -->
        <ShellContent
            Title="Buttons"
            Icon="tab_about.png"
            ContentTemplate="{DataTemplate local:ButtonsPage}"
            Route="ButtonsPage" />

        <!-- DateTime Tab -->
        <ShellContent
            Title="DateTime"
            Icon="tab_about.png"
            ContentTemplate="{DataTemplate local:DateTimePage}"
            Route="DateTimePage" />

        <!-- Text Tab -->
        <ShellContent
            Title="Text"
            Icon="tab_about.png"
            ContentTemplate="{DataTemplate local:TextPage}"
            Route="TextPage" />

        <!-- Sliders Tab -->
        <ShellContent
            Title="Range"
            Icon="tab_about.png"
            ContentTemplate="{DataTemplate local:RangePage}"
            Route="RangePage" />

        <!-- Toggle Tab -->
        <ShellContent
            Title="Toggle"
            Icon="tab_about.png"
            ContentTemplate="{DataTemplate local:TogglePage}"
            Route="TogglePage" />
    </TabBar>

</Shell>
