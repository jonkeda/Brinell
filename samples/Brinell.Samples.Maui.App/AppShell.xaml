<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Brinell.Samples.Maui.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Brinell.Samples.Maui.App"
    Shell.FlyoutBehavior="Disabled"
    Title="Brinell MAUI Sample">

    <TabBar>
        <!-- Buttons Tab -->
        <ShellContent
            Title="Buttons"
            AutomationId="ButtonsTab"
            Icon="tab_about.png"
            ContentTemplate="{DataTemplate local:ButtonsPage}"
            Route="ButtonsPage" />

        <!-- DateTime Tab -->
        <ShellContent
            Title="DateTime"
            AutomationId="DateTimeTab"
            Icon="tab_about.png"
            ContentTemplate="{DataTemplate local:DateTimePage}"
            Route="DateTimePage" />

        <!-- Display Tab -->
        <ShellContent
            Title="Display"
            AutomationId="DisplayTab"
            Icon="tab_about.png"
            ContentTemplate="{DataTemplate local:DisplayPage}"
            Route="DisplayPage" />

        <!-- Sliders Tab -->
        <ShellContent
            Title="Range"
            AutomationId="RangeTab"
            Icon="tab_about.png"
            ContentTemplate="{DataTemplate local:RangePage}"
            Route="RangePage" />

        <!-- Selection Tab -->
        <ShellContent
            Title="Selection"
            AutomationId="SelectionTab"
            Icon="tab_about.png"
            ContentTemplate="{DataTemplate local:SelectionPage}"
            Route="SelectionPage" />

        <!-- Text Tab -->
        <ShellContent
            Title="Text"
            AutomationId="TextTab"
            Icon="tab_about.png"
            ContentTemplate="{DataTemplate local:TextPage}"
            Route="TextPage" />

        <!-- Toggle Tab -->
        <ShellContent
            Title="Toggle"
            AutomationId="ToggleTab"
            Icon="tab_about.png"
            ContentTemplate="{DataTemplate local:TogglePage}"
            Route="TogglePage" />

        <!-- Containers Tab -->
        <ShellContent
            Title="Containers"
            AutomationId="GridCollectionTab"
            Icon="tab_about.png"
            ContentTemplate="{DataTemplate local:GridCollectionPage}"
            Route="GridCollectionPage" />

        <!-- Navigation Tab -->
        <ShellContent
            Title="Navigation"
            AutomationId="NavigationTab"
            Icon="tab_about.png"
            ContentTemplate="{DataTemplate local:NavigationDemoPage}"
            Route="NavigationDemoPage" />


        <!-- Automation Probe Tab (Phase 0 measurement page) -->
        <ShellContent
            Title="Probe"
            AutomationId="AutomationProbeTab"
            Icon="tab_about.png"
            ContentTemplate="{DataTemplate local:AutomationProbePage}"
            Route="AutomationProbePage" />

    </TabBar>

</Shell>
