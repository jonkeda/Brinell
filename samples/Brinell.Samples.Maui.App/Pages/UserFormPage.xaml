<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Brinell.Samples.Maui.App.ViewModels"
             x:Class="Brinell.Samples.Maui.App.Pages.UserFormPage"
             Title="User Form"
             AutomationId="UserFormPage">

    <ContentPage.BindingContext>
        <viewmodels:UserFormViewModel />
    </ContentPage.BindingContext>

    <ScrollView AutomationId="UserFormScrollView">
        <VerticalStackLayout Spacing="15" Padding="20">

            <!-- Page Header -->
            <Label Text="User Registration" 
                   AutomationId="UserFormTitle"
                   FontSize="28" 
                   FontAttributes="Bold" />

            <!-- Text Input Section (IEntry, IEditor, ISearchBar) -->
            <Border AutomationId="TextInputSection" 
                    
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Personal Information" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="PersonalInfoLabel" />

                    <!-- Entry controls -->
                    <Entry Placeholder="First Name" 
                           Text="{Binding FirstName}"
                           AutomationId="FirstNameEntry" />
                    
                    <Entry Placeholder="Last Name" 
                           Text="{Binding LastName}"
                           AutomationId="LastNameEntry" />
                    
                    <Entry Placeholder="Email" 
                           Keyboard="Email"
                           Text="{Binding Email}"
                           AutomationId="EmailEntry" />
                    
                    <Entry Placeholder="Phone" 
                           Keyboard="Telephone"
                           Text="{Binding Phone}"
                           AutomationId="PhoneEntry" />

                    <!-- Editor (multi-line) -->
                    <Label Text="Bio" AutomationId="BioLabel" />
                    <Editor Placeholder="Tell us about yourself..."
                            Text="{Binding Bio}"
                            HeightRequest="100"
                            AutomationId="BioEditor" />

                    <!-- SearchBar -->
                    <SearchBar Placeholder="Search users..."
                               Text="{Binding SearchText}"
                               SearchCommand="{Binding SearchCommand}"
                               AutomationId="UserSearchBar" />
                </VerticalStackLayout>
            </Border>

            <!-- Toggle Section (ISwitch, ICheckBox, IRadioButton) -->
            <Border AutomationId="ToggleSection" 
                    
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Preferences" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="PreferencesLabel" />

                    <!-- Switch controls -->
                    <HorizontalStackLayout Spacing="10">
                        <Switch IsToggled="{Binding SubscribeNewsletter}"
                                AutomationId="NewsletterSwitch" />
                        <Label Text="Subscribe to Newsletter" 
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- CheckBox controls -->
                    <HorizontalStackLayout Spacing="10">
                        <CheckBox IsChecked="{Binding AcceptTerms}"
                                  AutomationId="TermsCheckBox" />
                        <Label Text="I accept the Terms of Service" 
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <CheckBox IsChecked="{Binding AcceptPrivacy}"
                                  AutomationId="PrivacyCheckBox" />
                        <Label Text="I accept the Privacy Policy" 
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Indeterminate checkbox simulation -->
                    <HorizontalStackLayout Spacing="10">
                        <CheckBox IsChecked="{Binding ShowIndeterminate}"
                                  AutomationId="IndeterminateCheckBox" />
                        <Label Text="Show optional features" 
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- RadioButton group -->
                    <Label Text="Subscription Tier" 
                           FontSize="14" 
                           FontAttributes="Bold"
                           AutomationId="SubscriptionLabel" />
                    <RadioButton Content="Basic" 
                                 GroupName="Subscription"
                                 IsChecked="{Binding SubscriptionTier, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Basic}"
                                 AutomationId="BasicRadio" />
                    <RadioButton Content="Professional" 
                                 GroupName="Subscription"
                                 IsChecked="{Binding SubscriptionTier, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Professional}"
                                 AutomationId="ProfessionalRadio" />
                    <RadioButton Content="Enterprise" 
                                 GroupName="Subscription"
                                 IsChecked="{Binding SubscriptionTier, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Enterprise}"
                                 AutomationId="EnterpriseRadio" />
                </VerticalStackLayout>
            </Border>

            <!-- Selection Section (IPicker, IDatePicker, ITimePicker) -->
            <Border AutomationId="SelectionSection" 
                    
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Selection Controls" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="SelectionLabel" />

                    <!-- Picker -->
                    <Label Text="Country" AutomationId="CountryLabel" />
                    <Picker Title="Select Country"
                            ItemsSource="{Binding Countries}"
                            SelectedIndex="{Binding SelectedCountryIndex}"
                            AutomationId="CountryPicker" />

                    <Label Text="Department" AutomationId="DepartmentLabel" />
                    <Picker Title="Select Department"
                            ItemsSource="{Binding Departments}"
                            SelectedIndex="{Binding SelectedDepartmentIndex}"
                            AutomationId="DepartmentPicker" />

                    <!-- DatePicker -->
                    <Label Text="Birth Date" AutomationId="BirthDateLabel" />
                    <DatePicker Date="{Binding BirthDate}"
                                MinimumDate="1900-01-01"
                                MaximumDate="2010-12-31"
                                AutomationId="BirthDatePicker" />

                    <!-- TimePicker -->
                    <Label Text="Preferred Contact Time" AutomationId="TimeLabel" />
                    <TimePicker Time="{Binding PreferredTime}"
                                AutomationId="PreferredTimePicker" />
                </VerticalStackLayout>
            </Border>

            <!-- Range Section (ISlider, IStepper) -->
            <Border AutomationId="RangeSection" 
                    
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Range Controls" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="RangeLabel" />

                    <!-- Slider -->
                    <Label Text="{Binding FontSizeDisplay, StringFormat='Font Size: {0}'}" 
                           AutomationId="FontSizeLabel" />
                    <Slider Minimum="8" 
                            Maximum="72" 
                            Value="{Binding FontSize}"
                            AutomationId="FontSizeSlider" />

                    <Label Text="{Binding VolumeDisplay, StringFormat='Volume: {0}'}" 
                           AutomationId="VolumeLabel" />
                    <Slider Minimum="0" 
                            Maximum="100" 
                            Value="{Binding Volume}"
                            AutomationId="VolumeSlider" />

                    <!-- Stepper -->
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Quantity:" VerticalOptions="Center" />
                        <Stepper Minimum="1" 
                                 Maximum="99" 
                                 Increment="1"
                                 Value="{Binding Quantity}"
                                 AutomationId="QuantityStepper" />
                        <Label Text="{Binding Quantity}" 
                               VerticalOptions="Center"
                               AutomationId="QuantityLabel" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Result Display -->
            <Label Text="{Binding ResultMessage}" 
                   AutomationId="ResultMessage"
                   TextColor="Green"
                   FontSize="14" />

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,*,*" 
                  ColumnSpacing="10">
                <Button Text="Submit" 
                        Grid.Column="0"
                        AutomationId="SubmitButton"
                        Command="{Binding SubmitCommand}"
                        BackgroundColor="Blue"
                        TextColor="White" />
                <Button Text="Save Draft" 
                        Grid.Column="1"
                        AutomationId="SaveDraftButton"
                        Command="{Binding SaveDraftCommand}" />
                <Button Text="Clear" 
                        Grid.Column="2"
                        AutomationId="ClearButton"
                        Command="{Binding ClearCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
