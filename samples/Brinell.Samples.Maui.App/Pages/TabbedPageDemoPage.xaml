<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="Brinell.Samples.Maui.App.Pages.TabbedPageDemoPage"
            AutomationId="TabbedPageDemo"
            Title="TabbedPage Demo">

    <!-- Tab 1: Home -->
    <ContentPage Title="Home" AutomationId="HomeTab">
        <VerticalStackLayout Padding="20" Spacing="20" VerticalOptions="Center">
            <Label AutomationId="HomeTitle" 
                   Text="Home Tab" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" />
            <Label AutomationId="HomeDescription" 
                   Text="Welcome to the TabbedPage demo. This demonstrates tab navigation with AutomationId support." 
                   HorizontalTextAlignment="Center" />
            <Button AutomationId="HomeButton" 
                    Text="Home Action" 
                    HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ContentPage>

    <!-- Tab 2: Settings -->
    <ContentPage Title="Settings" AutomationId="SettingsTab">
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label AutomationId="SettingsTitle" 
                   Text="Settings Tab" 
                   FontSize="28" 
                   FontAttributes="Bold" />
            
            <HorizontalStackLayout Spacing="10">
                <Switch AutomationId="DarkModeSwitch" IsToggled="false" />
                <Label AutomationId="DarkModeLabel" Text="Dark Mode" VerticalOptions="Center" />
            </HorizontalStackLayout>
            
            <HorizontalStackLayout Spacing="10">
                <Switch AutomationId="NotificationsSwitch" IsToggled="true" />
                <Label AutomationId="NotificationsLabel" Text="Enable Notifications" VerticalOptions="Center" />
            </HorizontalStackLayout>
            
            <Entry AutomationId="UsernameEntry" Placeholder="Username" />
            
            <Button AutomationId="SaveSettingsButton" Text="Save Settings" />
        </VerticalStackLayout>
    </ContentPage>

    <!-- Tab 3: About -->
    <ContentPage Title="About" AutomationId="AboutTab">
        <VerticalStackLayout Padding="20" Spacing="20" VerticalOptions="Center">
            <Label AutomationId="AboutTitle" 
                   Text="About Tab" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" />
            <Label AutomationId="VersionLabel" 
                   Text="Version 1.0.0" 
                   HorizontalOptions="Center" />
            <Label AutomationId="AboutDescription" 
                   Text="This TabbedPage demonstrates AutomationId support on Windows. Each tab can be accessed via AutomationId for UI testing." 
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ContentPage>

</TabbedPage>
