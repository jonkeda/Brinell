<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Brinell.Samples.Maui.App.ViewModels"
             x:Class="Brinell.Samples.Maui.App.Pages.DashboardPage"
             Title="Dashboard"
             AutomationId="DashboardPage">

    <ContentPage.BindingContext>
        <viewmodels:DashboardViewModel />
    </ContentPage.BindingContext>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Refresh" 
                     AutomationId="DashboardRefreshToolbar"
                     Command="{Binding RefreshCommand}" />
        <ToolbarItem Text="Settings" 
                     AutomationId="DashboardSettingsToolbar"
                     Command="{Binding SettingsCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView AutomationId="DashboardScrollView">
        <VerticalStackLayout Spacing="15" Padding="20">
            
            <!-- Page Header -->
            <Label Text="Dashboard" 
                   AutomationId="DashboardTitle"
                   FontSize="28" 
                   FontAttributes="Bold" />
            
            <Label Text="{Binding LastUpdated, StringFormat='Last updated: {0}'}"
                   AutomationId="DashboardLastUpdated"
                   TextColor="Gray" />

            <!-- KPI Cards (IBorder/ILabel demonstration) -->
            <Border AutomationId="KpiCard1" 
                   BackgroundColor="#E3F2FD" 
                    
                   Padding="15">
                <VerticalStackLayout>
                    <Label Text="Total Users" 
                           AutomationId="Kpi1Title"
                           FontSize="14" 
                           TextColor="Gray" />
                    <Label Text="{Binding Kpi1Value}" 
                           AutomationId="Kpi1Value"
                           FontSize="32" 
                           FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <Border AutomationId="KpiCard2" 
                   BackgroundColor="#E8F5E9" 
                    
                   Padding="15">
                <VerticalStackLayout>
                    <Label Text="Active Sessions" 
                           AutomationId="Kpi2Title"
                           FontSize="14" 
                           TextColor="Gray" />
                    <Label Text="{Binding Kpi2Value}" 
                           AutomationId="Kpi2Value"
                           FontSize="32" 
                           FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <Border AutomationId="KpiCard3" 
                   BackgroundColor="#FFF3E0" 
                    
                   Padding="15">
                <VerticalStackLayout>
                    <Label Text="Pending Tasks" 
                           AutomationId="Kpi3Title"
                           FontSize="14" 
                           TextColor="Gray" />
                    <Label Text="{Binding Kpi3Value}" 
                           AutomationId="Kpi3Value"
                           FontSize="32" 
                           FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <!-- Progress Section (IProgressBar, IActivityIndicator) -->
            <Label Text="Loading Progress" 
                   AutomationId="ProgressLabel"
                   FontSize="16" 
                   FontAttributes="Bold" />
            
            <ProgressBar Progress="{Binding LoadProgress}" 
                         AutomationId="DashboardProgressBar"
                         ProgressColor="Blue" />
            
            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                               AutomationId="DashboardActivityIndicator"
                               Color="Blue" />

            <!-- Tabs Section (simulated with buttons) -->
            <Label Text="Quick Actions" 
                   AutomationId="QuickActionsLabel"
                   FontSize="16" 
                   FontAttributes="Bold" />

            <HorizontalStackLayout Spacing="10" 
                                   AutomationId="TabButtonsContainer">
                <Button Text="Overview" 
                        AutomationId="TabOverview" />
                <Button Text="Analytics" 
                        AutomationId="TabAnalytics" />
                <Button Text="Reports" 
                        AutomationId="TabReports" />
            </HorizontalStackLayout>

            <!-- Status List (CollectionView for IItemsControl) -->
            <Label Text="Status Items" 
                   AutomationId="StatusListLabel"
                   FontSize="16" 
                   FontAttributes="Bold" />

            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}"
                         AutomationId="DashboardRefreshView">
                <CollectionView ItemsSource="{Binding StatusItems}" 
                                AutomationId="StatusItemsCollection"
                                SelectionMode="Single">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,5" Padding="10" 
                                   AutomationId="{Binding Id, StringFormat='StatusItem_{0}'}">
                                <HorizontalStackLayout>
                                    <Label Text="{Binding Title}" 
                                           VerticalOptions="Center"
                                           FontSize="14" />
                                    <Label Text="{Binding Status}" 
                                           TextColor="Gray"
                                           VerticalOptions="Center"
                                           Margin="10,0,0,0" />
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- Action Buttons (IButton, IClickable) -->
            <Grid ColumnDefinitions="*,*" 
                  ColumnSpacing="10" 
                  Margin="0,10,0,0">
                <Button Text="Refresh Data" 
                        Grid.Column="0"
                        AutomationId="RefreshButton"
                        Command="{Binding RefreshCommand}" />
                <Button Text="Export" 
                        Grid.Column="1"
                        AutomationId="ExportButton"
                        Command="{Binding ExportCommand}" />
            </Grid>

            <!-- Border demonstration -->
            <Border Stroke="LightGray" 
                    StrokeThickness="1" 
                    StrokeShape="RoundRectangle 10"
                    Padding="15"
                    AutomationId="DashboardBorder">
                <Label Text="This is a bordered content area for additional information." 
                       AutomationId="BorderedContent" />
            </Border>

            <!-- BoxView separator -->
            <BoxView HeightRequest="2" 
                     Color="LightGray"
                     AutomationId="DashboardDivider" />

            <!-- Dashboard icon -->
            <Label Text="📊" 
                   FontSize="64"
                   HorizontalOptions="Center"
                   AutomationId="DashboardImage" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
