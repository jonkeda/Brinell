<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Brinell.Samples.Maui.App.ViewModels"
             x:Class="Brinell.Samples.Maui.App.Pages.AdvancedPage"
             Title="Advanced"
             AutomationId="AdvancedPage">

    <ContentPage.BindingContext>
        <viewmodels:AdvancedViewModel />
    </ContentPage.BindingContext>

    <ScrollView AutomationId="AdvancedScrollView">
        <VerticalStackLayout Spacing="15" Padding="20">

            <!-- Page Header -->
            <Label Text="Advanced Controls" 
                   AutomationId="AdvancedTitle"
                   FontSize="28" 
                   FontAttributes="Bold" />

            <Label Text="Gesture recognition and advanced interactions"
                   TextColor="Gray"
                   AutomationId="AdvancedSubtitle" />

            <!-- Gesture Log -->
            <Frame AutomationId="GestureLogFrame" 
                   CornerRadius="10" 
                   Padding="10"
                   BackgroundColor="#F0F0F0">
                <VerticalStackLayout>
                    <Label Text="Gesture Log" 
                           FontAttributes="Bold"
                           AutomationId="GestureLogLabel" />
                    <Label Text="{Binding GestureLog}"
                           FontSize="10"
                           FontFamily="Consolas"
                           AutomationId="GestureLogContent"
                           HeightRequest="80" />
                </VerticalStackLayout>
            </Frame>

            <!-- Tap Gesture Section -->
            <Frame AutomationId="TapSection" 
                   CornerRadius="10" 
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Tap Gesture" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="TapSectionLabel" />

                    <Frame BackgroundColor="#E3F2FD" 
                           HeightRequest="100"
                           CornerRadius="10"
                           AutomationId="TapArea">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TapCommand}"
                                                  NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" 
                                             HorizontalOptions="Center">
                            <Label Text="Tap Here"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   AutomationId="TapAreaText" />
                            <Label Text="{Binding TapCountDisplay}"
                                   HorizontalOptions="Center"
                                   AutomationId="TapCountDisplay" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Double Tap Area -->
                    <Frame BackgroundColor="#E8F5E9" 
                           HeightRequest="80"
                           CornerRadius="10"
                           AutomationId="DoubleTapArea">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TapCommand}"
                                                  NumberOfTapsRequired="2" />
                        </Frame.GestureRecognizers>
                        <Label Text="Double Tap Area"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               AutomationId="DoubleTapText" />
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- Pan Gesture Section -->
            <Frame AutomationId="PanSection" 
                   CornerRadius="10" 
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Pan/Drag Gesture" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="PanSectionLabel" />

                    <Frame BackgroundColor="#FFF3E0" 
                           HeightRequest="120"
                           CornerRadius="10"
                           AutomationId="PanArea"
                           x:Name="PanFrame">
                        <Frame.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" 
                                             HorizontalOptions="Center">
                            <Label Text="Pan/Drag Here"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   AutomationId="PanAreaText" />
                            <Label Text="{Binding PanStatus}"
                                   HorizontalOptions="Center"
                                   AutomationId="PanStatus" />
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- Pinch Gesture Section -->
            <Frame AutomationId="PinchSection" 
                   CornerRadius="10" 
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Pinch/Zoom Gesture" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="PinchSectionLabel" />

                    <Frame BackgroundColor="#FCE4EC" 
                           HeightRequest="120"
                           CornerRadius="10"
                           AutomationId="PinchArea"
                           x:Name="PinchFrame">
                        <Frame.GestureRecognizers>
                            <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" 
                                             HorizontalOptions="Center">
                            <Label Text="Pinch/Zoom Here"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   AutomationId="PinchAreaText"
                                   Scale="{Binding PinchScale}" />
                            <Label Text="{Binding PinchScale, StringFormat='Scale: {0:F2}'}"
                                   HorizontalOptions="Center"
                                   AutomationId="PinchScaleDisplay" />
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- Swipe Section -->
            <Frame AutomationId="SwipeSection" 
                   CornerRadius="10" 
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Swipe Gestures" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="SwipeSectionLabel" />

                    <SwipeView AutomationId="SwipeViewDemo">
                        <SwipeView.LeftItems>
                            <SwipeItems>
                                <SwipeItem Text="Archive"
                                           BackgroundColor="Green"
                                           Command="{Binding SwipeRightCommand}"
                                           AutomationId="SwipeArchive" />
                            </SwipeItems>
                        </SwipeView.LeftItems>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete"
                                           BackgroundColor="Red"
                                           Command="{Binding SwipeLeftCommand}"
                                           AutomationId="SwipeDelete" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Frame BackgroundColor="#E1F5FE" 
                               HeightRequest="80"
                               CornerRadius="10"
                               AutomationId="SwipeContent">
                            <Label Text="← Swipe Left or Right →"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   AutomationId="SwipeText" />
                        </Frame>
                    </SwipeView>

                    <Label Text="{Binding SwipeResult}"
                           TextColor="Blue"
                           AutomationId="SwipeResult" />
                </VerticalStackLayout>
            </Frame>

            <!-- Container Layout Section -->
            <Frame AutomationId="ContainerSection" 
                   CornerRadius="10" 
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Container Layouts" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="ContainerSectionLabel" />

                    <!-- Grid Layout Demo -->
                    <Label Text="Grid Layout:" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*,*" 
                          RowDefinitions="50,50"
                          ColumnSpacing="5"
                          RowSpacing="5"
                          AutomationId="GridDemo">
                        <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="#FFCDD2" AutomationId="GridCell_0_0">
                            <Label Text="0,0" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Frame>
                        <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#F8BBD0" AutomationId="GridCell_0_1">
                            <Label Text="0,1" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Frame>
                        <Frame Grid.Row="0" Grid.Column="2" BackgroundColor="#E1BEE7" AutomationId="GridCell_0_2">
                            <Label Text="0,2" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Frame>
                        <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="#D1C4E9" AutomationId="GridCell_1_0">
                            <Label Text="1,0" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Frame>
                        <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="#C5CAE9" AutomationId="GridCell_1_1">
                            <Label Text="1,1" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Frame>
                        <Frame Grid.Row="1" Grid.Column="2" BackgroundColor="#BBDEFB" AutomationId="GridCell_1_2">
                            <Label Text="1,2" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Frame>
                    </Grid>

                    <!-- FlexLayout Demo -->
                    <Label Text="FlexLayout:" FontAttributes="Bold" />
                    <FlexLayout Wrap="Wrap" 
                                JustifyContent="SpaceEvenly"
                                AutomationId="FlexLayoutDemo">
                        <Frame WidthRequest="60" HeightRequest="40" BackgroundColor="#B2DFDB" Margin="2" AutomationId="FlexItem1">
                            <Label Text="1" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Frame>
                        <Frame WidthRequest="80" HeightRequest="40" BackgroundColor="#B2EBF2" Margin="2" AutomationId="FlexItem2">
                            <Label Text="2" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Frame>
                        <Frame WidthRequest="50" HeightRequest="40" BackgroundColor="#B3E5FC" Margin="2" AutomationId="FlexItem3">
                            <Label Text="3" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Frame>
                        <Frame WidthRequest="70" HeightRequest="40" BackgroundColor="#DCEDC8" Margin="2" AutomationId="FlexItem4">
                            <Label Text="4" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Frame>
                    </FlexLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Reset Button -->
            <Button Text="Reset All"
                    Command="{Binding ResetCommand}"
                    AutomationId="ResetButton" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
