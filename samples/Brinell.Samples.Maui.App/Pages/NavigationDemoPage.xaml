<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Brinell.Samples.Maui.App.ViewModels"
             x:Class="Brinell.Samples.Maui.App.Pages.NavigationDemoPage"
             Title="Navigation"
             AutomationId="NavigationDemoPage">

    <ContentPage.BindingContext>
        <viewmodels:NavigationDemoViewModel />
    </ContentPage.BindingContext>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" 
                     AutomationId="SaveToolbarItem"
                     Command="{Binding ToolbarSaveCommand}" />
        <ToolbarItem Text="Edit" 
                     AutomationId="EditToolbarItem"
                     Command="{Binding ToolbarEditCommand}" />
        <ToolbarItem Text="Delete" 
                     AutomationId="DeleteToolbarItem"
                     Command="{Binding ToolbarDeleteCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView AutomationId="NavigationScrollView">
        <VerticalStackLayout Spacing="15" Padding="20">

            <!-- Page Header -->
            <Label Text="Navigation and Layout" 
                   AutomationId="NavigationTitle"
                   FontSize="28" 
                   FontAttributes="Bold" />

            <!-- Result Display -->
            <Label Text="{Binding NavigationResult}" 
                   AutomationId="NavigationResult"
                   TextColor="Blue"
                   FontSize="14" />

            <!-- Navigation Buttons Section -->
            <Border AutomationId="NavigationButtonsSection" 
                    
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Page Navigation" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="PageNavLabel" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto">
                        <Button Text="Push Page" 
                                Grid.Row="0" Grid.Column="0"
                                Command="{Binding PushPageCommand}"
                                AutomationId="PushPageButton" />
                        <Button Text="Pop Page" 
                                Grid.Row="0" Grid.Column="1"
                                Command="{Binding PopPageCommand}"
                                AutomationId="PopPageButton" />
                        <Button Text="Modal Page" 
                                Grid.Row="1" Grid.Column="0"
                                Command="{Binding ModalPageCommand}"
                                AutomationId="ModalPageButton" />
                        <Button Text="Pop to Root" 
                                Grid.Row="1" Grid.Column="1"
                                Command="{Binding PopToRootCommand}"
                                AutomationId="PopToRootButton" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Expander Section (simulated with custom controls) -->
            <Border AutomationId="ExpanderSection" 
                    
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Expandable Sections" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="ExpanderSectionLabel" />

                    <HorizontalStackLayout Spacing="10" Margin="0,0,0,10">
                        <Button Text="Expand All" 
                                Command="{Binding ExpandAllCommand}"
                                AutomationId="ExpandAllButton" />
                        <Button Text="Collapse All" 
                                Command="{Binding CollapseAllCommand}"
                                AutomationId="CollapseAllButton" />
                    </HorizontalStackLayout>

                    <!-- Expander 1 -->
                    <Border  
                           Padding="10"
                           AutomationId="Expander1">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Section 1: Getting Started" 
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       AutomationId="Expander1Header" />
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding Expander1Expanded}"
                                        AutomationId="Expander1Toggle" />
                            </Grid>
                            <VerticalStackLayout IsVisible="{Binding Expander1Expanded}"
                                                 AutomationId="Expander1Content">
                                <CollectionView ItemsSource="{Binding ExpanderContent1}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Label Text="{Binding .}" Padding="10,5" />
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Expander 2 -->
                    <Border  
                           Padding="10"
                           AutomationId="Expander2">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Section 2: Configuration" 
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       AutomationId="Expander2Header" />
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding Expander2Expanded}"
                                        AutomationId="Expander2Toggle" />
                            </Grid>
                            <VerticalStackLayout IsVisible="{Binding Expander2Expanded}"
                                                 AutomationId="Expander2Content">
                                <CollectionView ItemsSource="{Binding ExpanderContent2}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Label Text="{Binding .}" Padding="10,5" />
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Expander 3 -->
                    <Border  
                           Padding="10"
                           AutomationId="Expander3">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Section 3: Advanced Features" 
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       AutomationId="Expander3Header" />
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding Expander3Expanded}"
                                        AutomationId="Expander3Toggle" />
                            </Grid>
                            <VerticalStackLayout IsVisible="{Binding Expander3Expanded}"
                                                 AutomationId="Expander3Content">
                                <CollectionView ItemsSource="{Binding ExpanderContent3}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Label Text="{Binding .}" Padding="10,5" />
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Tab Bar Section (simulated) -->
            <Border AutomationId="TabBarSection" 
                    
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Tab Navigation" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="TabNavLabel" />

                    <HorizontalStackLayout Spacing="5" 
                                           HorizontalOptions="Center"
                                           AutomationId="TabBar">
                        <Button Text="Home" 
                                AutomationId="TabHome"
                                BackgroundColor="Blue"
                                TextColor="White" />
                        <Button Text="Search" 
                                AutomationId="TabSearch" />
                        <Button Text="Profile" 
                                AutomationId="TabProfile" />
                        <Button Text="Settings" 
                                AutomationId="TabSettings" />
                    </HorizontalStackLayout>

                    <!-- Tab Content Area -->
                    <Border BackgroundColor="#F5F5F5" 
                           HeightRequest="100"
                           AutomationId="TabContentArea">
                        <Label Text="Tab content appears here"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               AutomationId="TabContent" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Menu/Flyout Section -->
            <Border AutomationId="FlyoutSection" 
                    
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Flyout Menu Items" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="FlyoutLabel" />

                    <Button Text="Open Flyout Menu"
                            Command="{Binding OpenFlyoutCommand}"
                            AutomationId="OpenFlyoutButton" />

                    <!-- Menu Items List -->
                    <VerticalStackLayout Spacing="5" AutomationId="MenuItemsList">
                        <Border Padding="10" AutomationId="MenuItem1">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="🏠" FontSize="20" />
                                <Label Text="Home" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Padding="10" AutomationId="MenuItem2">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="👤" FontSize="20" />
                                <Label Text="Profile" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Padding="10" AutomationId="MenuItem3">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="⚙️" FontSize="20" />
                                <Label Text="Settings" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Padding="10" AutomationId="MenuItem4">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="❓" FontSize="20" />
                                <Label Text="Help" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Links Section -->
            <Border AutomationId="LinksSection" 
                    
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Hyperlinks" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="LinksLabel" />

                    <Label AutomationId="Link1">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Visit our " />
                                <Span Text="Documentation" 
                                      TextColor="Blue" 
                                      TextDecorations="Underline" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label AutomationId="Link2">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Check " />
                                <Span Text="GitHub Repository" 
                                      TextColor="Blue" 
                                      TextDecorations="Underline" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label AutomationId="Link3">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Read " />
                                <Span Text="Release Notes" 
                                      TextColor="Blue" 
                                      TextDecorations="Underline" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
