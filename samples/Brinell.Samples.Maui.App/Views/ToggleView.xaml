<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="using:Brinell.Samples.Maui.App.ViewModels"
             x:Class="Brinell.Samples.Maui.App.Views2.TestViews.ToggleView"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1F1F1F}">

    <ContentView.BindingContext>
        <viewModels:ToggleViewModel />
    </ContentView.BindingContext>

    <ScrollView>
        <VerticalStackLayout 
            Padding="20" 
            Spacing="15"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1F1F1F}">

            <!-- Title -->
            <Label 
                Text="Toggle Module Test" 
                FontSize="24" 
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light=Black, Dark=White}" />

            <Label 
                Text="Test CheckBox, RadioButton, and Switch controls"
                FontSize="14"
                TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />

            <BoxView Color="{AppThemeBinding Light=LightGray, Dark=Gray}" HeightRequest="1" />

            <!-- CheckBox Section -->
            <Label Text="CheckBox" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
            <Label Text="Toggle the checkbox to verify state changes" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />

            <HorizontalStackLayout Spacing="10">
                <CheckBox 
                    IsChecked="{Binding IsCheckBoxChecked}"
                    AutomationId="TestCheckBox" />
                <Label 
                    Text="Enable Feature" 
                    FontSize="14"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label 
                Text="{Binding CheckBoxStatusMessage}" 
                FontSize="13"
                LineBreakMode="WordWrap"
                TextColor="{AppThemeBinding Light=DarkGreen, Dark=LightGreen}"
                Padding="10"
                BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2F2F2F}"
                AutomationId="CheckBoxStatusLabel" />

            <BoxView Color="{AppThemeBinding Light=LightGray, Dark=Gray}" HeightRequest="1" />

            <!-- RadioButton Section -->
            <Label Text="RadioButton (Mutually Exclusive)" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
            <Label Text="Select one option (only one can be selected)" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />

            <HorizontalStackLayout Spacing="10">
                <RadioButton 
                    Value="Option1"
                    GroupName="TestGroup"
                    IsChecked="{Binding IsOption1Selected}"
                    AutomationId="TestRadioButton1" />
                <Label 
                    Text="Option 1" 
                    FontSize="14"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <RadioButton 
                    Value="Option2"
                    GroupName="TestGroup"
                    IsChecked="{Binding IsOption2Selected}"
                    AutomationId="TestRadioButton2" />
                <Label 
                    Text="Option 2" 
                    FontSize="14"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <RadioButton 
                    Value="Option3"
                    GroupName="TestGroup"
                    IsChecked="{Binding IsOption3Selected}"
                    AutomationId="TestRadioButton3" />
                <Label 
                    Text="Option 3" 
                    FontSize="14"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label 
                Text="{Binding RadioButtonStatusMessage}" 
                FontSize="13"
                LineBreakMode="WordWrap"
                TextColor="{AppThemeBinding Light=DarkGreen, Dark=LightGreen}"
                Padding="10"
                BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2F2F2F}"
                AutomationId="RadioButtonStatusLabel" />

            <BoxView Color="{AppThemeBinding Light=LightGray, Dark=Gray}" HeightRequest="1" />

            <!-- Switch Section -->
            <Label Text="Switch" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
            <Label Text="Toggle the switch to verify state changes" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />

            <HorizontalStackLayout Spacing="10">
                <Switch 
                    IsToggled="{Binding IsSwitchToggled}"
                    AutomationId="TestSwitch" />
                <Label 
                    Text="Enable Notifications" 
                    FontSize="14"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label 
                Text="{Binding SwitchStatusMessage}" 
                FontSize="13"
                LineBreakMode="WordWrap"
                TextColor="{AppThemeBinding Light=DarkGreen, Dark=LightGreen}"
                Padding="10"
                BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2F2F2F}"
                AutomationId="SwitchStatusLabel" />

            <BoxView Color="{AppThemeBinding Light=LightGray, Dark=Gray}" HeightRequest="1" />

            <!-- Overall Status -->
            <Label 
                Text="{Binding StatusMessage}" 
                FontSize="14"
                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                AutomationId="StatusLabel" />

            <!-- Reset Button -->
            <Button 
                Text="Reset"
                Command="{Binding ResetCommand}"
                AutomationId="ResetButton"
                BackgroundColor="#A2845C" />

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
