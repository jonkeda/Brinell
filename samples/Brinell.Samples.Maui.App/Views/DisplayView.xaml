<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="using:Brinell.Samples.Maui.App.ViewModels"
             x:Class="Brinell.Samples.Maui.App.Views.DisplayView"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1F1F1F}">

    <ContentView.BindingContext>
        <viewModels:DisplayViewModel />
    </ContentView.BindingContext>

    <ScrollView AutomationId="DisplayTestPage">
        <VerticalStackLayout 
            Padding="20" 
            Spacing="15"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1F1F1F}">

            <!-- Title -->
            <Label 
                Text="Display Module Test" 
                FontSize="24" 
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light=Black, Dark=White}" />

            <Label 
                Text="Test Label, Image, ActivityIndicator, ProgressBar, and TitleBar controls" 
                FontSize="14"
                TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />

            <BoxView Color="{AppThemeBinding Light=LightGray, Dark=Gray}" HeightRequest="1" />

            <!-- Label Section -->
            <Label Text="Label Control" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
            <Label Text="Display formatted text with various properties" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />

            <Frame 
                BorderColor="#007AFF" 
                CornerRadius="8" 
                Padding="12" 
                HasShadow="True">
                <Label 
                    Text="{Binding LabelText}" 
                    FontSize="14"
                    LineBreakMode="WordWrap"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                    AutomationId="TestLabel" />
            </Frame>

            <BoxView Color="{AppThemeBinding Light=LightGray, Dark=Gray}" HeightRequest="1" />

            <!-- Image Section -->
            <Label Text="Image Control" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
            <Label Text="Display an image from resources" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />

            <Frame 
                BorderColor="#007AFF" 
                CornerRadius="8" 
                Padding="12" 
                HasShadow="True"
                HeightRequest="150">
                <Image 
                    Source="testimage.png" 
                    Aspect="AspectFit"
                    AutomationId="TestImage" />
            </Frame>

            <BoxView Color="{AppThemeBinding Light=LightGray, Dark=Gray}" HeightRequest="1" />

            <!-- ActivityIndicator Section -->
            <Label Text="ActivityIndicator" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
            <Label Text="Toggle spinner animation on/off" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />

            <Frame 
                BorderColor="#007AFF" 
                CornerRadius="8" 
                Padding="12" 
                HasShadow="True"
                HeightRequest="100">
                <ActivityIndicator 
                    IsRunning="{Binding IsActivityRunning}"
                    IsVisible="{Binding IsActivityRunning}"
                    Color="#007AFF"
                    AutomationId="TestActivityIndicator" />
            </Frame>

            <Button 
                Text="Toggle Activity Indicator" 
                Command="{Binding ToggleActivityCommand}"
                AutomationId="ToggleActivityButton"
                BackgroundColor="#007AFF" />

            <BoxView Color="{AppThemeBinding Light=LightGray, Dark=Gray}" HeightRequest="1" />

            <!-- ProgressBar Section -->
            <Label Text="ProgressBar" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
            <Label 
                Text="{Binding FormattedProgress, StringFormat='Current Progress: {0}'}" 
                FontSize="12" 
                TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />

            <ProgressBar 
                Progress="{Binding ProgressValue, Converter={StaticResource DoubleToProgressConverter}}"
                ProgressColor="#007AFF"
                BackgroundColor="#E0E0E0"
                HeightRequest="10"
                AutomationId="TestProgressBar" />

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button 
                    Text="Decrease" 
                    Command="{Binding DecreaseProgressCommand}"
                    AutomationId="DecreaseProgressButton"
                    BackgroundColor="#FF9500"
                    WidthRequest="120" />

                <Button 
                    Text="Increase" 
                    Command="{Binding IncreaseProgressCommand}"
                    AutomationId="IncreaseProgressButton"
                    BackgroundColor="#34C759"
                    WidthRequest="120" />
            </HorizontalStackLayout>

            <BoxView Color="{AppThemeBinding Light=LightGray, Dark=Gray}" HeightRequest="1" />

            <!-- Status -->
            <Label 
                Text="{Binding StatusMessage}" 
                FontSize="14"
                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                AutomationId="StatusLabel" />

            <!-- Reset Button -->
            <Button 
                Text="Reset" 
                Command="{Binding ResetCommand}"
                AutomationId="ResetButton"
                BackgroundColor="#007AFF" />

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
