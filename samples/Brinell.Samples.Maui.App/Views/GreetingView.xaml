<?xml version="1.0" encoding="utf-8" ?>
<!--
    The greeting demo the Markdown UAT sample suite drives: enter a name, press Greet, read
    the result. Small on purpose - it is the page a UAT scenario is written against in the
    docs, so every control on it is one a scenario names.
-->
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="using:Brinell.Samples.Maui.App.ViewModels"
    x:Class="Brinell.Samples.Maui.App.Views2.TestViews.GreetingView"
    BackgroundColor="{AppThemeBinding Light=White, Dark=#1F1F1F}">

    <ContentView.BindingContext>
        <viewModels:GreetingViewModel />
    </ContentView.BindingContext>

    <ScrollView AutomationId="GreetingScrollView">
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="Greeting"
                   FontSize="20"
                   FontAttributes="Bold" />

            <Label Text="Name" />
            <Entry AutomationId="NameEntry"
                   Placeholder="Enter your name"
                   MaxLength="50"
                   Text="{Binding Name}" />

            <Button AutomationId="GreetButton"
                    Text="Greet"
                    Command="{Binding GreetCommand}" />

            <Label AutomationId="GreetingLabel"
                   Text="{Binding Greeting}"
                   FontSize="16" />

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
