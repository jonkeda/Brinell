<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Brinell.Samples.Maui.App.Views.SamplePopup"
               AutomationId="SamplePopup"
               CanBeDismissedByTappingOutsideOfPopup="True">

    <Border Stroke="#512BD4"
            StrokeThickness="2"
            StrokeShape="RoundRectangle 15"
            BackgroundColor="White"
            Padding="20"
            WidthRequest="300"
            HeightRequest="200">
        <VerticalStackLayout Spacing="15">
            <Label Text="Sample Popup" 
                   FontSize="20" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   AutomationId="PopupTitle" />
            
            <Label Text="This is a CommunityToolkit.Maui popup dialog."
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   AutomationId="PopupMessage" />
            
            <HorizontalStackLayout Spacing="10" 
                                   HorizontalOptions="Center"
                                   Margin="0,20,0,0">
                <Button Text="OK" 
                        Clicked="OnOkClicked"
                        WidthRequest="100"
                        AutomationId="PopupOkButton" />
                <Button Text="Cancel" 
                        Clicked="OnCancelClicked"
                        WidthRequest="100"
                        BackgroundColor="Gray"
                        AutomationId="PopupCancelButton" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
