<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Brinell.Samples.Maui.App.ViewModels"
             x:Class="Brinell.Samples.Maui.App.Views.DataGridView">

    <ContentView.BindingContext>
        <viewmodels:DataGridViewModel />
    </ContentView.BindingContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="15">

        <!-- Header -->
        <Label Text="Data Management" 
           Grid.Row="0"
           AutomationId="DataGridTitle"
           FontSize="28" 
           FontAttributes="Bold" />

        <!-- Search and Filter -->
        <Border Grid.Row="1" 
           Padding="10" 
           Margin="0,10"
           AutomationId="SearchBorder">
            <HorizontalStackLayout Spacing="10">
                <SearchBar Placeholder="Filter items..."
                       Text="{Binding SearchText}"
                       WidthRequest="250"
                       AutomationId="DataSearchBar" />
                <Button Text="Clear" 
                    Command="{Binding ClearFilterCommand}"
                    AutomationId="ClearFilterButton" />
                <Label Text="{Binding SelectedCount, StringFormat='Selected: {0}'}"
                   VerticalOptions="Center"
                   AutomationId="SelectedCountLabel" />
            </HorizontalStackLayout>
        </Border>

        <!-- Main Content Area with RefreshView -->
        <RefreshView Grid.Row="2" 
                 IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshCommand}"
                 AutomationId="DataRefreshView">
            <ScrollView AutomationId="DataScrollView">
                <VerticalStackLayout Spacing="15">

                    <!-- Carousel Section (ICarouselView) -->
                    <Label Text="Featured Items" 
                       FontSize="18" 
                       FontAttributes="Bold"
                       AutomationId="FeaturedLabel" />

                    <CarouselView ItemsSource="{Binding CarouselItems}"
                              HeightRequest="150"
                              AutomationId="FeaturedCarousel"
                              PeekAreaInsets="20">
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Border  
                                   Margin="5"
                                   Padding="15"
                                   BackgroundColor="#F0F0F0"
                                   AutomationId="{Binding Id, StringFormat='CarouselItem_{0}'}">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding Title}" 
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center" />
                                        <Label Text="{Binding Subtitle}" 
                                           TextColor="Gray"
                                           HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <!-- IndicatorView for Carousel -->
                    <IndicatorView x:Name="CarouselIndicator"
                               AutomationId="CarouselIndicator"
                               IndicatorColor="LightGray"
                               SelectedIndicatorColor="Blue"
                               HorizontalOptions="Center" />

                    <!-- Main CollectionView (IItemsControl, IListView) -->
                    <Label Text="Data Items" 
                       FontSize="18" 
                       FontAttributes="Bold"
                       AutomationId="DataItemsLabel" />

                    <CollectionView ItemsSource="{Binding FilteredItems}"
                                SelectedItem="{Binding SelectedItem}"
                                SelectionMode="Single"
                                AutomationId="DataCollectionView"
                                HeightRequest="300">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <SwipeView AutomationId="{Binding Id, StringFormat='SwipeItem_{0}'}">
                                    <SwipeView.LeftItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Star"
                                                   BackgroundColor="Gold"
                                                   AutomationId="{Binding Id, StringFormat='StarSwipe_{0}'}" />
                                        </SwipeItems>
                                    </SwipeView.LeftItems>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Delete"
                                                   BackgroundColor="Red"
                                                   AutomationId="{Binding Id, StringFormat='DeleteSwipe_{0}'}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>
                                    <Border Margin="0,2" 
                                       Padding="10" 
                                       
                                       AutomationId="{Binding Id, StringFormat='DataItem_{0}'}">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <VerticalStackLayout Grid.Column="0">
                                                <Label Text="{Binding Title}" 
                                                   FontAttributes="Bold"
                                                   AutomationId="{Binding Id, StringFormat='ItemTitle_{0}'}" />
                                                <Label Text="{Binding Description}" 
                                                   TextColor="Gray"
                                                   FontSize="12"
                                                   AutomationId="{Binding Id, StringFormat='ItemDesc_{0}'}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" 
                                               Text="{Binding Status}"
                                               VerticalOptions="Center"
                                               AutomationId="{Binding Id, StringFormat='ItemStatus_{0}'}" />
                                            <Label Grid.Column="2" 
                                               Text="⭐"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding IsStarred}"
                                               AutomationId="{Binding Id, StringFormat='ItemStar_{0}'}" />
                                        </Grid>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Grouped CollectionView -->
                    <Label Text="Grouped Items" 
                       FontSize="18" 
                       FontAttributes="Bold"
                       AutomationId="GroupedItemsLabel" />

                    <CollectionView ItemsSource="{Binding GroupedItems}"
                                IsGrouped="True"
                                AutomationId="GroupedCollectionView"
                                HeightRequest="200">
                        <CollectionView.GroupHeaderTemplate>
                            <DataTemplate>
                                <Label Text="{Binding Name}"
                                   FontAttributes="Bold"
                                   BackgroundColor="#E0E0E0"
                                   Padding="10,5"
                                   AutomationId="{Binding ShortName, StringFormat='GroupHeader_{0}'}" />
                            </DataTemplate>
                        </CollectionView.GroupHeaderTemplate>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding Title}"
                                   Padding="20,5"
                                   AutomationId="{Binding Id, StringFormat='GroupItem_{0}'}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Bottom Action Bar -->
        <HorizontalStackLayout Grid.Row="3" 
                           Spacing="10" 
                           Margin="0,10,0,0"
                           AutomationId="ActionBar">
            <Button Text="Refresh" 
                Command="{Binding RefreshCommand}"
                AutomationId="RefreshDataButton" />
            <Button Text="Select All" 
                Command="{Binding SelectAllCommand}"
                AutomationId="SelectAllButton" />
            <Button Text="Unselect All" 
                Command="{Binding UnselectAllCommand}"
                AutomationId="UnselectAllButton" />
        </HorizontalStackLayout>

    </Grid>

</ContentView>
