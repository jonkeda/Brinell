<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="using:Brinell.Samples.Maui.App.ViewModels"
             x:Class="Brinell.Samples.Maui.App.Views2.TestViews.DateTimeView"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1F1F1F}">

    <ContentView.BindingContext>
        <viewModels:DateTimeViewModel />
    </ContentView.BindingContext>

    <ScrollView>
        <VerticalStackLayout 
            Padding="20" 
            Spacing="15"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1F1F1F}">

            <!-- Title -->
            <Label 
                Text="DateTime Module Test" 
                FontSize="24" 
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light=Black, Dark=White}" />

            <Label 
                Text="Test DatePicker and TimePicker controls" 
                FontSize="14"
                TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />

            <BoxView Color="{AppThemeBinding Light=LightGray, Dark=Gray}" HeightRequest="1" />

            <!-- Date Picker Section -->
            <Label Text="DatePicker" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
            <Label Text="Select a date (min: today, max: 30 days from now)" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />

            <DatePicker 
                Date="{Binding SelectedDate}"
                MinimumDate="{Binding MinimumDate}"
                MaximumDate="{Binding MaximumDate}"
                AutomationId="TestDatePicker" />

            <Label 
                Text="{Binding FormattedDate, StringFormat='Selected Date: {0}'}" 
                FontSize="14"
                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                AutomationId="DateStatusLabel" />

            <BoxView Color="{AppThemeBinding Light=LightGray, Dark=Gray}" HeightRequest="1" />

            <!-- Time Picker Section -->
            <Label Text="TimePicker" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
            <Label Text="Select a time" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />

            <TimePicker 
                Time="{Binding SelectedTime}"
                AutomationId="TestTimePicker" />

            <Label 
                Text="{Binding FormattedTime, StringFormat='Selected Time: {0}'}" 
                FontSize="14"
                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                AutomationId="TimeStatusLabel" />

            <BoxView Color="{AppThemeBinding Light=LightGray, Dark=Gray}" HeightRequest="1" />

            <!-- Status -->
            <Label 
                Text="{Binding StatusMessage}" 
                FontSize="14"
                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                AutomationId="StatusLabel" />

            <!-- Reset Button -->
            <Button 
                Text="Reset" 
                Command="{Binding ResetCommand}"
                AutomationId="ResetButton"
                BackgroundColor="#007AFF" />

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
