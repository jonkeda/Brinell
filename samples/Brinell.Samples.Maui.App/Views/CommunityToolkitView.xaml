<?xml version="1.0" encoding="utf-8" ?>
<!--
    CommunityToolkit.Maui views: Expander, AvatarView, RatingView, DrawingView, StateContainer
    and DockLayout.

    Each control has an AutomationId and a status label echoing the state a test asserts.
    Verbs are declared only where the probe (.my/communitytoolkit/probe.md) found no UI
    Automation route and the AD-008 checks passed: Expander, RatingView and DrawingView. They are
    answered by ToolkitVerbSink, because AppSupport does not know the toolkit's types. AvatarView,
    StateContainer and DockLayout are read from the tree and declare nothing.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:uia="clr-namespace:Brinell.Maui.AppSupport.Uia;assembly=Brinell.Maui.AppSupport"
             xmlns:automation="clr-namespace:Brinell.Samples.Maui.App.Automation"
             x:Class="Brinell.Samples.Maui.App.Views2.TestViews.CommunityToolkitView"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1F1F1F}">

    <ScrollView AutomationId="CommunityToolkitRootScroll">
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label AutomationId="PageTitle"
                   Text="Community Toolkit Views"
                   FontSize="24"
                   FontAttributes="Bold" />

            <!-- Expander -->
            <Label Text="Expander" FontSize="16" FontAttributes="Bold" />
            <toolkit:Expander AutomationId="TestExpander"
                              uia:GestureAutomation.Verbs="Tap,GetState"
                              uia:GestureAutomation.Sink="{x:Static automation:ToolkitVerbSink.Instance}"
                              ExpandedChanged="OnExpandedChanged">
                <toolkit:Expander.Header>
                    <Label AutomationId="TestExpanderHeader"
                           Text="Show details"
                           FontAttributes="Bold" />
                </toolkit:Expander.Header>
                <Label AutomationId="TestExpanderContent"
                       Text="Expanded content" />
            </toolkit:Expander>
            <Label x:Name="ExpanderStatus"
                   AutomationId="ExpanderStatusLabel"
                   Text="collapsed" />

            <!-- AvatarView -->
            <Label Text="AvatarView" FontSize="16" FontAttributes="Bold" />
            <toolkit:AvatarView AutomationId="TestAvatarView"
                                Text="BR"
                                WidthRequest="48"
                                HeightRequest="48"
                                CornerRadius="24"
                                HorizontalOptions="Start" />

            <!-- RatingView -->
            <Label Text="RatingView" FontSize="16" FontAttributes="Bold" />
            <toolkit:RatingView AutomationId="TestRatingView"
                                uia:GestureAutomation.Verbs="SelectIndex,GetState"
                                uia:GestureAutomation.Sink="{x:Static automation:ToolkitVerbSink.Instance}"
                                MaximumRating="5"
                                Rating="2"
                                RatingChanged="OnRatingChanged" />
            <Label x:Name="RatingStatus"
                   AutomationId="RatingStatusLabel"
                   Text="rating: 2" />

            <!-- DrawingView -->
            <Label Text="DrawingView" FontSize="16" FontAttributes="Bold" />
            <toolkit:DrawingView x:Name="Drawing"
                                 AutomationId="TestDrawingView"
                                 uia:GestureAutomation.Verbs="Pan,GetState"
                                 uia:GestureAutomation.Sink="{x:Static automation:ToolkitVerbSink.Instance}"
                                 IsMultiLineModeEnabled="True"
                                 LineColor="Black"
                                 LineWidth="4"
                                 HeightRequest="120"
                                 BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2F2F2F}"
                                 DrawingLineCompleted="OnDrawingLineCompleted" />
            <HorizontalStackLayout Spacing="10">
                <Label x:Name="DrawingStatus"
                       AutomationId="DrawingStatusLabel"
                       Text="lines: 0"
                       VerticalOptions="Center" />
                <Button AutomationId="ClearDrawingButton"
                        Text="Clear"
                        Clicked="OnClearDrawing" />
            </HorizontalStackLayout>

            <!-- StateContainer -->
            <Label Text="StateContainer" FontSize="16" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="10">
                <Button AutomationId="StateLoadingButton" Text="Loading" Clicked="OnStateLoading" />
                <Button AutomationId="StateErrorButton" Text="Error" Clicked="OnStateError" />
                <Button AutomationId="StateContentButton" Text="Content" Clicked="OnStateContent" />
            </HorizontalStackLayout>
            <VerticalStackLayout x:Name="StateHost"
                                 AutomationId="TestStateContainer"
                                 MinimumHeightRequest="40">
                <toolkit:StateContainer.StateViews>
                    <Label toolkit:StateView.StateKey="Loading"
                           AutomationId="StateLoadingView"
                           Text="Loading..." />
                    <Label toolkit:StateView.StateKey="Error"
                           AutomationId="StateErrorView"
                           Text="Something went wrong" />
                </toolkit:StateContainer.StateViews>
                <Label AutomationId="StateContentView" Text="Loaded content" />
            </VerticalStackLayout>
            <Label x:Name="StateStatus"
                   AutomationId="StateStatusLabel"
                   Text="state: content" />

            <!-- DockLayout: a plain layout, so it declares nothing; tests use it as a scope. -->
            <Label Text="DockLayout" FontSize="16" FontAttributes="Bold" />
            <toolkit:DockLayout AutomationId="TestDockLayout"
                                HeightRequest="140"
                                ShouldExpandLastChild="True">
                <Label toolkit:DockLayout.DockPosition="Top"
                       AutomationId="DockHeaderLabel"
                       Text="Dock header" />
                <Label toolkit:DockLayout.DockPosition="Bottom"
                       x:Name="DockStatus"
                       AutomationId="DockStatusLabel"
                       Text="dock: idle" />
                <Button toolkit:DockLayout.DockPosition="Left"
                        AutomationId="DockActionButton"
                        Text="Press"
                        Clicked="OnDockAction" />
                <Label AutomationId="DockCenterLabel"
                       Text="Dock centre"
                       VerticalOptions="Center" />
            </toolkit:DockLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
