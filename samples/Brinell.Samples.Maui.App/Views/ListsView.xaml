<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:Brinell.Samples.Maui.App.ViewModels"
             x:Class="Brinell.Samples.Maui.App.Views.ListsView"
             AutomationId="ListsContent">

    <ContentView.BindingContext>
        <viewmodels:ListsViewModel />
    </ContentView.BindingContext>

    <ScrollView AutomationId="ListsScrollView">
        <VerticalStackLayout Spacing="15" Padding="20">

            <!-- Page Header -->
            <Label Text="Lists Demo" 
                   AutomationId="ListsTitle"
                   FontSize="28" 
                   FontAttributes="Bold" />

            <!-- ListView Section -->
            <Frame AutomationId="ListViewSection" 
                   CornerRadius="10" 
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="ListView with Pull-to-Refresh" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="ListViewLabel" />

                    <Label Text="Pull down to refresh and add items"
                           TextColor="Gray"
                           FontSize="12" />

                    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                                 Command="{Binding RefreshCommand}"
                                 AutomationId="ListRefreshView">
                        <ListView ItemsSource="{Binding Items}"
                                  SelectedItem="{Binding SelectedItem}"
                                  HasUnevenRows="True"
                                  HeightRequest="250"
                                  AutomationId="DemoListView">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell AutomationId="{Binding AutomationId}">
                                        <Grid Padding="10" ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout>
                                                <Label Text="{Binding Name}" 
                                                       FontAttributes="Bold"
                                                       AutomationId="ItemName" />
                                                <Label Text="{Binding Description}" 
                                                       TextColor="Gray"
                                                       FontSize="12"
                                                       AutomationId="ItemDescription" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" 
                                                    Text="X"
                                                    WidthRequest="40"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ListsViewModel}}, Path=DeleteItemCommand}"
                                                    CommandParameter="{Binding}"
                                                    AutomationId="DeleteItemButton" />
                                        </Grid>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </RefreshView>

                    <Label Text="{Binding SelectedItem.Name, StringFormat='Selected: {0}'}"
                           AutomationId="SelectedItemLabel" />
                </VerticalStackLayout>
            </Frame>

            <!-- TreeView Section using Expanders -->
            <Frame AutomationId="TreeViewSection" 
                   CornerRadius="10" 
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="TreeView-like Hierarchy" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           AutomationId="TreeViewLabel" />

                    <Label Text="Using nested Expanders for folder/file structure"
                           TextColor="Gray"
                           FontSize="12" />

                    <!-- Tree Nodes using Expanders -->
                    <VerticalStackLayout AutomationId="TreeView" BindableLayout.ItemsSource="{Binding TreeNodes}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <toolkit:Expander IsExpanded="{Binding IsExpanded}" 
                                                  AutomationId="{Binding AutomationId}">
                                    <toolkit:Expander.Header>
                                        <HorizontalStackLayout Padding="5" Spacing="5">
                                            <Label Text="{Binding HasChildren, Converter={StaticResource BoolToFolderIconConverter}}" 
                                                   FontSize="16" />
                                            <Label Text="{Binding Name}" 
                                                   VerticalOptions="Center"
                                                   AutomationId="NodeName" />
                                        </HorizontalStackLayout>
                                    </toolkit:Expander.Header>
                                    <toolkit:Expander.Content>
                                        <VerticalStackLayout Margin="20,0,0,0" 
                                                             BindableLayout.ItemsSource="{Binding Children}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <toolkit:Expander IsExpanded="{Binding IsExpanded}"
                                                                      AutomationId="{Binding AutomationId}">
                                                        <toolkit:Expander.Header>
                                                            <HorizontalStackLayout Padding="5" Spacing="5">
                                                                <Label Text="{Binding HasChildren, Converter={StaticResource BoolToFolderIconConverter}}" 
                                                                       FontSize="16" />
                                                                <Label Text="{Binding Name}" 
                                                                       VerticalOptions="Center"
                                                                       AutomationId="NodeName" />
                                                            </HorizontalStackLayout>
                                                        </toolkit:Expander.Header>
                                                        <toolkit:Expander.Content>
                                                            <VerticalStackLayout Margin="20,0,0,0" 
                                                                                 BindableLayout.ItemsSource="{Binding Children}">
                                                                <BindableLayout.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <HorizontalStackLayout Padding="5" Spacing="5"
                                                                                               AutomationId="{Binding AutomationId}">
                                                                            <Label Text="📄" FontSize="16" />
                                                                            <Label Text="{Binding Name}" 
                                                                                   VerticalOptions="Center"
                                                                                   AutomationId="NodeName" />
                                                                        </HorizontalStackLayout>
                                                                    </DataTemplate>
                                                                </BindableLayout.ItemTemplate>
                                                            </VerticalStackLayout>
                                                        </toolkit:Expander.Content>
                                                    </toolkit:Expander>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </toolkit:Expander.Content>
                                </toolkit:Expander>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
