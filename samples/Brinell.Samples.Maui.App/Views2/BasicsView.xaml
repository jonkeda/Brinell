<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Brinell.Samples.Maui.App.ViewModels"
             xmlns:viewModels2="using:Brinell.Samples.Maui.App.ViewModels2"
             x:Class="Brinell.Samples.Maui.App.Views2.BasicsView"
             AutomationId="BasicsContent">

    <ContentView.BindingContext>
        <viewModels2:BasicsViewModel />
    </ContentView.BindingContext>

    <ScrollView AutomationId="BasicsScrollView">
        <VerticalStackLayout Padding="30,0" Spacing="25">

            <Label AutomationId="TitleLabel" Text="Brinell MAUI Sample"
                   Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1"
                   HorizontalOptions="Center" />

            <Label AutomationId="SubtitleLabel" Text="UI Test Borderwork Demo"
                   Style="{StaticResource SubHeadline}"
                   SemanticProperties.HeadingLevel="Level2"
                   HorizontalOptions="Center" />

            <!-- Counter Section -->
            <Border AutomationId="CounterBorder" Padding="20" >
                <VerticalStackLayout Spacing="10">
                    <Label AutomationId="CounterLabel"
                           Text="{Binding CounterText}" FontSize="18" HorizontalOptions="Center" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <Button AutomationId="DecrementButton" Text="-" WidthRequest="60" Command="{Binding DecrementCommand}" />
                        <Button AutomationId="IncrementButton" Text="+" WidthRequest="60" Command="{Binding IncrementCommand}" />
                    </HorizontalStackLayout>
                    <Button AutomationId="ResetButton" Text="Reset" Command="{Binding ResetCommand}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Text Input Section -->
            <Border AutomationId="TextInputBorder" Padding="20" >
                <VerticalStackLayout Spacing="10">
                    <Label Text="Text Input" FontSize="16" FontAttributes="Bold" />
                    <Entry AutomationId="NameEntry" Placeholder="Enter your name" MaxLength="50" Text="{Binding Name}" />
                    <Entry AutomationId="EmailEntry" Placeholder="Enter your email" Keyboard="Email" Text="{Binding Email}" />
                    <Editor AutomationId="MessageEditor" Placeholder="Enter a message..." HeightRequest="100" AutoSize="TextChanges" Text="{Binding Message}" />
                    <Label AutomationId="GreetingLabel" Text="{Binding Greeting}" FontSize="14" TextColor="{StaticResource Primary}" />
                    <Button AutomationId="GreetButton" Text="Greet" Command="{Binding GreetCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Toggle Controls Section -->
            <Border AutomationId="ToggleBorder" Padding="20" >
                <VerticalStackLayout Spacing="10">
                    <Label Text="Toggle Controls" FontSize="16" FontAttributes="Bold" />
                    <HorizontalStackLayout Spacing="10">
                        <Switch AutomationId="NotificationSwitch" IsToggled="{Binding NotificationsEnabled}" />
                        <Label AutomationId="NotificationLabel" Text="{Binding NotificationLabelText}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="10">
                        <CheckBox AutomationId="AgreeCheckBox" IsChecked="{Binding AgreeToTerms}" />
                        <Label Text="I agree to terms" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Slider Section -->
            <Border AutomationId="SliderBorder" Padding="20" >
                <VerticalStackLayout Spacing="10">
                    <Label Text="Volume Control" FontSize="16" FontAttributes="Bold" />
                    <Slider AutomationId="VolumeSlider" Minimum="0" Maximum="100" Value="{Binding Volume}" />
                    <Label AutomationId="VolumeLabel" Text="{Binding VolumeText}" HorizontalOptions="Center" />
                    <ProgressBar AutomationId="VolumeProgress" Progress="{Binding VolumeProgress}" />
                </VerticalStackLayout>
            </Border>

            <!-- Picker Section -->
            <Border AutomationId="PickerBorder" Padding="20" >
                <VerticalStackLayout Spacing="10">
                    <Label Text="Selection Controls" FontSize="16" FontAttributes="Bold" />
                    <Picker AutomationId="ColorPicker" Title="Select a color" 
                            ItemsSource="{Binding Colors}"
                            SelectedItem="{Binding SelectedColor}" />
                    <Label AutomationId="SelectedColorLabel" Text="{Binding SelectedColorText}" HorizontalOptions="Center" />
                    <DatePicker AutomationId="BirthDatePicker" MinimumDate="1900-01-01" MaximumDate="2025-12-31" Date="{Binding BirthDate}" />
                    <TimePicker AutomationId="ReminderTimePicker" Time="{Binding ReminderTime}" />
                </VerticalStackLayout>
            </Border>

            <!-- Activity Indicator -->
            <Border AutomationId="ActivityBorder" Padding="20" >
                <VerticalStackLayout Spacing="10">
                    <Label Text="Activity Indicator" FontSize="16" FontAttributes="Bold" />
                    <ActivityIndicator AutomationId="LoadingIndicator" IsRunning="{Binding IsLoading}" Color="{StaticResource Primary}" />
                    <Button AutomationId="ToggleLoadingButton" Text="Toggle Loading" Command="{Binding ToggleLoadingCommand}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
