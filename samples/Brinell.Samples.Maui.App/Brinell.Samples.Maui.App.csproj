<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Brinell.Samples.Maui.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- Disable TreatWarningsAsErrors inherited from Directory.Build.props -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    
    <!-- Windows Package Type -->
    <WindowsPackageType>None</WindowsPackageType>
    
    <!-- Include Windows App SDK in output (no separate runtime install needed) -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Display name -->
    <ApplicationTitle>Brinell MAUI Sample</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.brinell.samples.maui</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Windows -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <!-- Mobile -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>

    <!--
      Embed the managed assemblies in the APK even in Debug.

      Android Debug builds default to Fast Deployment, which leaves the assemblies out of the
      APK for `dotnet run` to push separately. A UI test installs only the APK, so the app
      aborts at startup with "No assemblies found ... Assuming this is part of Fast
      Deployment" - a crash before any test code runs, reported by Appium only as "app never
      started".
    -->
    <EmbedAssembliesIntoApk Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="CommunityToolkit.Maui" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Brinell.Samples.Shared\Brinell.Samples.Shared.csproj" />
    <!--
      Demonstrates the "reference the project" route for the Brinell automation
      handlers. The other supported route is copying AppSupport's sources into the
      app under test - see BrinellAutomationSupport for why both exist.
    -->
    <ProjectReference Include="..\Brinell.Maui.AppSupport\Brinell.Maui.AppSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

    <!-- Raw Assets -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Models\**" />
    <Compile Remove="Platforms\Windows\Controls\**" />
    <Compile Remove="TestViews\**" />
    <EmbeddedResource Remove="Models\**" />
    <EmbeddedResource Remove="Platforms\Windows\Controls\**" />
    <EmbeddedResource Remove="TestViews\**" />
    <MauiCss Remove="Models\**" />
    <MauiCss Remove="Platforms\Windows\Controls\**" />
    <MauiCss Remove="TestViews\**" />
    <MauiXaml Remove="Models\**" />
    <MauiXaml Remove="Platforms\Windows\Controls\**" />
    <MauiXaml Remove="TestViews\**" />
    <None Remove="Models\**" />
    <None Remove="Platforms\Windows\Controls\**" />
    <None Remove="TestViews\**" />
    <Page Remove="Platforms\Windows\Controls\**" />
  </ItemGroup>

