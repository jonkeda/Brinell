<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Brinell.Samples.Maui.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- Disable TreatWarningsAsErrors inherited from Directory.Build.props -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    
    <!-- Windows Package Type -->
    <WindowsPackageType>None</WindowsPackageType>
    
    <!-- Include Windows App SDK in output (no separate runtime install needed) -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Display name -->
    <ApplicationTitle>Brinell MAUI Sample</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.brinell.samples.maui</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Windows -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="CommunityToolkit.Maui" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\srcnew\Brinell.Maui.Extensions\Brinell.Maui.Extensions.csproj" />
    <ProjectReference Include="..\Brinell.Samples.Shared\Brinell.Samples.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

    <!-- Raw Assets -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Platforms\Windows\Controls\**" />
    <EmbeddedResource Remove="Platforms\Windows\Controls\**" />
    <MauiCss Remove="Platforms\Windows\Controls\**" />
    <MauiXaml Remove="Platforms\Windows\Controls\**" />
    <None Remove="Platforms\Windows\Controls\**" />
    <Page Remove="Platforms\Windows\Controls\**" />
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="Views2\DataGridView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views2\TestViews\TextView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\ButtonsView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\ButtonsView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\DateTimeView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\TextView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

  <ItemGroup>
    <PRIResource Remove="Platforms\Windows\Controls\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".my\maui-control-coverage-analysis.md" />
    <None Include=".my\test-pages-design.md" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <Folder Include="TestViews\" />
    <Folder Include="Views2\TestViews\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\ButtonsView.xaml.cs">
      <DependentUpon>ButtonsView.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
