@page "/recycling-list"

<PageTitle>Recycling list - Bruinell Blazor Sample</PageTitle>

@* A virtualized list whose DOM nodes are reused for other items (.my/html/sample-app.md item 4).
   Rows carry data-item-key and no @key, so Recycle leaves the same nodes showing different items:
   a row object kept by position would now act on another item. *@
<h1 data-testid="recycling-title">Recycling list</h1>

<p data-testid="recycling-status">@_status</p>

<button type="button" class="btn btn-secondary" data-testid="recycle-btn" @onclick="RecycleAsync">Recycle</button>
<button type="button" class="btn btn-secondary" data-testid="reset-btn" @onclick="Reset">Reset</button>

<div data-testid="recycling-list" style="height: 320px; overflow-y: auto; margin-top: 12px;">
    <Virtualize Items="_items" Context="item" ItemSize="36">
        <div data-testid="todo-row" data-item-key="@item.Id" style="height: 36px; display: flex; gap: 12px; align-items: center;">
            <span data-testid="title">@item.Title</span>
            <button type="button" class="btn btn-sm btn-outline-danger" data-testid="delete-btn" @onclick="() => Delete(item)">Delete</button>
        </div>
    </Virtualize>
</div>

@code {
    private sealed record Item(string Id, string Title);

    private List<Item> _items = Seed();
    private string _status = "Ready";

    private static List<Item> Seed()
        => [.. Enumerable.Range(1, 200).Select(n => new Item($"item-{n:000}", $"Todo {n:000}"))];

    // After a short delay, so a test sees the old order first: the same nodes then show other items.
    private async Task RecycleAsync()
    {
        _status = "Recycling";
        await Task.Delay(300);
        _items = [.. _items.Skip(3).Concat(_items.Take(3))];
        _status = "Recycled";
    }

    private void Delete(Item item)
    {
        _items.Remove(item);
        _items = [.. _items];
        _status = $"Deleted {item.Title}";
    }

    private void Reset()
    {
        _items = Seed();
        _status = "Ready";
    }
}
