@page "/places/{Id:guid}"
@inject IDbContextFactory<SpikeDbContext> Data

<PageTitle>@_place?.Name</PageTitle>

@if (_place is null)
{
    <p data-testid="not-found">No such place.</p>
}
else
{
    <h1 data-testid="place-name">@_place.Name</h1>
    <p>Kind: <span data-testid="place-kind">@_place.Kind</span></p>
    <p>Population: <span data-testid="place-population">@_place.Population.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</span></p>
    <p>Visits: <span data-testid="place-visits">@_visits</span></p>
    <p>From @PlaceSeed.Origin: <span data-testid="place-distance">@(_distanceKm?.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)) km</span></p>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Place? _place;
    private double? _distanceKm;
    private int _visits;

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await Data.CreateDbContextAsync();
        _place = await db.Places.AsNoTracking().SingleOrDefaultAsync(p => p.Id == Id);
        if (_place is null)
        {
            return;
        }

        // Measured by the database on geography: a spatial parameter in and a distance out.
        var origin = await db.Places.Where(p => p.Name == PlaceSeed.Origin).Select(p => p.Location).SingleAsync();
        var meters = await db.Places.Where(p => p.Id == Id).Select(p => p.Location.Distance(origin)).SingleAsync();
        _distanceKm = meters / 1000;
        _visits = await db.Visits.CountAsync(v => v.PlaceId == Id);
    }
}
