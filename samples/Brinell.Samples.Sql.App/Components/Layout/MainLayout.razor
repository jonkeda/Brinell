@inherits LayoutComponentBase
@inject IJSRuntime JS

<main>
    @Body
</main>

@code {
    // The app is interactive now: set the busy signal, which Blazor page objects wait for (brinell-busy.js).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("brinellBusy.set", false);
        }
    }
}
