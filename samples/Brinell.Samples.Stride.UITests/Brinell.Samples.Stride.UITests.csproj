      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Brinell.Stride\Brinell.Stride.csproj" />
    <ProjectReference Include="..\..\src\Brinell.Core\Brinell.Core.csproj" />
  </ItemGroup>

