@page "/dashboard"

<PageTitle>Dashboard - Brinell Blazor Sample</PageTitle>

<h1 id="dashboard-title">Dashboard</h1>

<div class="alert alert-info" id="welcome-alert">
    <strong>Welcome!</strong> You have successfully logged in.
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card" id="stats-card-1">
            <div class="card-body">
                <h5 class="card-title">Total Users</h5>
                <p class="card-text display-4" id="total-users">1,234</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card" id="stats-card-2">
            <div class="card-body">
                <h5 class="card-title">Active Sessions</h5>
                <p class="card-text display-4" id="active-sessions">567</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card" id="stats-card-3">
            <div class="card-body">
                <h5 class="card-title">Tests Passed</h5>
                <p class="card-text display-4" id="tests-passed">98%</p>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <h2>Recent Activity</h2>
    <table class="table table-striped" id="activity-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Action</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <tr id="activity-row-1">
                <td>2024-12-30</td>
                <td>User Login</td>
                <td><span class="badge bg-success">Success</span></td>
            </tr>
            <tr id="activity-row-2">
                <td>2024-12-30</td>
                <td>Test Suite Run</td>
                <td><span class="badge bg-success">Success</span></td>
            </tr>
            <tr id="activity-row-3">
                <td>2024-12-29</td>
                <td>Configuration Update</td>
                <td><span class="badge bg-warning text-dark">Pending</span></td>
            </tr>
        </tbody>
    </table>
</div>

<div class="mt-4">
    <a href="/" class="btn btn-outline-secondary" id="back-home-btn">Back to Home</a>
</div>
