@page "/dashboard"

<PageTitle>Dashboard - Brinell Blazor Sample</PageTitle>

<div data-automation-id="DashboardPage">
    <h1 data-automation-id="DashboardTitle">Dashboard</h1>
    <p class="text-muted" data-automation-id="LastUpdated">Last updated: @DateTime.Now.ToString("g")</p>

    <!-- Welcome Alert -->
    <div class="alert alert-info" data-automation-id="WelcomeAlert">
        <strong>Welcome!</strong> You have successfully logged in.
    </div>

    <!-- KPI Cards -->
    <div class="row mt-4" data-automation-id="KpiCardsRow">
        <div class="col-md-3">
            <div class="card bg-primary text-white" data-automation-id="KpiCard1">
                <div class="card-body">
                    <h5 class="card-title" data-automation-id="Kpi1Title">Total Users</h5>
                    <p class="card-text display-4" data-automation-id="Kpi1Value">@kpi1Value</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white" data-automation-id="KpiCard2">
                <div class="card-body">
                    <h5 class="card-title" data-automation-id="Kpi2Title">Active Sessions</h5>
                    <p class="card-text display-4" data-automation-id="Kpi2Value">@kpi2Value</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark" data-automation-id="KpiCard3">
                <div class="card-body">
                    <h5 class="card-title" data-automation-id="Kpi3Title">Pending Tasks</h5>
                    <p class="card-text display-4" data-automation-id="Kpi3Value">@kpi3Value</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white" data-automation-id="KpiCard4">
                <div class="card-body">
                    <h5 class="card-title" data-automation-id="Kpi4Title">Completion Rate</h5>
                    <p class="card-text display-4" data-automation-id="Kpi4Value">@kpi4Value%</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Progress Section -->
    <div class="card mt-4" data-automation-id="ProgressSection">
        <div class="card-header">
            <h5 data-automation-id="ProgressTitle">Loading Progress</h5>
        </div>
        <div class="card-body">
            <div class="progress mb-3" data-automation-id="ProgressBar">
                <div class="progress-bar" role="progressbar" style="width: @progressValue%;" 
                     aria-valuenow="@progressValue" aria-valuemin="0" aria-valuemax="100"
                     data-automation-id="ProgressBarFill">
                    @progressValue%
                </div>
            </div>
            @if (isLoading)
            {
                <div class="spinner-border text-primary" role="status" data-automation-id="LoadingSpinner">
                    <span class="visually-hidden">Loading...</span>
                </div>
            }
        </div>
    </div>

    <!-- Tabs Section -->
    <div class="card mt-4" data-automation-id="TabsSection">
        <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs" data-automation-id="TabList">
                <li class="nav-item">
                    <button class="nav-link @(activeTab == 0 ? "active" : "")" 
                            @onclick="() => activeTab = 0"
                            data-automation-id="TabOverview">Overview</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == 1 ? "active" : "")" 
                            @onclick="() => activeTab = 1"
                            data-automation-id="TabAnalytics">Analytics</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == 2 ? "active" : "")" 
                            @onclick="() => activeTab = 2"
                            data-automation-id="TabReports">Reports</button>
                </li>
            </ul>
        </div>
        <div class="card-body" data-automation-id="TabContent">
            @if (activeTab == 0)
            {
                <div data-automation-id="TabPanelOverview">
                    <h5>Overview</h5>
                    <p>System overview and quick stats appear here.</p>
                </div>
            }
            else if (activeTab == 1)
            {
                <div data-automation-id="TabPanelAnalytics">
                    <h5>Analytics</h5>
                    <p>Detailed analytics and charts would be displayed here.</p>
                </div>
            }
            else
            {
                <div data-automation-id="TabPanelReports">
                    <h5>Reports</h5>
                    <p>Generate and view reports from this section.</p>
                </div>
            }
        </div>
    </div>

    <!-- Recent Activity Table -->
    <div class="card mt-4" data-automation-id="ActivitySection">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 data-automation-id="ActivityTitle">Recent Activity</h5>
            <button class="btn btn-sm btn-outline-primary" @onclick="RefreshData" 
                    disabled="@isLoading" data-automation-id="RefreshButton">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                }
                Refresh
            </button>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover" data-automation-id="ActivityTable">
                <thead>
                    <tr>
                        <th data-automation-id="HeaderDate">Date</th>
                        <th data-automation-id="HeaderAction">Action</th>
                        <th data-automation-id="HeaderStatus">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (activity, index) in activities.Select((a, i) => (a, i)))
                    {
                        <tr data-automation-id="@($"ActivityRow_{index}")">
                            <td data-automation-id="@($"ActivityDate_{index}")">@activity.Date.ToString("yyyy-MM-dd")</td>
                            <td data-automation-id="@($"ActivityAction_{index}")">@activity.Action</td>
                            <td data-automation-id="@($"ActivityStatus_{index}")">
                                <span class="badge @GetStatusClass(activity.Status)">@activity.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="mt-4 d-flex gap-2" data-automation-id="ActionButtons">
        <button class="btn btn-primary" @onclick="RefreshData" data-automation-id="RefreshDataButton">
            Refresh Data
        </button>
        <button class="btn btn-secondary" @onclick="ExportData" data-automation-id="ExportButton">
            Export
        </button>
        <a href="/" class="btn btn-outline-secondary" data-automation-id="BackHomeButton">
            Back to Home
        </a>
    </div>
</div>

@code {
    private int kpi1Value = 1234;
    private int kpi2Value = 567;
    private int kpi3Value = 89;
    private int kpi4Value = 98;
    private int progressValue = 75;
    private bool isLoading = false;
    private int activeTab = 0;

    private List<ActivityItem> activities = new()
    {
        new("2024-12-30", "User Login", "Success"),
        new("2024-12-30", "Test Suite Run", "Success"),
        new("2024-12-29", "Configuration Update", "Pending"),
        new("2024-12-28", "Data Export", "Success"),
        new("2024-12-27", "System Backup", "Warning")
    };

    private async Task RefreshData()
    {
        isLoading = true;
        progressValue = 0;
        StateHasChanged();

        for (int i = 0; i <= 100; i += 10)
        {
            progressValue = i;
            StateHasChanged();
            await Task.Delay(100);
        }

        kpi1Value = Random.Shared.Next(1000, 2000);
        kpi2Value = Random.Shared.Next(500, 1000);
        kpi3Value = Random.Shared.Next(50, 150);
        kpi4Value = Random.Shared.Next(90, 100);

        isLoading = false;
    }

    private void ExportData()
    {
        // Simulated export
    }

    private string GetStatusClass(string status) => status switch
    {
        "Success" => "bg-success",
        "Pending" => "bg-warning text-dark",
        "Warning" => "bg-warning text-dark",
        "Error" => "bg-danger",
        _ => "bg-secondary"
    };

    private record ActivityItem(string DateStr, string Action, string Status)
    {
        public DateTime Date => DateTime.Parse(DateStr);
    }
}
