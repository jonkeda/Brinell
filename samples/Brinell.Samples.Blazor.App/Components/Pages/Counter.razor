@page "/counter"

<PageTitle>Counter - Brinell Blazor Sample</PageTitle>

<h1 id="counter-title">Counter</h1>

<p role="status" id="count-display">Current count: @_currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount" id="increment-btn">
    Click me
</button>

<div class="mt-3">
    <button class="btn btn-secondary" @onclick="ResetCount" id="reset-btn">
        Reset
    </button>
</div>

@code {
    private int _currentCount = 0;

    private void IncrementCount()
    {
        _currentCount++;
    }

    private void ResetCount()
    {
        _currentCount = 0;
    }
}
