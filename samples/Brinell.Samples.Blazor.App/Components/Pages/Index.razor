@page "/"

<PageTitle>Home - Brinell Blazor Sample</PageTitle>

<h1 id="page-title">Welcome to Brinell Blazor Sample</h1>

<p id="welcome-message">
    This is a sample Blazor Server application demonstrating the Brinell UI Testing Framework.
</p>

<div class="mt-4">
    <h2>Sample Pages</h2>
    <ul>
        <li>
            <a href="counter" id="link-counter">Counter</a> - Classic Blazor counter demo with increment button
        </li>
        <li>
            <a href="login" id="link-login">Login</a> - Form validation and async submission demo
        </li>
        <li>
            <a href="dashboard" id="link-dashboard">Dashboard</a> - Protected dashboard page
        </li>
    </ul>
</div>

<div class="mt-4">
    <h2>Testing Features</h2>
    <p>
        All interactive elements in this application have <code>id</code> attributes
        to facilitate automated UI testing with Selenium WebDriver.
    </p>
</div>
