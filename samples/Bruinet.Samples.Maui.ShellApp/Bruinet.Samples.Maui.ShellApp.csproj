<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      iOS too: the Shell suite runs on the mobile head against an iOS simulator as well. net10.0 is
      the app for the MauiHeadless head, as in Bruinet.Samples.Maui.App; Windows only on Windows.
    -->
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0;$(TargetFrameworks)</TargetFrameworks>
    <OutputType Condition="'$(TargetFramework)' != 'net10.0'">Exe</OutputType>
    <RootNamespace>Bruinet.Samples.Maui.ShellApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Disable TreatWarningsAsErrors inherited from Directory.Build.props -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <ApplicationTitle>Bruinet Shell Sample</ApplicationTitle>
    <ApplicationId>com.bruinet.samples.shell</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>

    <!--
      Embed the managed assemblies in the APK even in Debug: a UI test installs only the APK,
      and Fast Deployment would leave them out, aborting the app before any test code runs.
      Same reason as the other sample app.
    -->
    <EmbedAssembliesIntoApk Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinet.Maui.AppSupport\Bruinet.Maui.AppSupport.csproj" />
  </ItemGroup>

  <!-- The MauiHeadless build: no platform code and no app builder; a test composes the app itself. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="MauiProgram.cs;Platforms\**" />
    <MauiXaml Remove="Platforms\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
  </ItemGroup>

</Project>
