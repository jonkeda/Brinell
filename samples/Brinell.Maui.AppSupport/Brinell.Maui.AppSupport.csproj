<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Multi-targeted so an app under test can reference this from any platform head.
      The automation peers themselves are WinUI-only (see the Compile Remove below):
      MAUI layouts lack an AutomationPeer on Windows, which is the problem this project
      exists to solve. Android and iOS expose AutomationId natively and need nothing.
    -->
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0-android;net10.0-ios</TargetFrameworks>
    <RootNamespace>Brinell.Maui.AppSupport</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Match the sample app: this repo's Directory.Build.props turns warnings into
         errors, which is inappropriate for code that is meant to be copied out. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <!--
    DELIBERATELY NO ProjectReference TO ANYTHING IN THIS REPO.

    This project is designed to be copied, not only referenced. An app under test is
    often one Brinell cannot add a dependency to - third-party, legacy, or otherwise
    outside our control - and dropping these source files in must remain a viable
    route. A reference to Brinell.Core or Brinell.Maui would break that silently.

    Microsoft.Maui.* only. Keep it that way.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <!--
    The handlers reference Microsoft.UI.Xaml directly, so they compile only for Windows.
    Excluded by file rather than wrapped in #if WINDOWS: these files are meant to be copied
    into an app under test, and a reader should not have to mentally strip preprocessor
    directives to see what the peer does.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
    <Compile Remove="Handlers\**" />
  </ItemGroup>

</Project>
