<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Shell sample app's pages and resources on plain net10.0, for the MauiUnit head (.my/mUnit).
    Every file is LINKED from Bruinet.Samples.Maui.ShellApp, never copied, so the MauiUnit run tests
    the app as it is. Platforms\ and MauiProgram stay out, as in Bruinet.Samples.Maui.App.MauiUnit.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>Bruinet.Samples.Maui.ShellApp</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The app's own setting: its code is sample code, not held to the repo's warning bar. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0618;XC0022;XC0023;XC0025;MAUIG2045</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <App>..\Bruinet.Samples.Maui.ShellApp\</App>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinet.Maui.AppSupport\Bruinet.Maui.AppSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(App)**\*.cs"
             Exclude="$(App)bin\**;$(App)obj\**;$(App)Platforms\**;$(App)MauiProgram.cs;$(App)**\*.xaml.cs"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiXaml Include="$(App)**\*.xaml"
              Exclude="$(App)bin\**;$(App)obj\**;$(App)Platforms\**"
              Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(App)**\*.xaml.cs"
             Exclude="$(App)bin\**;$(App)obj\**;$(App)Platforms\**"
             Link="%(RecursiveDir)%(Filename)%(Extension)"
             DependentUpon="%(Filename)" />
  </ItemGroup>

</Project>
