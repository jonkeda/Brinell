<Window x:Class="Brinell.Samples.Wpf.App.Features.Shell.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Brinell.Samples.Wpf.App.Features.Shell.ViewModels"
        xmlns:homeViews="clr-namespace:Brinell.Samples.Wpf.App.Features.Home.Views"
        xmlns:homeVm="clr-namespace:Brinell.Samples.Wpf.App.Features.Home.ViewModels"
        xmlns:loginViews="clr-namespace:Brinell.Samples.Wpf.App.Features.Login.Views"
        xmlns:loginVm="clr-namespace:Brinell.Samples.Wpf.App.Features.Login.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="ShellWindow"
        d:DataContext="{d:DesignInstance Type=viewmodels:ShellViewModel}">
    
    <Window.Resources>
        <!-- DataTemplates for ViewModel to View mapping -->
        <DataTemplate DataType="{x:Type homeVm:HomeViewModel}">
            <homeViews:HomePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type loginVm:LoginViewModel}">
            <loginViews:LoginPage/>
        </DataTemplate>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Sidebar Navigation -->
        <Border Grid.Column="0"
                Background="#2D2D30"
                AutomationProperties.AutomationId="SidebarPanel">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- App Title -->
                <TextBlock Grid.Row="0"
                           Text="Brinell Sample"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="16,20,16,20"
                           AutomationProperties.AutomationId="AppTitleText"/>
                
                <!-- Navigation Menu -->
                <StackPanel Grid.Row="1"
                            AutomationProperties.AutomationId="NavigationMenu">
                    <Button Content="🏠  Home"
                            Command="{Binding NavigateHomeCommand}"
                            Style="{StaticResource NavButtonStyle}"
                            Foreground="White"
                            AutomationProperties.AutomationId="NavHomeButton"/>
                    
                    <Button Content="🔐  Login"
                            Command="{Binding NavigateLoginCommand}"
                            Style="{StaticResource NavButtonStyle}"
                            Foreground="White"
                            AutomationProperties.AutomationId="NavLoginButton"/>
                    
                    <Button Content="📝  Forms"
                            Command="{Binding NavigateFormsCommand}"
                            Style="{StaticResource NavButtonStyle}"
                            Foreground="White"
                            AutomationProperties.AutomationId="NavFormsButton"/>
                    
                    <Button Content="📊  DataGrid"
                            Command="{Binding NavigateDataGridCommand}"
                            Style="{StaticResource NavButtonStyle}"
                            Foreground="White"
                            AutomationProperties.AutomationId="NavDataGridButton"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Content Area -->
        <Border Grid.Column="1"
                Background="#F0F0F0"
                AutomationProperties.AutomationId="ContentArea">
            <ContentControl Content="{Binding CurrentViewModel}"
                            AutomationProperties.AutomationId="ContentHost"/>
        </Border>
    </Grid>
</Window>
