<UserControl x:Class="Brinell.Samples.Wpf.App.Features.Home.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:Brinell.Samples.Wpf.App.Features.Home.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:HomeViewModel}"
             AutomationProperties.AutomationId="HomePage">
    
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Welcome Header -->
            <TextBlock Text="{Binding WelcomeMessage}"
                       Style="{StaticResource HeaderStyle}"
                       TextAlignment="Center"
                       AutomationProperties.AutomationId="WelcomeText"/>
            
            <!-- Description -->
            <TextBlock Text="{Binding Description}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="500"
                       Margin="0,16,0,0"
                       AutomationProperties.AutomationId="DescriptionText"/>
            
            <!-- Feature List -->
            <Border Background="#F5F5F5" 
                    CornerRadius="8" 
                    Padding="24" 
                    Margin="0,32,0,0"
                    AutomationProperties.AutomationId="FeatureListPanel">
                <StackPanel>
                    <TextBlock Text="Features"
                               Style="{StaticResource SubHeaderStyle}"
                               AutomationProperties.AutomationId="FeaturesHeader"/>
                    
                    <TextBlock Text="• Login with form validation" Margin="0,4"/>
                    <TextBlock Text="• Navigation between pages" Margin="0,4"/>
                    <TextBlock Text="• Async command patterns" Margin="0,4"/>
                    <TextBlock Text="• UI automation support" Margin="0,4"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
