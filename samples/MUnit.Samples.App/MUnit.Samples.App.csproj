<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The pages MUnit's own tests render: a MAUI class library on plain net10.0, XAML included. An app
    makes its pages testable the same way - a library with the pages, view models and services, which
    the platform heads and the test project both reference.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>MUnit.Samples.App</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

</Project>
