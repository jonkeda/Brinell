<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MUnit.Samples.App.Pages.GreetingView">

    <VerticalStackLayout>
        <Label x:Name="Greeting" AutomationId="Greeting" Text="Hello, stranger" />
        <Button AutomationId="Wave" Text="Wave" Clicked="OnWave" />
        <Label x:Name="Waves" AutomationId="Waves" Text="No waves yet" IsVisible="False" />
    </VerticalStackLayout>

</ContentView>
