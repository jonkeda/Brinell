<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    
    <!-- Versioning -->
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    
    <!-- Package metadata -->
    <Authors>Bruinet Contributors</Authors>
    <Company>Bruinet</Company>
    <Product>Bruinet UI Test Framework</Product>
    <Copyright>Copyright © 2024-$([System.DateTime]::Now.Year) Bruinet Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/exact-mobile-apps/test-tooling</PackageProjectUrl>
    <RepositoryUrl>https://github.com/exact-mobile-apps/test-tooling</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ui-testing;automation;wpf;maui;selenium;flaui;testing;page-object</PackageTags>
    
    <!-- Source Link -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    
    <!-- Deterministic builds, for what ships. Tests and samples keep real PDB paths: the language
         server tests navigate to their sources, which a deterministic build maps to /_/. -->
    <!-- Whether the MAUI suites build with the Windows head (FlaUI, net10.0-windows): on Windows, yes.
         Elsewhere (a Mac, Linux) they build for plain net10.0, with the MauiHeadless and Appium heads only.
         -p:BruinetWindowsHead=false builds that shape on Windows. -->
    <BruinetWindowsHead Condition="'$(BruinetWindowsHead)' == ''">$([MSBuild]::IsOSPlatform('Windows'))</BruinetWindowsHead>

    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' and !$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)tests')) and !$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)samples'))">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>
