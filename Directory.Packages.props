<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Testing -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.extensibility.core" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="AutoFixture" Version="4.18.1" />
    <PackageVersion Include="AutoFixture.Xunit2" Version="4.18.1" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <!-- MUnit's examples on NUnit and MSTest: MUnit itself depends on no test framework (.my/mUnit). -->
    <PackageVersion Include="NUnit" Version="4.3.2" />
    <PackageVersion Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageVersion Include="MSTest.TestFramework" Version="3.9.3" />
    <PackageVersion Include="MSTest.TestAdapter" Version="3.9.3" />
    <!-- The Todo journey coverage report reads test assemblies of any TFM without loading them. -->
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="10.0.12" />
    <!-- FlaUI for WPF -->
    <PackageVersion Include="FlaUI.Core" Version="5.0.0" />
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
    <!-- Selenium for HTML/Web -->
    <PackageVersion Include="Selenium.WebDriver" Version="4.29.0" />
    <PackageVersion Include="Selenium.Support" Version="4.29.0" />
    <PackageVersion Include="WebDriverManager" Version="2.17.5" />
    <!-- bUnit for the Html driver without a browser (.my/bunit/plan.md) -->
    <PackageVersion Include="bunit" Version="2.12.5" />
    <!-- Playwright for HTML/Web (alternative to Selenium) -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
    <!-- Appium for MAUI/Mobile -->
    <PackageVersion Include="Appium.WebDriver" Version="8.3.2" />

    <!-- AndroidX and Material for the native Android sample app: the versions MAUI 10 resolves -->
    <PackageVersion Include="Xamarin.AndroidX.AppCompat" Version="1.7.1.1" />
    <PackageVersion Include="Xamarin.AndroidX.RecyclerView" Version="1.4.0.3" />
    <PackageVersion Include="Xamarin.AndroidX.SwipeRefreshLayout" Version="1.1.0.29" />
    <PackageVersion Include="Xamarin.Google.Android.Material" Version="1.12.0.5" />
    <!-- MAUI -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
    <PackageVersion Include="CommunityToolkit.Maui" Version="14.0.1" />
    <PackageVersion Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
    <!-- WireMock for API mocking -->
    <PackageVersion Include="WireMock.Net" Version="2.15.0" />
    <!-- Source Link -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
    <!-- Transitive packages pinned past a security advisory, until their parents carry the fix:
         Pkcs comes with Stride's toolkit (GHSA-2fmv-rv2c-59x7), MessagePack with StreamJsonRpc
         (GHSA-qhrr-8q5h-9q3h). Each the patched version of its own line. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
    <PackageVersion Include="MessagePack" Version="2.5.303" />
    <!-- Stride 3D Engine -->
    <PackageVersion Include="Stride.Engine" Version="4.3.0.2507" />
    <PackageVersion Include="Stride.UI" Version="4.3.0.2507" />
    <PackageVersion Include="Stride.Graphics" Version="4.3.0.2507" />
    <PackageVersion Include="Stride.Rendering" Version="4.3.0.2507" />
    <PackageVersion Include="Stride.CommunityToolkit.Windows" Version="1.0.0-preview.62" />
    <PackageVersion Include="Stride.CommunityToolkit.Bepu" Version="1.0.0-preview.62" />
    <!-- Entity Framework Core -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <!-- The SQL replay spike's app on SQL Server (.my/sql-replay/plan.md) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer.NetTopologySuite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <!-- The SQL replay spike's browser head: the sample hosted in the test's process on Kestrel -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- The SQL log's SQL Server tests and bruinell sql: schema snapshots and Extended Events (.my/sql-replay/plan.md, step 1) -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.6" />
    <!-- Serilog -->
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <!-- WebView2 (the Visual Studio extension), DI, SQLite (the Todo sample), Roslyn (the generator) -->
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <!-- The UAT workspace, preview and language server (tools/) -->
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.12" />
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="StreamJsonRpc" Version="2.25.29" />
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
    <!-- The Visual Studio extension (tools/Bruinell.Bdd.VisualStudio, its own .slnx): VS 2022 17.10 and later. -->
    <PackageVersion Include="Microsoft.VisualStudio.SDK" Version="17.10.40171" />
    <PackageVersion Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" />
  </ItemGroup>
</Project>