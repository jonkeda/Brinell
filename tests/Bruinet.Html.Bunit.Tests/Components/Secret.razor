@* Signed-in and role checks for the context's test authorization (AD-030). *@
<AuthorizeView>
    <Authorized><span data-testid="who">@context.User.Identity?.Name</span></Authorized>
    <NotAuthorized><span data-testid="who">Not signed in</span></NotAuthorized>
</AuthorizeView>
<AuthorizeView Roles="admin">
    <Authorized><span data-testid="admin">Admin</span></Authorized>
    <NotAuthorized><span data-testid="admin">Not an admin</span></NotAuthorized>
</AuthorizeView>
