@* A layout's busy signal, as the sample's MainLayout gives it through bruinet-busy.js. *@
@inject IJSRuntime JS

<button data-testid="work" @onclick="Work">Work</button>
<span data-testid="state">@state</span>

@code {
    private string state = "Idle";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("bruinetBusy.set", false);
        }
    }

    private async Task Work()
    {
        await JS.InvokeVoidAsync("bruinetBusy.set", true);
        state = "Working";
        await Task.Delay(300);
        state = "Done";
        await JS.InvokeVoidAsync("bruinetBusy.set", false);
    }
}
