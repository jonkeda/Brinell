<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bruinet.Maui.UITests</RootNamespace>
    <!-- Windows: every head. Elsewhere: MauiHeadless and Appium (BruinetWindowsHead, Directory.Build.props). -->
    <TargetFramework Condition="'$(BruinetWindowsHead)' == 'true'">net10.0-windows</TargetFramework>
  </PropertyGroup>

  <!-- Off Windows: the tests of the Windows driver itself (screenshots, user32, the desktop), as the
       mobile project leaves them out. -->
  <ItemGroup Condition="'$(BruinetWindowsHead)' != 'true'">
    <Compile Remove="Tests\Diagnostics\**;Tests\Background\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bruinet.Core\Bruinet.Core.csproj" />
    <ProjectReference Include="..\..\src\Bruinet.Maui.CommunityToolkit\Bruinet.Maui.CommunityToolkit.csproj" />
    <ProjectReference Include="..\..\src\Bruinet.Maui\Bruinet.Maui.csproj" />
    <ProjectReference Include="..\..\src\Bruinet.Maui.FlaUI\Bruinet.Maui.FlaUI.csproj" Condition="'$(BruinetWindowsHead)' == 'true'" />
    <!-- Android and iOS. MauiDriverFactory loads this by assembly name at runtime, so the
         compile-time reference is optional but the assembly must reach the output directory;
         without it an APPIUM_PLATFORM=android run fails in the fixture constructor. -->
    <ProjectReference Include="..\..\src\Bruinet.Maui.Appium\Bruinet.Maui.Appium.csproj" />
    <!-- The MauiHeadless head (BRUINET_HEAD=headless, docs/guides/maui-headless.md): both sample apps' own net10.0 build, rendered headless by the fixtures' CreateHeadlessOptions. -->
    <ProjectReference Include="..\..\src\Bruinet.Maui.Headless\Bruinet.Maui.Headless.csproj" />
    <ProjectReference Include="..\..\samples\Bruinet.Samples.Maui.App\Bruinet.Samples.Maui.App.csproj" SetTargetFramework="TargetFramework=net10.0" />
    <ProjectReference Include="..\..\samples\Bruinet.Samples.Maui.ShellApp\Bruinet.Samples.Maui.ShellApp.csproj" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Pages\ViewPages\" />
  </ItemGroup>

  <!--
    Step 35: the per-class timing baseline the report compares against. Refresh it by copying a good
    run's TestResults/.../attachments/test-timings-baseline-candidate.json over this file.
  -->
  <ItemGroup>
    <None Include="timing-baseline.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('timing-baseline.json')" />
  </ItemGroup>

  <!-- The UAT suite: uat.config.md, Features/ and Uat/ (the fixture and the scenario test class). -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bruinet.Uat\Bruinet.Uat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="uat.config.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Features\**\*.feature.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Features\**\*.video.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="ExpectedFailures\**\*.feature.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestSettings\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Bruinet.Bdd" />
  </ItemGroup>

</Project>
