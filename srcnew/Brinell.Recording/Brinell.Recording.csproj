<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Brinell.Recording</RootNamespace>
    <Description>Screen recording for Brinell: one recorder API, a registry of recorders per platform, the shared clock and the ffmpeg encoder.</Description>
    <PackageId>Brinell.Recording</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Brinell.Core\Brinell.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Brinell.Recording.Windows" />
    <InternalsVisibleTo Include="Brinell.Recording.Tests" />
    <InternalsVisibleTo Include="Brinell.Narrator" />
  </ItemGroup>

</Project>
