<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Brinell.Core</RootNamespace>
    <Description>Platform-agnostic UI testing abstractions for .NET applications. Provides interfaces and base classes for building cross-platform UI test automation.</Description>
    <PackageId>Brinell.Core</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.extensibility.core" PrivateAssets="all" />
  </ItemGroup>

</Project>
