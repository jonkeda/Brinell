<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Bruinet.Presenter</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationTitle>Bruinet Presenter</ApplicationTitle>
    <ApplicationId>com.bruinet.presenter</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
    <!-- Version is pinned centrally in Directory.Packages.props - do not add one here. -->
    <PackageReference Include="CommunityToolkit.Maui" />
  </ItemGroup>

  <ItemGroup>
    <!-- Color is PresenterAccent, matching Resources/Styles/Colors.xaml. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2563EB" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2563EB" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinet.Maui\Bruinet.Maui.csproj" />
    <ProjectReference Include="..\Bruinet.Maui.FlaUI\Bruinet.Maui.FlaUI.csproj" />
    <ProjectReference Include="..\Bruinet.Uat\Bruinet.Uat.csproj" />
    <!-- Presenter is an app under test too (Bruinet.Presenter.Bdd.Tests): the automation handlers
         that give its layouts an AutomationId on Windows, and the gesture bridge. The one
         reference from srcnew into samples: AppSupport is what an app under test adds. -->
    <ProjectReference Include="..\..\samples\Bruinet.Maui.AppSupport\Bruinet.Maui.AppSupport.csproj" />
    <!-- Record: the window recorder and Windows' voices (the narrator). -->
    <ProjectReference Include="..\Bruinet.Narrator.Windows\Bruinet.Narrator.Windows.csproj" />
    <!-- The suite and the file check the IDEs use, so Presenter says what the gate says (AD-022). -->
    <ProjectReference Include="..\Bruinet.Bdd.Workspace\Bruinet.Bdd.Workspace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Bruinet.Bdd" />
  </ItemGroup>

</Project>
