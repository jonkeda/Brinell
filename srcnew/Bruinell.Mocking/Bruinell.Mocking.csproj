<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>Bruinell.Mocking</RootNamespace>
    <Description>API mocking infrastructure for UI tests. Provides WireMock-based mock servers for simulating backend services during testing.</Description>
    <PackageId>Bruinell.Mocking</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- Suppress WireMock transitive dependency vulnerability (System.Linq.Dynamic.Core) -->
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinell.Core\Bruinell.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WireMock.Net" />
  </ItemGroup>

  <ItemGroup>
    <!-- BRUINELL001 (AD-012) ships in the package as an analyzer, so every consumer gets it. -->
    <ProjectReference Include="..\Bruinell.Mocking.Analyzers\Bruinell.Mocking.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\Bruinell.Mocking.Analyzers\bin\$(Configuration)\netstandard2.0\Bruinell.Mocking.Analyzers.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
