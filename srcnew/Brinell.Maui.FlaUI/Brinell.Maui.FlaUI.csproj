<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <RootNamespace>Brinell.Maui.FlaUI</RootNamespace>
    <Description>FlaUI-based driver implementation for MAUI UI testing on Windows platform.</Description>
    <PackageId>Brinell.Maui.FlaUI</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Brinell.Maui\Brinell.Maui.csproj" />

    <!--
      The wire contract for the UI Automation bridge. Referenced here rather than linked,
      because unlike the app under test this assembly is ours and a dependency costs nothing.
      The app under test links the same sources instead - see Brinell.Maui.AppSupport.
    -->
    <ProjectReference Include="..\Brinell.Uia.Contracts\Brinell.Uia.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.Core" />
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>

</Project>
