<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- MAUI 10 ships its plain (no platform) assemblies for net10.0 only. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>MauiUnit</RootNamespace>
    <Description>Headless component testing for .NET MAUI: pages, views and view models rendered in memory, driven and asserted without a device, emulator or window.</Description>
    <PackageId>MauiUnit</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
