<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- MAUI 10's plain assemblies are net10.0 only. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>Bruinet.Maui.MauiUnit</RootNamespace>
    <Description>MauiUnit implementation for Bruinet.Maui: the same page objects and controls on a page rendered in memory, without a device, emulator or window (docs/guides/mauiunit.md).</Description>
    <PackageId>Bruinet.Maui.MauiUnit</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinet.Maui\Bruinet.Maui.csproj" />
    <ProjectReference Include="..\MauiUnit\MauiUnit.csproj" />
  </ItemGroup>

</Project>
