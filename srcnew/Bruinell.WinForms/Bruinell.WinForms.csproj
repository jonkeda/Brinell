<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <RootNamespace>Bruinell.WinForms</RootNamespace>
    <Description>WinForms UI testing automation using FlaUI. Provides controls and page objects for WinForms application testing.</Description>
    <PackageId>Bruinell.WinForms</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinell.Core\Bruinell.Core.csproj" />
    <ProjectReference Include="..\Bruinell.Core.Legacy\Bruinell.Core.Legacy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.Core" />
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>

</Project>
