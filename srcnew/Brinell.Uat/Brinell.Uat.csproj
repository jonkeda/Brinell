<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Brinell.Uat</RootNamespace>
    <Description>Markdown-driven UAT parsing and execution core for Brinell.</Description>
    <PackageId>Brinell.Uat</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- A library with an entry point: a host starts a suite's copy of this assembly as the runner
         process (Runner/, AD-025). No app host: it is only ever started through dotnet exec. -->
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <StartupObject>Brinell.Uat.Runner.BddRunnerProgram</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="..\Brinell.Bdd\Brinell.Bdd.csproj" />
    <ProjectReference Include="..\Brinell.Core\Brinell.Core.csproj" />
    <!-- BRINELL_RECORD: a run records its scenes (the narrator). -->
    <ProjectReference Include="..\Brinell.Narrator\Brinell.Narrator.csproj" />
    <!-- [UatScenarioTheory]: a suite runs under xUnit, which brings both. -->
    <PackageReference Include="xunit.extensibility.core" PrivateAssets="all" />
    <PackageReference Include="xunit.extensibility.execution" PrivateAssets="all" />
  </ItemGroup>

</Project>
