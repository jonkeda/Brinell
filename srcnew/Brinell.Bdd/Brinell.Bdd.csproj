<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Brinell.Bdd</RootNamespace>
    <Description>Markdown feature files for Brinell: parse, bind, values, tables, callable steps, namespaces and run, with no UI.</Description>
    <PackageId>Brinell.Bdd</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="..\Brinell.Core\Brinell.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Brinell.Uat" />
  </ItemGroup>

</Project>
