<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Testing -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.extensibility.core" Version="2.9.3" />
    <PackageVersion Include="xunit.extensibility.execution" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <!-- FlaUI for WPF/WinForms -->
    <PackageVersion Include="FlaUI.Core" Version="5.0.0" />
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
    <!-- bUnit for the Html driver without a browser (.my/bunit/plan.md) -->
    <PackageVersion Include="bunit" Version="2.12.5" />
    <!-- Playwright for Blazor/Html -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
    <!-- Appium for MAUI -->
    <PackageVersion Include="Appium.WebDriver" Version="8.3.2" />
    <!-- MAUI app projects -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
    <PackageVersion Include="CommunityToolkit.Maui" Version="14.0.1" />
    <PackageVersion Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
    <!-- Markdown for feature files (AD-023) -->
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.12" />
    <!-- WireMock for API mocking -->
    <PackageVersion Include="WireMock.Net" Version="2.15.0" />
    <!-- Stride 3D Engine -->
    <PackageVersion Include="Stride.Engine" Version="4.3.0.2507" />
    <PackageVersion Include="Stride.UI" Version="4.3.0.2507" />
    <!-- Reflection-only inspection: Presenter lists fixtures without loading an assembly -->
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="10.0.12" />
    <!-- The Scraper's compile gate -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <!-- The SQL log and replay (.my/sql-replay/plan.md): JSON on netstandard2.0, EF Core's interceptors, SQLite and SQL Server in their tests -->
    <PackageVersion Include="System.Text.Json" Version="8.0.6" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.6" />
    <!-- Source Link -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
  </ItemGroup>
</Project>