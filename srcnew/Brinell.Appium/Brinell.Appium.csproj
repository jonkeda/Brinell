<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Brinell.Appium</RootNamespace>
    <Description>What the Appium stacks share: Appium's error mapping, the emulator's host address and adb reverse, and the Android screen recorder.</Description>
    <PackageId>Brinell.Appium</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Brinell.Core\Brinell.Core.csproj" />
    <!-- AndroidRecorder: a device recorded with adb screenrecord (the narrator). -->
    <ProjectReference Include="..\Brinell.Recording\Brinell.Recording.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Appium.WebDriver" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Brinell.Recording.Tests" />
  </ItemGroup>

</Project>
