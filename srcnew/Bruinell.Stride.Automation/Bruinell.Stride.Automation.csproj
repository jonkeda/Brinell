<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Stride packages only support net10.0 -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>Bruinell.Stride.Automation</RootNamespace>
    <Description>In-game automation server for Stride applications. Embeds into game to handle UI automation requests from Bruinell.Stride test client.</Description>
    <PackageId>Bruinell.Stride.Automation</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stride.Engine" />
    <PackageReference Include="Stride.UI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Bruinell.Core/Bruinell.Core.csproj" />
    <ProjectReference Include="../Bruinell.Stride/Bruinell.Stride.csproj" />
  </ItemGroup>

</Project>
