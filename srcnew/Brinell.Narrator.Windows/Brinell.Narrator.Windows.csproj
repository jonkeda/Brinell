<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Brinell.Narrator.Windows</RootNamespace>
    <Description>Windows' own voices for Brinell's narrated recordings (Windows.Media.SpeechSynthesis), offline.</Description>
    <PackageId>Brinell.Narrator.Windows</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- Its output is a folder a net10.0 run can load it from (BRINELL_RECORDERS): with the Windows SDK's projections. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Brinell.Narrator\Brinell.Narrator.csproj" />
    <!-- The window recorder comes with the voice: a run on Windows that records needs both. -->
    <ProjectReference Include="..\Brinell.Recording.Windows\Brinell.Recording.Windows.csproj" />
  </ItemGroup>

</Project>
