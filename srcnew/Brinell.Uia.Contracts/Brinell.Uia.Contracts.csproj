<Project Sdk="Microsoft.NET.Sdk">

  <!-- Decides whether this build contains the provider. Read it: it is a security gate. -->
  <Import Project="Brinell.Uia.Bridge.props" />

  <PropertyGroup>
    <!--
      Single-targeted, unlike the rest of srcnew. Everything here is Win32/COM interop
      against UIAutomationCore, so a net8.0 or net9.0 flavour would have no meaning.
    -->
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <RootNamespace>Brinell.Uia</RootNamespace>
    <Description>The wire contract for Brinell's custom UI Automation pattern: ids, verbs, and the registrar interop shared by the app under test and the test assembly.</Description>
    <PackageId>Brinell.Uia.Contracts</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    DELIBERATELY NO ProjectReference TO ANYTHING IN THIS REPO.

    Both ends of the contract compile these files: the test assembly references this
    project, and the app under test links the same sources through
    Brinell.Maui.AppSupport (which is designed to be copied, not referenced - see its
    csproj). A dependency on Brinell.Core would break the copy route silently.

    The framework only. Keep it that way.
  -->

  <!--
    The provider half, removed rather than #if'd out.

    Same reasoning as Brinell.Maui.AppSupport's Handlers folder: a reader should not have
    to mentally strip preprocessor directives from four files to see what the provider
    does, and "which files are in this build" is a question MSBuild answers plainly.
    The effect is what step 27 asks for either way - the code is absent, not disabled.

    Removed rather than merely unreferenced, so drift is a build error: anything left
    calling BrinellUiaBridge in an uninstrumented build fails to compile, here and in
    every project that links these sources.

    Provider\ ONLY. BrinellUiaClient and the ids, verbs and pattern registration stay in
    every build - they are the test side of the contract, and a client that cannot find a
    provider is exactly the outcome this gate exists to produce.
  -->
  <ItemGroup Condition="'$(BrinellUiaBridge)' != 'true'">
    <Compile Remove="Provider\**" />
  </ItemGroup>

</Project>
