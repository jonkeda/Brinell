<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- MAUI 10's plain assemblies are net10.0 only. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>Bruinell.Maui.Munit</RootNamespace>
    <Description>MUnit implementation for Bruinell.Maui: the same page objects and controls on a page rendered in memory, without a device, emulator or window (.my/mUnit).</Description>
    <PackageId>Bruinell.Maui.Munit</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinell.Maui\Bruinell.Maui.csproj" />
    <ProjectReference Include="..\MUnit\MUnit.csproj" />
  </ItemGroup>

</Project>
