<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>Bruinell.Maui.CommunityToolkit</RootNamespace>
    <Description>CommunityToolkit.Maui controls for Bruinell UI testing framework.</Description>
    <PackageId>Bruinell.Maui.CommunityToolkit</PackageId>
  </PropertyGroup>

  <!--
    No CommunityToolkit.Maui reference: control objects wrap automation elements, not MAUI
    types, so this library stays MAUI-free like Bruinell.Maui. The toolkit is referenced by
    the sample app only.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Bruinell.Maui\Bruinell.Maui.csproj" />
  </ItemGroup>

</Project>
