<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bruinell.Html.Playwright</RootNamespace>
    <Description>Playwright-based implementation for Bruinell.Html. Provides PlaywrightHtmlElement and PlaywrightTestContext for browser automation.</Description>
    <PackageId>Bruinell.Html.Playwright</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinell.Html\Bruinell.Html.csproj" />
    <!-- PlaywrightRecorder: a page recorded through Chromium's screencast (the narrator). -->
    <ProjectReference Include="..\Bruinell.Recording\Bruinell.Recording.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bruinell.Recording.Tests" />
    <InternalsVisibleTo Include="Bruinell.Html.Tests" />
  </ItemGroup>

</Project>
