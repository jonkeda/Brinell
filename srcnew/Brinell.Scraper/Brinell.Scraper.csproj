<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>Brinell.Scraper</RootNamespace>
    <Description>The Scraper's engine: recordings of an app's pages, pattern detection, matching, diff and code output for Brinell page objects and controls. No UI, no model call.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- The Html source; moves to a project of its own with the second source (AD-026, R3). -->
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Brinell.Core\Brinell.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Html\Scripts\*.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Brinell.Scraper.Tests" />
  </ItemGroup>

</Project>
