<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>Brinell.Scraper</RootNamespace>
    <Description>The Scraper's engine: recordings of an app's pages, pattern detection, matching, diff and code output for Brinell page objects and controls. No UI, no model call.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Brinell.Scraper.Tests" />
  </ItemGroup>

</Project>
