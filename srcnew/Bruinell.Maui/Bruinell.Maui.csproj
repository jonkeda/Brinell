<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bruinell.Maui</RootNamespace>
    <Description>MAUI UI testing automation. Provides controls, page objects, and driver factory for cross-platform MAUI application testing.</Description>
    <PackageId>Bruinell.Maui</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinell.Core\Bruinell.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Still needed for control implementations that catch StaleElementReferenceException, etc. -->
    <PackageReference Include="Appium.WebDriver" />
    <!-- Required for BeforeAfterTestAttribute base class used by ScreenshotTestAttribute -->
    <PackageReference Include="xunit.extensibility.core" />
  </ItemGroup>

</Project>
