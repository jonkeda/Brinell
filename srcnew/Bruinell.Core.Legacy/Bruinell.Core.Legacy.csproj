<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bruinell.Core</RootNamespace>
    <Description>The interfaces and waits of Bruinell's first model (a wait in every lookup), for the WPF, WinForms and Stride stacks until they move onto the call model. Html, MAUI and native Android never reference it (AD-029).</Description>
    <PackageId>Bruinell.Core.Legacy</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinell.Core\Bruinell.Core.csproj" />
  </ItemGroup>

</Project>
