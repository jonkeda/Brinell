<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>Brinell.Maui.CommunityToolkit</RootNamespace>
    <Description>CommunityToolkit.Maui controls for Brinell UI testing framework.</Description>
    <PackageId>Brinell.Maui.CommunityToolkit</PackageId>
  </PropertyGroup>

  <!--
    No CommunityToolkit.Maui reference: control objects wrap automation elements, not MAUI
    types, so this library stays MAUI-free like Brinell.Maui. The toolkit is referenced by
    the sample app only.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Brinell.Maui\Brinell.Maui.csproj" />
  </ItemGroup>

</Project>
