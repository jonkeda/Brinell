<?xml version="1.0" encoding="utf-8" ?>
<!--
    Presenter palette. One Color key per role per theme; call sites pick between
    them with AppThemeBinding (see Styles.xaml) so a change to Application.UserAppTheme
    repaints live without a restart.

    Contrast (WCAG 2.1, measured against both PresenterBackground and PresenterPanel
    of the matching theme): text roles >= 4.5:1, borders and status glyphs >= 3:1.
    Do not tweak a value here without re-measuring both surfaces.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Surfaces -->
    <Color x:Key="PresenterBackgroundLight">#F6F7F9</Color>
    <Color x:Key="PresenterBackgroundDark">#0D0D0F</Color>

    <Color x:Key="PresenterPanelLight">#FFFFFF</Color>
    <Color x:Key="PresenterPanelDark">#17181C</Color>

    <!-- 3.34:1 / 3.58:1 light, 3.47:1 / 3.17:1 dark. Deliberately stronger than a
         hairline: panel and background differ by only ~1.08:1, so the border is the
         only thing separating them. -->
    <Color x:Key="PresenterBorderLight">#7E8899</Color>
    <Color x:Key="PresenterBorderDark">#626875</Color>

    <!-- Text -->
    <Color x:Key="PresenterTextLight">#1F2937</Color>
    <Color x:Key="PresenterTextDark">#F2F3F5</Color>

    <Color x:Key="PresenterMutedLight">#667085</Color>
    <Color x:Key="PresenterMutedDark">#A6ADBA</Color>

    <Color x:Key="PresenterAccentLight">#2563EB</Color>
    <Color x:Key="PresenterAccentDark">#7AA5FF</Color>

    <!-- Selected tab / row fill. Body text on top measures 12.18:1 light, 11.87:1 dark. -->
    <Color x:Key="PresenterSelectedLight">#E3EAFB</Color>
    <Color x:Key="PresenterSelectedDark">#243049</Color>

</ResourceDictionary>
