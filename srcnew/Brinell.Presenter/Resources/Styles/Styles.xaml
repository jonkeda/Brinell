<?xml version="1.0" encoding="utf-8" ?>
<!--
    Every colour here goes through AppThemeBinding rather than StaticResource.
    AppThemeBinding re-evaluates when the effective theme changes, so assigning
    Application.UserAppTheme repaints the live window; StaticResource would not.

    Buttons and Entry set their colours explicitly instead of inheriting the WinUI
    defaults, so the Presenter owns its own contrast in both themes rather than
    depending on MAUI's UserAppTheme -> FrameworkElement.RequestedTheme mapping.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        The icon family, in one place so swapping to a bundled font is one line.
        Segoe Fluent Icons ships with Windows 11; Windows 10 has only Segoe MDL2 Assets.
        App.ResolveIconFont replaces this value at startup when Fluent is absent - every
        codepoint in PresenterIcons was verified present in both families, so the swap
        needs no other change.
    -->
    <x:String x:Key="PresenterIconFont">Segoe Fluent Icons</x:String>

    <Style TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource PresenterTextLight}, Dark={StaticResource PresenterTextDark}}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource PresenterTextLight}, Dark={StaticResource PresenterTextDark}}" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource PresenterPanelLight}, Dark={StaticResource PresenterPanelDark}}" />
        <Setter Property="BorderColor"
                Value="{AppThemeBinding Light={StaticResource PresenterBorderLight}, Dark={StaticResource PresenterBorderDark}}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource PresenterTextLight}, Dark={StaticResource PresenterTextDark}}" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource PresenterPanelLight}, Dark={StaticResource PresenterPanelDark}}" />
        <Setter Property="PlaceholderColor"
                Value="{AppThemeBinding Light={StaticResource PresenterMutedLight}, Dark={StaticResource PresenterMutedDark}}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource PresenterBorderLight}, Dark={StaticResource PresenterBorderDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource PresenterPanelLight}, Dark={StaticResource PresenterPanelDark}}" />
    </Style>

    <Style TargetType="ContentPage" x:Key="PresenterPageStyle">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource PresenterBackgroundLight}, Dark={StaticResource PresenterBackgroundDark}}" />
    </Style>

    <!--
        Icon-only buttons. Square, so a row of them keeps its rhythm, and centred, because a
        glyph has no ascender to align on. Every call site must still add
        SemanticProperties.Description and a tooltip - a button with no text is otherwise
        nameless to UI Automation and to a screen reader.
    -->
    <Style TargetType="Button" x:Key="PresenterIconButton">
        <Setter Property="FontFamily" Value="{StaticResource PresenterIconFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource PresenterTextLight}, Dark={StaticResource PresenterTextDark}}" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource PresenterPanelLight}, Dark={StaticResource PresenterPanelDark}}" />
        <Setter Property="BorderColor"
                Value="{AppThemeBinding Light={StaticResource PresenterBorderLight}, Dark={StaticResource PresenterBorderDark}}" />
    </Style>

    <!-- The workspace row's chevron and kind/status glyph: smaller, and borderless. -->
    <Style TargetType="Button" x:Key="PresenterRowGlyphButton" BasedOn="{StaticResource PresenterIconButton}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="WidthRequest" Value="26" />
        <Setter Property="HeightRequest" Value="26" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="Label" x:Key="PresenterGlyphLabel">
        <Setter Property="FontFamily" Value="{StaticResource PresenterIconFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- Secondary body text. Self-contained: an explicit Style suppresses the
         implicit Label one, so it repeats what it needs. -->
    <Style TargetType="Label" x:Key="PresenterMutedLabel">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource PresenterMutedLight}, Dark={StaticResource PresenterMutedDark}}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- The hidden text mirrors the UAT suite asserts against (K2). Present in the
         automation tree, 1px tall on screen. -->
    <Style TargetType="Label" x:Key="PresenterMirrorLabel">
        <Setter Property="FontSize" Value="1" />
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Opacity" Value="0.01" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource PresenterTextLight}, Dark={StaticResource PresenterTextDark}}" />
    </Style>

</ResourceDictionary>
