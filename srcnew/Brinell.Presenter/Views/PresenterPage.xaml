<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:Brinell.Presenter.Controls"
             xmlns:uia="clr-namespace:Brinell.Maui.AppSupport.Uia;assembly=Brinell.Maui.AppSupport"
             x:Class="Brinell.Presenter.Views.PresenterPage"
             Title="Brinell Presenter"
             Style="{StaticResource PresenterPageStyle}">

    <!--
        Colours live in Resources/Styles. Panels take the implicit Border style
        (stroke, thickness, panel fill) and only declare their own corner shape;
        every colour goes through AppThemeBinding so the theme toggle repaints live.

        The two toolkit Expanders each keep a real Button in the header (WP3 "Route A").
        The Expander publishes no ExpandCollapse or Invoke pattern on Windows and its own
        header tap is a toolkit-internal handler, so without that Button neither panel
        would be reachable from a UI Automation test. IsExpanded stays TwoWay-bound to the
        view model, which is still the single source of truth - ReloadWorkspace force-
        collapses the recent folders through it.
    -->
    <Grid AutomationId="PresenterRoot"
          Padding="12"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="8"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">
        <toolkit:Expander Grid.Row="0"
                          IsExpanded="{Binding IsRecentFoldersExpanded, Mode=TwoWay}">
            <!--
                The whole action row is the header, so the recent-folders list still drops
                out directly beneath the button that opens it and the toolbar keeps its
                one-row layout. OpenRecentButton stays a real Button with its own command.
            -->
            <toolkit:Expander.Header>
                <!-- Open, then Present and Workspace as a pair, the current one filled, so either can be
                     asked for whatever the mode is. Recent folders are Workspace mode's. -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <HorizontalStackLayout Grid.Column="0"
                                           Spacing="4">
                        <Button Text="&#xE838;"
                                AutomationId="OpenFolderButton"
                                Style="{StaticResource PresenterIconButton}"
                                Command="{Binding OpenFolderCommand}"
                                IsVisible="{Binding IsScenarioSectionVisible}"
                                SemanticProperties.Description="Open workspace folder"
                                ToolTipProperties.Text="Open workspace folder" />
                        <Button Text="&#xE7F4;"
                                AutomationId="PresentModeButton"
                                Style="{StaticResource PresenterIconButton}"
                                Command="{Binding ShowPresentModeCommand}"
                                SemanticProperties.Description="Present mode"
                                ToolTipProperties.Text="Present mode: the scenarios, the steps and the moves">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding IsPresentMode}"
                                             Value="True">
                                    <Setter Property="BackgroundColor"
                                            Value="{AppThemeBinding Light={StaticResource PresenterSelectedLight}, Dark={StaticResource PresenterSelectedDark}}" />
                                    <Setter Property="BorderColor"
                                            Value="{AppThemeBinding Light={StaticResource PresenterAccentLight}, Dark={StaticResource PresenterAccentDark}}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="&#xE8F1;"
                                AutomationId="WorkspaceModeButton"
                                Style="{StaticResource PresenterIconButton}"
                                Command="{Binding ShowWorkspaceModeCommand}"
                                SemanticProperties.Description="Workspace mode"
                                ToolTipProperties.Text="Workspace mode: build, config and diagnostics">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding IsWorkspaceMode}"
                                             Value="True">
                                    <Setter Property="BackgroundColor"
                                            Value="{AppThemeBinding Light={StaticResource PresenterSelectedLight}, Dark={StaticResource PresenterSelectedDark}}" />
                                    <Setter Property="BorderColor"
                                            Value="{AppThemeBinding Light={StaticResource PresenterAccentLight}, Dark={StaticResource PresenterAccentDark}}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <!-- Narrator mode: a video script's scenes, run and recorded. -->
                        <Button Text="&#xE714;"
                                AutomationId="NarratorModeButton"
                                Style="{StaticResource PresenterIconButton}"
                                Command="{Binding ShowNarratorModeCommand}"
                                SemanticProperties.Description="Narrator mode"
                                ToolTipProperties.Text="Narrator mode: a video script's scenes, run and recorded">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding IsNarratorMode}"
                                             Value="True">
                                    <Setter Property="BackgroundColor"
                                            Value="{AppThemeBinding Light={StaticResource PresenterSelectedLight}, Dark={StaticResource PresenterSelectedDark}}" />
                                    <Setter Property="BorderColor"
                                            Value="{AppThemeBinding Light={StaticResource PresenterAccentLight}, Dark={StaticResource PresenterAccentDark}}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="&#xE8E5;"
                                AutomationId="OpenScriptButton"
                                Style="{StaticResource PresenterIconButton}"
                                Command="{Binding OpenScriptCommand}"
                                IsVisible="{Binding IsNarratorMode}"
                                SemanticProperties.Description="Open a video script"
                                ToolTipProperties.Text="Open a video script (*.video.md); its suite is found from the config above it" />
                        <Button Text="{Binding RecentFoldersGlyph}"
                                AutomationId="OpenRecentButton"
                                Style="{StaticResource PresenterIconButton}"
                                Command="{Binding ToggleRecentFoldersCommand}"
                                IsVisible="{Binding IsWorkspaceMode}"
                                SemanticProperties.Description="Recent folders"
                                ToolTipProperties.Text="Recent folders" />
                        <Button Text="&#xE72C;"
                                AutomationId="ReloadButton"
                                Style="{StaticResource PresenterIconButton}"
                                Command="{Binding ReloadCommand}"
                                SemanticProperties.Description="Reload workspace"
                                ToolTipProperties.Text="Reload and check the workspace" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Column="2"
                                           Spacing="4">
                        <Button Text="&#xE8AB;"
                                AutomationId="DockToggleButton"
                                Style="{StaticResource PresenterIconButton}"
                                Command="{Binding ToggleDockCommand}"
                                SemanticProperties.Description="{Binding DockDescription}"
                                ToolTipProperties.Text="{Binding DockDescription}" />
                        <Button Text="&#xE713;"
                                AutomationId="SettingsButton"
                                Style="{StaticResource PresenterIconButton}"
                                Command="{Binding ShowSettingsCommand}"
                                SemanticProperties.Description="Settings"
                                ToolTipProperties.Text="Settings: the speeds, the app window and the theme">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding IsSettingsTabSelected}"
                                             Value="True">
                                    <Setter Property="BackgroundColor"
                                            Value="{AppThemeBinding Light={StaticResource PresenterSelectedLight}, Dark={StaticResource PresenterSelectedDark}}" />
                                    <Setter Property="BorderColor"
                                            Value="{AppThemeBinding Light={StaticResource PresenterAccentLight}, Dark={StaticResource PresenterAccentDark}}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </HorizontalStackLayout>
                </Grid>
            </toolkit:Expander.Header>

            <Border Padding="6"
                    Margin="0,8,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6" />
                </Border.StrokeShape>
                <CollectionView AutomationId="RecentFoldersList"
                                ItemsSource="{Binding RecentFolders}"
                                HeightRequest="160">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding DisplayText}"
                                    AutomationId="{Binding AutomationId}"
                                    Command="{Binding OpenCommand}"
                                    HorizontalOptions="Fill"
                                    SemanticProperties.Description="{Binding AutomationText}" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="No recent folders"
                               Style="{StaticResource PresenterMutedLabel}" />
                    </CollectionView.EmptyView>
                </CollectionView>
            </Border>
        </toolkit:Expander>


        <!--
            Session choices, not config: a configuration and a platform are things you switch
            while demoing. Platform sets APPIUM_PLATFORM, which the fixture reads before it
            resolves its own app binary; both persist per workspace.
        -->
        <Border Grid.Row="1"
                Padding="10"
                IsVisible="{Binding IsWorkspaceMode}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="6" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="6">
            <Label Text="Not built yet: Build it to check and run the steps."
                   AutomationId="NotBuiltLabel"
                   FontAttributes="Bold"
                   IsVisible="{Binding NeedsBuild}" />
            <HorizontalStackLayout Spacing="6"
                                   VerticalOptions="Center">
                <Picker AutomationId="BuildConfigurationPicker"
                        WidthRequest="96"
                        ItemsSource="{Binding BuildConfigurations}"
                        SelectedItem="{Binding BuildConfiguration, Mode=TwoWay}"
                        SemanticProperties.Description="Build configuration" />
                <Picker AutomationId="PlatformPicker"
                        WidthRequest="96"
                        ItemsSource="{Binding Platforms}"
                        SelectedItem="{Binding Platform, Mode=TwoWay}"
                        SemanticProperties.Description="Platform" />
                <Button Text="&#xE9F5;"
                        AutomationId="BuildButton"
                        Style="{StaticResource PresenterIconButton}"
                        Command="{Binding BuildCommand}"
                        SemanticProperties.Description="Build the workspace project"
                        ToolTipProperties.Text="Build the workspace project" />
            </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!--
            Icon tabs. The [Brackets] convention that used to mark the selected tab is gone:
            the DataTrigger fills the selected one instead, which is what lets five tabs plus
            the theme button fit on one row at quarter-screen width.
        -->
        <HorizontalStackLayout Grid.Row="2"
                               Spacing="4"
                               IsVisible="{Binding IsWorkspaceMode}">
            <Button Text="&#xF168;"
                    AutomationId="TreeTabButton"
                    Style="{StaticResource PresenterIconButton}"
                    Command="{Binding ShowTreeTabCommand}"
                    SemanticProperties.Description="Tree"
                    ToolTipProperties.Text="Tree">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding IsTreeTabSelected}"
                                 Value="True">
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource PresenterSelectedLight}, Dark={StaticResource PresenterSelectedDark}}" />
                        <Setter Property="BorderColor"
                                Value="{AppThemeBinding Light={StaticResource PresenterAccentLight}, Dark={StaticResource PresenterAccentDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Text="&#xE8A5;"
                    AutomationId="ConfigTabButton"
                    Style="{StaticResource PresenterIconButton}"
                    Command="{Binding ShowConfigTabCommand}"
                    SemanticProperties.Description="Config"
                    ToolTipProperties.Text="Config">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding IsConfigTabSelected}"
                                 Value="True">
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource PresenterSelectedLight}, Dark={StaticResource PresenterSelectedDark}}" />
                        <Setter Property="BorderColor"
                                Value="{AppThemeBinding Light={StaticResource PresenterAccentLight}, Dark={StaticResource PresenterAccentDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Text="&#xE9D9;"
                    AutomationId="DiagnosticsTabButton"
                    Style="{StaticResource PresenterIconButton}"
                    Command="{Binding ShowDiagnosticsTabCommand}"
                    SemanticProperties.Description="Diagnostics"
                    ToolTipProperties.Text="Diagnostics">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding IsDiagnosticsTabSelected}"
                                 Value="True">
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource PresenterSelectedLight}, Dark={StaticResource PresenterSelectedDark}}" />
                        <Setter Property="BorderColor"
                                Value="{AppThemeBinding Light={StaticResource PresenterAccentLight}, Dark={StaticResource PresenterAccentDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Text="&#xE721;"
                    AutomationId="DiscoveryTabButton"
                    Style="{StaticResource PresenterIconButton}"
                    Command="{Binding ShowDiscoveryTabCommand}"
                    SemanticProperties.Description="Discovery"
                    ToolTipProperties.Text="Discovery">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding IsDiscoveryTabSelected}"
                                 Value="True">
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource PresenterSelectedLight}, Dark={StaticResource PresenterSelectedDark}}" />
                        <Setter Property="BorderColor"
                                Value="{AppThemeBinding Light={StaticResource PresenterAccentLight}, Dark={StaticResource PresenterAccentDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Text="&#xE8FD;"
                    AutomationId="CommandCatalogTabButton"
                    Style="{StaticResource PresenterIconButton}"
                    Command="{Binding ShowCommandCatalogTabCommand}"
                    SemanticProperties.Description="Command Catalog"
                    ToolTipProperties.Text="Command Catalog">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding IsCommandCatalogTabSelected}"
                                 Value="True">
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource PresenterSelectedLight}, Dark={StaticResource PresenterSelectedDark}}" />
                        <Setter Property="BorderColor"
                                Value="{AppThemeBinding Light={StaticResource PresenterAccentLight}, Dark={StaticResource PresenterAccentDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </HorizontalStackLayout>

        <Grid Grid.Row="3"
              VerticalOptions="Fill">
            <!--
                Pick in a tree, step in a list. The two sections are expanders with a real
                Button in the header (a toolkit Expander's own header tap is not reachable from
                UI Automation); PresenterPage.xaml.cs gives a collapsed section's row no height.
            -->
            <Grid x:Name="TreeTab"
                  RowDefinitions="Auto,Auto,*,Auto,*,Auto,Auto,Auto"
                  RowSpacing="6"
                  IsVisible="{Binding IsTreeTabSelected}">
                <Label Grid.Row="0"
                       Text="{Binding WorkspaceSummaryText}"
                       FontSize="12"
                       Style="{StaticResource PresenterMutedLabel}"
                       AutomationId="WorkspaceSummaryLabel" />

                <Grid Grid.Row="1"
                      IsVisible="{Binding IsScenarioSectionVisible}">
                    <Button Text="Scenarios"
                            AutomationId="ScenariosExpander"
                            Command="{Binding ToggleScenariosCommand}"
                            HorizontalOptions="Fill" />
                    <Label Text="{Binding ScenariosExpanderGlyph}"
                           Style="{StaticResource PresenterGlyphLabel}"
                           FontSize="11"
                           HorizontalOptions="End"
                           VerticalOptions="Center"
                           Margin="0,0,12,0"
                           InputTransparent="True" />
                </Grid>

                <!-- Narrator mode: the script and what it has wrong take the Scenarios section's place. -->
                <VerticalStackLayout Grid.Row="1"
                                     Spacing="2"
                                     IsVisible="{Binding IsNarratorMode}">
                    <Label Text="{Binding Narrator.ScriptName}"
                           AutomationId="NarratorScriptLabel"
                           FontAttributes="Bold"
                           LineBreakMode="TailTruncation" />
                    <Label Text="{Binding Narrator.Summary}"
                           AutomationId="NarratorSummaryLabel"
                           FontSize="12"
                           Style="{StaticResource PresenterMutedLabel}" />
                    <Label Text="{Binding Narrator.ProblemsText}"
                           AutomationId="NarratorProblemsLabel"
                           IsVisible="{Binding Narrator.HasProblems}"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FF9B9B}" />
                </VerticalStackLayout>

                <Border Grid.Row="2"
                        Padding="8"
                        VerticalOptions="Fill"
                        IsVisible="{Binding IsNarratorMode}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <!-- The scenes, each with a checkbox (the ones to run and record), its lines and its steps. -->
                    <controls:TreeView AutomationId="NarratorTree"
                                       ItemsSource="{Binding Narrator.Roots}"
                                       ChildrenPath="Children"
                                       IsExpandedPath="IsExpanded"
                                       SelectedValue="{Binding Narrator.SelectedNode, Mode=TwoWay}"
                                       ShowExpandButton="False"
                                       IndentWidth="10"
                                       VerticalOptions="Fill">
                        <controls:TreeView.ItemTemplate>
                            <DataTemplate>
                                <!-- The checkbox column is as wide on a row without one, so a scene's
                                     rows line up under it. A Windows CheckBox asks for 120 px: the
                                     negative margin gives back what its empty label takes. -->
                                <Grid ColumnDefinitions="22,26,20,Auto,*"
                                      ColumnSpacing="4">
                                    <Button Grid.Column="0"
                                            Text="{Binding ExpansionGlyph}"
                                            AutomationId="{Binding ToggleAutomationId}"
                                            Style="{StaticResource PresenterRowGlyphButton}"
                                            Command="{Binding ToggleExpansionCommand}"
                                            IsEnabled="{Binding CanExpand}"
                                            SemanticProperties.Description="{Binding ExpansionDescription}" />
                                    <CheckBox Grid.Column="1"
                                              AutomationId="{Binding CheckAutomationId}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              IsEnabled="{Binding IsCheckEnabled}"
                                              IsVisible="{Binding HasCheckBox}"
                                              MinimumWidthRequest="26"
                                              WidthRequest="26"
                                              HorizontalOptions="Start"
                                              VerticalOptions="Center"
                                              SemanticProperties.Description="{Binding Name}" />
                                    <Label Grid.Column="2"
                                           Text="{Binding IconGlyph}"
                                           TextColor="{Binding IconColor}"
                                           Style="{StaticResource PresenterGlyphLabel}"
                                           FontSize="12"
                                           SemanticProperties.Description="{Binding StatusDescription}" />
                                    <!-- A recorded scene can be watched on its own, before any stitch. Before the
                                         text: a row is as wide as its text, so a column after it is cut off. -->
                                    <Button Grid.Column="3"
                                            Text="&#xE768;"
                                            AutomationId="{Binding WatchAutomationId}"
                                            Style="{StaticResource PresenterRowGlyphButton}"
                                            Command="{Binding WatchCommand}"
                                            IsVisible="{Binding CanWatch}"
                                            SemanticProperties.Description="Watch this scene's recording"
                                            ToolTipProperties.Text="Watch this scene's recording" />
                                    <VerticalStackLayout Grid.Column="4"
                                                         Spacing="0"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               ToolTipProperties.Text="{Binding Name}"
                                               AutomationId="{Binding AutomationId}"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Detail}"
                                               FontSize="11"
                                               LineBreakMode="TailTruncation"
                                               Style="{StaticResource PresenterMutedLabel}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Detail}" Value="">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding Note}"
                                               ToolTipProperties.Text="{Binding Note}"
                                               IsVisible="{Binding HasNote}"
                                               FontSize="11"
                                               FontAttributes="Italic"
                                               LineBreakMode="TailTruncation"
                                               Style="{StaticResource PresenterMutedLabel}" />
                                        <Label Text="{Binding Problem}"
                                               ToolTipProperties.Text="{Binding Problem}"
                                               IsVisible="{Binding HasProblem}"
                                               FontSize="11"
                                               LineBreakMode="WordWrap"
                                               TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FF9B9B}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </controls:TreeView.ItemTemplate>
                    </controls:TreeView>
                </Border>

                <Border Grid.Row="2"
                        Padding="8"
                        VerticalOptions="Fill"
                        IsVisible="{Binding IsScenarioTreeVisible}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <!--
                        The tree nests its own rows, so the row template carries no indent
                        BoxView: TreeViewNode draws the indent from its depth. ShowExpandButton
                        is False because the row keeps its own toggle Button - the node's built-in
                        chevron is a tap target, which UI Automation cannot invoke on Windows.
                    -->
                    <controls:TreeView AutomationId="WorkspaceTree"
                                       ItemsSource="{Binding WorkspaceRootNodes}"
                                       ChildrenPath="Children"
                                       IsExpandedPath="IsExpanded"
                                       SelectedValue="{Binding SelectedWorkspaceNode, Mode=TwoWay}"
                                       ShowExpandButton="False"
                                       IndentWidth="10"
                                       VerticalOptions="Fill">
                        <controls:TreeView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,0"
                                      ColumnDefinitions="22,20,*"
                                      ColumnSpacing="4">
                                    <!-- ExpansionGlyph and IconGlyph, never ExpansionText/Icon:
                                         those two stay ASCII for the hidden text mirrors.
                                         The description states expanded/collapsed because it is
                                         the only expansion state a UIA test can read here. -->
                                    <Button Grid.Column="0"
                                            Text="{Binding ExpansionGlyph}"
                                            AutomationId="{Binding ToggleAutomationId}"
                                            Style="{StaticResource PresenterRowGlyphButton}"
                                            Command="{Binding ToggleExpansionCommand}"
                                            IsEnabled="{Binding CanExpand}"
                                            SemanticProperties.Description="{Binding ExpansionDescription}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding IconGlyph}"
                                           TextColor="{Binding IconColor}"
                                           Style="{StaticResource PresenterGlyphLabel}"
                                           FontSize="12"
                                           SemanticProperties.Description="{Binding StatusDescription}" />
                                    <Label Grid.Column="2"
                                           Text="{Binding Name}"
                                           ToolTipProperties.Text="{Binding Name}"
                                           AutomationId="{Binding AutomationId}"
                                           LineBreakMode="TailTruncation"
                                           VerticalTextAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </controls:TreeView.ItemTemplate>
                    </controls:TreeView>
                </Border>

                <Grid Grid.Row="3"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="6">
                    <Button Grid.Column="0"
                            Text="{Binding StepsHeaderText}"
                            AutomationId="StepsExpander"
                            Padding="10,6,30,6"
                            Command="{Binding ToggleStepsCommand}"
                            LineBreakMode="TailTruncation"
                            ToolTipProperties.Text="{Binding StepsHeaderText}"
                            HorizontalOptions="Fill" />
                    <Label Grid.Column="0"
                           Text="{Binding StepsExpanderGlyph}"
                           Style="{StaticResource PresenterGlyphLabel}"
                           FontSize="11"
                           HorizontalOptions="End"
                           VerticalOptions="Center"
                           Margin="0,0,12,0"
                           InputTransparent="True" />
                    <Button Grid.Column="1"
                            Text="&#xE8A7;"
                            AutomationId="OpenPreviewButton"
                            Style="{StaticResource PresenterIconButton}"
                            Command="{Binding OpenPreviewCommand}"
                            SemanticProperties.Description="Open the Scenario Preview"
                            ToolTipProperties.Text="Open the Scenario Preview" />
                </Grid>

                <Border Grid.Row="4"
                        Padding="4"
                        VerticalOptions="Fill"
                        IsVisible="{Binding IsStepsExpanded}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <CollectionView x:Name="StepList"
                                    AutomationId="StepList"
                                    ItemsSource="{Binding StepRows}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="{Binding Indent}"
                                      ColumnDefinitions="14,24,*"
                                      MinimumHeightRequest="26">
                                    <FlyoutBase.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Run until here"
                                                            Command="{Binding RunUntilCommand}" />
                                            <MenuFlyoutItem Text="{Binding RunFromText}"
                                                            Command="{Binding RunFromCommand}" />
                                            <MenuFlyoutItem Text="Debug from here"
                                                            Command="{Binding DebugFromCommand}" />
                                            <MenuFlyoutItem Text="Toggle breakpoint"
                                                            Command="{Binding ToggleBreakpointCommand}" />
                                        </MenuFlyout>
                                    </FlyoutBase.ContextFlyout>
                                    <!-- A click on a step sets or clears its breakpoint, as a click in the IDEs' gutter does. -->
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleBreakpointCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Grid.Triggers>
                                        <DataTrigger TargetType="Grid"
                                                     Binding="{Binding IsCurrent}"
                                                     Value="True">
                                            <Setter Property="BackgroundColor"
                                                    Value="{AppThemeBinding Light={StaticResource PresenterSelectedLight}, Dark={StaticResource PresenterSelectedDark}}" />
                                        </DataTrigger>
                                    </Grid.Triggers>
                                    <Label Grid.Column="0"
                                           Text="{Binding BreakpointGlyph}"
                                           TextColor="#D13438"
                                           FontSize="11"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding StatusGlyph}"
                                           TextColor="{Binding StatusColor}"
                                           Style="{StaticResource PresenterGlyphLabel}"
                                           FontSize="12"
                                           SemanticProperties.Description="{Binding StatusDescription}" />
                                    <Label Grid.Column="2"
                                           Text="{Binding Label}"
                                           ToolTipProperties.Text="{Binding Tooltip}"
                                           AutomationId="{Binding AutomationId}"
                                           LineBreakMode="TailTruncation"
                                           VerticalTextAlignment="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding IsCall}"
                                                         Value="True">
                                                <Setter Property="FontAttributes" Value="Bold" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="Pick a scenario"
                                   Style="{StaticResource PresenterMutedLabel}" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                </Border>

                <!-- The moves, below the steps they move through: the same as the IDEs' stepping,
                     on keys a presentation clicker sends too. Speed cycles Fast, Normal, Slow. -->
                <!-- Wraps on a narrow bar: Record and Watch go to a second line rather than off the edge. -->
                <FlexLayout Grid.Row="5"
                            Wrap="Wrap"
                            AlignItems="Center">
                    <Button Text="&#xE768;"
                            AutomationId="RunButton"
                            Style="{StaticResource PresenterIconButton}"
                            Margin="0,0,6,6"
                            Command="{Binding RunCommand}"
                            SemanticProperties.Description="Run"
                            ToolTipProperties.Text="Run, or go on from a pause, to a breakpoint or the end (F5)" />
                    <Button Text="&#xE893;"
                            AutomationId="NextButton"
                            Style="{StaticResource PresenterIconButton}"
                            Margin="0,0,6,6"
                            Command="{Binding NextStepCommand}"
                            SemanticProperties.Description="Next step"
                            ToolTipProperties.Text="Step: run the highlighted step, or start paused before the first (Space, Right, Page Down)" />
                    <Button Text="&#xE74B;"
                            AutomationId="StepIntoButton"
                            Style="{StaticResource PresenterIconButton}"
                            Margin="0,0,6,6"
                            Command="{Binding StepIntoCommand}"
                            SemanticProperties.Description="Step into"
                            ToolTipProperties.Text="Step into the call, running nothing (Down)" />
                    <Button Text="&#xE74A;"
                            AutomationId="StepOutButton"
                            Style="{StaticResource PresenterIconButton}"
                            Margin="0,0,6,6"
                            Command="{Binding StepOutCommand}"
                            SemanticProperties.Description="Step out"
                            ToolTipProperties.Text="Step out: run the rest of the call (Up)" />
                    <Button Text="&#xE71A;"
                            AutomationId="StopButton"
                            Style="{StaticResource PresenterIconButton}"
                            Margin="0,0,6,6"
                            Command="{Binding StopCommand}"
                            SemanticProperties.Description="Stop"
                            ToolTipProperties.Text="Stop (Esc)" />
                    <Button Text="&#xE777;"
                            AutomationId="RestartButton"
                            Style="{StaticResource PresenterIconButton}"
                            Margin="0,0,6,6"
                            Command="{Binding RestartCommand}"
                            SemanticProperties.Description="Restart"
                            ToolTipProperties.Text="Restart the scenario, paused before its first step (Ctrl+R)" />
                    <Button Text="{Binding SpeedGlyph}"
                            AutomationId="SpeedButton"
                            Style="{StaticResource PresenterIconButton}"
                            Margin="0,0,6,6"
                            Command="{Binding CycleSpeedCommand}"
                            SemanticProperties.Description="{Binding SpeedDescription}"
                            ToolTipProperties.Text="{Binding SpeedDescription}" />
                    <!-- Record: the next runs are recorded on video; the glyph turns red while it is on. -->
                    <Button Text="&#xE7C8;"
                            AutomationId="RecordButton"
                            Style="{StaticResource PresenterIconButton}"
                            Margin="0,0,6,6"
                            Command="{Binding RecordCommand}"
                            SemanticProperties.Description="{Binding RecordDescription}"
                            ToolTipProperties.Text="{Binding RecordDescription}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsRecording}" Value="True">
                                <Setter Property="TextColor" Value="#D13438" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="&#xE8B2;"
                            AutomationId="WatchRecordingButton"
                            Style="{StaticResource PresenterIconButton}"
                            Margin="0,0,6,6"
                            Command="{Binding WatchRecordingCommand}"
                            IsVisible="{Binding HasRecording}"
                            SemanticProperties.Description="Watch the last recording"
                            ToolTipProperties.Text="Watch the last recording" />
                    <!-- Narrator mode: join the latest recording of every scene; open where they are. -->
                    <Button Text="&#xE71B;"
                            AutomationId="StitchButton"
                            Style="{StaticResource PresenterIconButton}"
                            Margin="0,0,6,6"
                            Command="{Binding StitchCommand}"
                            IsVisible="{Binding IsNarratorMode}"
                            SemanticProperties.Description="Stitch the scenes into the video"
                            ToolTipProperties.Text="Stitch: join the latest recording of every scene into the video" />
                    <Button Text="&#xE838;"
                            AutomationId="OpenRecordingsButton"
                            Style="{StaticResource PresenterIconButton}"
                            Margin="0,0,6,6"
                            Command="{Binding OpenRecordingsFolderCommand}"
                            IsVisible="{Binding IsNarratorMode}"
                            SemanticProperties.Description="Open the Recordings folder"
                            ToolTipProperties.Text="Open the Recordings folder" />
                </FlexLayout>
                <VerticalStackLayout Grid.Row="6"
                                     Spacing="2">
                    <Label Text="{Binding StatusSummary}"
                           FontAttributes="Bold"
                           AutomationId="StatusSummaryLabel" />
                    <Label Text="{Binding RecordingStatus}"
                           AutomationId="RecordingStatusLabel"
                           FontSize="11"
                           Style="{StaticResource PresenterMutedLabel}" />
                </VerticalStackLayout>

                <toolkit:Expander Grid.Row="7"
                                  IsVisible="{Binding IsWorkspaceMode}"
                                  IsExpanded="{Binding IsSelectionExpanded, Mode=TwoWay}">
                    <toolkit:Expander.Header>
                        <!-- The caption is a plain label again; the chevron is a separate
                             glyph label laid over the button's right edge, InputTransparent
                             so the whole button stays one click target. -->
                        <Grid>
                            <Button Text="{Binding SelectionExpanderText}"
                                    AutomationId="SelectionExpander"
                                    Command="{Binding ToggleSelectionCommand}"
                                    HorizontalOptions="Fill" />
                            <Label Text="{Binding SelectionExpanderGlyph}"
                                   Style="{StaticResource PresenterGlyphLabel}"
                                   FontSize="11"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"
                                   Margin="0,0,12,0"
                                   InputTransparent="True" />
                        </Grid>
                    </toolkit:Expander.Header>
                    <Border Padding="10"
                            Margin="0,8,0,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding SelectedWorkspaceNodeDetailsText}"
                                   AutomationId="SelectionDetailsText"
                                   FontSize="11"
                                   Style="{StaticResource PresenterMutedLabel}" />
                        </VerticalStackLayout>
                    </Border>
                </toolkit:Expander>
            </Grid>

            <!-- Settings: in either mode, from the gear at the top right; the same button closes it. -->
            <Border Padding="10"
                    IsVisible="{Binding IsSettingsTabSelected}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6" />
                </Border.StrokeShape>
                <ScrollView>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Settings"
                               FontAttributes="Bold"
                               FontSize="15" />

                        <Label Text="Speeds: the pause between steps, in milliseconds" />
                        <Grid ColumnDefinitions="28,70,80,Auto"
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="6"
                              RowSpacing="6">
                            <Label Grid.Row="0" Grid.Column="0" Text="&#xEC4A;" Style="{StaticResource PresenterGlyphLabel}" />
                            <Label Grid.Row="0" Grid.Column="1" Text="Fast" VerticalTextAlignment="Center" />
                            <Entry Grid.Row="0" Grid.Column="2"
                                   AutomationId="FastMillisecondsInput"
                                   Keyboard="Numeric"
                                   MaxLength="5"
                                   Text="{Binding FastMillisecondsText}" />
                            <Label Grid.Row="0" Grid.Column="3" Text="ms" VerticalTextAlignment="Center" />
                            <Label Grid.Row="1" Grid.Column="0" Text="&#xEC49;" Style="{StaticResource PresenterGlyphLabel}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="Normal" VerticalTextAlignment="Center" />
                            <Entry Grid.Row="1" Grid.Column="2"
                                   AutomationId="NormalMillisecondsInput"
                                   Keyboard="Numeric"
                                   MaxLength="5"
                                   Text="{Binding NormalMillisecondsText}" />
                            <Label Grid.Row="1" Grid.Column="3" Text="ms" VerticalTextAlignment="Center" />
                            <Label Grid.Row="2" Grid.Column="0" Text="&#xEC48;" Style="{StaticResource PresenterGlyphLabel}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="Slow" VerticalTextAlignment="Center" />
                            <Entry Grid.Row="2" Grid.Column="2"
                                   AutomationId="SlowMillisecondsInput"
                                   Keyboard="Numeric"
                                   MaxLength="5"
                                   Text="{Binding SlowMillisecondsText}" />
                            <Label Grid.Row="2" Grid.Column="3" Text="ms" VerticalTextAlignment="Center" />
                        </Grid>
                        <Label Text="{Binding SpeedDescription}"
                               FontSize="11"
                               Style="{StaticResource PresenterMutedLabel}" />

                        <Label Text="App window: how the app under test shows during a run" />
                        <Picker AutomationId="AppWindowPicker"
                                ItemsSource="{Binding AppWindowChoices}"
                                SelectedItem="{Binding AppWindowChoice, Mode=TwoWay}"
                                SemanticProperties.Description="App window" />

                        <Label Text="When a run ends" />
                        <Picker AutomationId="RunEndPicker"
                                ItemsSource="{Binding RunEndChoices}"
                                SelectedItem="{Binding RunEndChoice, Mode=TwoWay}"
                                SemanticProperties.Description="When a run ends" />
                        <Label Text="Keep it open: the app stays until the next run, Stop, or closing Presenter."
                               FontSize="11"
                               Style="{StaticResource PresenterMutedLabel}" />
                        <!-- The narrator: what a recording and a rehearsal use, in Present mode and in Narrator mode. -->
                        <Label Text="Narrator" FontAttributes="Bold" AutomationId="NarratorSettingsLabel" />
                        <Label Text="Recordings folder (empty: the suite's TestResults\recordings)" />
                        <Entry AutomationId="RecordingsFolderInput"
                               Text="{Binding RecordingsFolderText}"
                               Placeholder="TestResults\recordings" />
                        <Label Text="Voice, when the video script names none" />
                        <Picker AutomationId="VoicePicker"
                                ItemsSource="{Binding VoiceChoices}"
                                SelectedItem="{Binding VoiceChoice, Mode=TwoWay}"
                                SemanticProperties.Description="Voice" />
                        <HorizontalStackLayout Spacing="6">
                            <Button Text="Try"
                                    AutomationId="TryVoiceButton"
                                    Command="{Binding TryVoiceCommand}"
                                    SemanticProperties.Description="Try the voice"
                                    ToolTipProperties.Text="Speak a sample line in this voice" />
                            <Label Text="{Binding VoiceStatus}"
                                   AutomationId="VoiceStatusLabel"
                                   FontSize="11"
                                   VerticalTextAlignment="Center"
                                   Style="{StaticResource PresenterMutedLabel}" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding ScriptVoiceNote}"
                               AutomationId="ScriptVoiceNoteLabel"
                               IsVisible="{Binding HasScriptVoiceNote}"
                               FontSize="11"
                               Style="{StaticResource PresenterMutedLabel}" />
                        <Label Text="Another voice or beat is another recording: the recorded scenes become out of date."
                               FontSize="11"
                               Style="{StaticResource PresenterMutedLabel}" />
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="Beat after a step" VerticalTextAlignment="Center" />
                            <Entry AutomationId="BeatInput"
                                   Keyboard="Numeric"
                                   MaxLength="5"
                                   WidthRequest="80"
                                   Text="{Binding BeatText}" />
                            <Label Text="ms" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="Speak aloud while recording, and in a rehearsal" VerticalTextAlignment="Center" />
                            <CheckBox AutomationId="SpeakAloudCheckBox"
                                      IsChecked="{Binding SpeakAloud}" />
                        </HorizontalStackLayout>

                        <!-- The cloud voice: the narrator's voice.secrets.json, read by every recording on this machine. The key is typed, never shown. -->
                        <Label Text="Cloud voice (Azure OpenAI)" FontAttributes="Bold" AutomationId="CloudVoiceSettingsLabel" />
                        <Label Text="{Binding CloudVoiceState}"
                               AutomationId="CloudVoiceStateLabel"
                               FontSize="11"
                               Style="{StaticResource PresenterMutedLabel}" />
                        <Label Text="Endpoint" />
                        <Entry AutomationId="CloudEndpointInput"
                               Text="{Binding CloudEndpointText}"
                               Placeholder="https://&lt;resource&gt;.openai.azure.com" />
                        <Label Text="Key" />
                        <!-- SetText: a password box keeps UI Automation's writes from MAUI, so tests set the key through the bridge. -->
                        <Entry AutomationId="CloudKeyInput"
                               IsPassword="True"
                               uia:GestureAutomation.Verbs="GetText,SetText,ClearText"
                               Text="{Binding CloudKeyText}"
                               Placeholder="{Binding CloudKeyPlaceholder}"
                               SemanticProperties.Description="The cloud voice's key" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                            <Label Grid.Row="0" Grid.Column="0" Text="Deployment" VerticalTextAlignment="Center" />
                            <Entry Grid.Row="0" Grid.Column="1"
                                   AutomationId="CloudDeploymentInput"
                                   Text="{Binding CloudDeploymentText}"
                                   Placeholder="gpt-4o-mini-tts" />
                            <Label Grid.Row="1" Grid.Column="0" Text="API version" VerticalTextAlignment="Center" />
                            <Entry Grid.Row="1" Grid.Column="1"
                                   AutomationId="CloudApiVersionInput"
                                   Text="{Binding CloudApiVersionText}"
                                   Placeholder="2025-03-01-preview" />
                            <Label Grid.Row="2" Grid.Column="0" Text="Default voice" VerticalTextAlignment="Center" />
                            <Picker Grid.Row="2" Grid.Column="1"
                                    AutomationId="CloudDefaultVoicePicker"
                                    ItemsSource="{Binding CloudVoiceChoices}"
                                    SelectedItem="{Binding CloudDefaultVoice, Mode=TwoWay}"
                                    SemanticProperties.Description="The cloud voice when a script names none" />
                        </Grid>
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="Save beside this workspace instead of for this machine" VerticalTextAlignment="Center" />
                            <CheckBox AutomationId="CloudSaveForWorkspaceCheckBox"
                                      IsEnabled="{Binding CanSaveCloudForWorkspace}"
                                      IsChecked="{Binding CloudSaveForWorkspace}" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding CloudWorkspaceNote}"
                               AutomationId="CloudWorkspaceNoteLabel"
                               FontSize="11"
                               Style="{StaticResource PresenterMutedLabel}" />
                        <Button Text="Add the line to .gitignore"
                                AutomationId="AddCloudIgnoreRuleButton"
                                Command="{Binding AddCloudIgnoreRuleCommand}"
                                IsVisible="{Binding CanAddCloudIgnoreRule}"
                                HorizontalOptions="Start" />
                        <Label Text="{Binding CloudSavePath, StringFormat='Saves to {0}'}"
                               AutomationId="CloudSavePathLabel"
                               FontSize="11"
                               Style="{StaticResource PresenterMutedLabel}" />
                        <HorizontalStackLayout Spacing="6">
                            <Button Text="Try"
                                    AutomationId="TryCloudVoiceButton"
                                    Command="{Binding TryCloudVoiceCommand}"
                                    ToolTipProperties.Text="Speak a sample line with these settings, before saving them" />
                            <Button Text="Save"
                                    AutomationId="SaveCloudVoiceButton"
                                    Command="{Binding SaveCloudVoiceCommand}" />
                            <Button Text="{Binding RemoveCloudVoiceText}"
                                    AutomationId="RemoveCloudVoiceButton"
                                    Command="{Binding RemoveCloudVoiceCommand}" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding CloudVoiceStatus}"
                               AutomationId="CloudVoiceStatusLabel"
                               FontSize="11"
                               Style="{StaticResource PresenterMutedLabel}" />

                        <Label Text="Theme" />
                        <HorizontalStackLayout Spacing="6">
                            <Button Text="{Binding ThemeGlyph}"
                                    AutomationId="ThemeToggleButton"
                                    Style="{StaticResource PresenterIconButton}"
                                    Command="{Binding ToggleThemeCommand}"
                                    SemanticProperties.Description="{Binding ThemeDescription}"
                                    ToolTipProperties.Text="{Binding ThemeDescription}" />
                            <Label Text="{Binding ThemeDescription}"
                                   VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>

                        <Button Text="Done"
                                AutomationId="SettingsDoneButton"
                                Command="{Binding ShowSettingsCommand}"
                                HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
            <!--
                The config editor. Two editable rows - the project and the fixture - and a
                read-only panel for everything derived from them, each line saying how it was
                resolved. WorkspaceConfigText stays as the text mirror the UAT suite asserts on.
            -->
            <Border Padding="10"
                    IsVisible="{Binding IsConfigTabSelected}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6" />
                </Border.StrokeShape>
                <ScrollView>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding ConfigEditor.StateText}"
                               AutomationId="ConfigStateLabel"
                               FontAttributes="Bold" />

                        <Label Text="Project" />
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="4">
                            <Entry Grid.Column="0"
                                   AutomationId="ConfigProjectInput"
                                   Text="{Binding ConfigEditor.ProjectText, Mode=TwoWay}" />
                            <Button Grid.Column="1"
                                    Text="&#xE838;"
                                    AutomationId="ConfigProjectBrowseButton"
                                    Style="{StaticResource PresenterIconButton}"
                                    Command="{Binding ConfigEditor.BrowseProjectCommand}"
                                    SemanticProperties.Description="Browse for a project"
                                    ToolTipProperties.Text="Browse for a project" />
                        </Grid>
                        <Label Text="{Binding ConfigEditor.ProjectProblem}"
                               AutomationId="ConfigDiagnosticRuntimeProject"
                               FontSize="11"
                               Style="{StaticResource PresenterMutedLabel}" />

                        <Label Text="Fixture" />
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="4">
                            <Entry Grid.Column="0"
                                   AutomationId="ConfigFixtureInput"
                                   Text="{Binding ConfigEditor.FixtureText, Mode=TwoWay}" />
                            <Button Grid.Column="1"
                                    Text="&#xE72C;"
                                    AutomationId="ConfigFixtureRescanButton"
                                    Style="{StaticResource PresenterIconButton}"
                                    Command="{Binding ConfigEditor.RescanFixturesCommand}"
                                    SemanticProperties.Description="Rescan fixtures"
                                    ToolTipProperties.Text="Rescan fixtures" />
                        </Grid>
                        <Label Text="{Binding ConfigEditor.FixtureProblem}"
                               AutomationId="ConfigDiagnosticRuntimeFixture"
                               FontSize="11"
                               Style="{StaticResource PresenterMutedLabel}" />
                        <CollectionView AutomationId="ConfigFixtureCandidateList"
                                        ItemsSource="{Binding ConfigEditor.FixtureCandidates}"
                                        HeightRequest="90">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}"
                                           FontSize="11" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="No fixtures found - build the project"
                                       Style="{StaticResource PresenterMutedLabel}" />
                            </CollectionView.EmptyView>
                        </CollectionView>

                        <Label Text="Derived"
                               FontAttributes="Bold" />
                        <Label Text="{Binding ConfigEditor.DerivedTarget}"
                               AutomationId="ConfigDerivedTarget"
                               FontSize="11"
                               Style="{StaticResource PresenterMutedLabel}" />
                        <Label Text="{Binding ConfigEditor.DerivedPages}"
                               AutomationId="ConfigDerivedPages"
                               FontSize="11"
                               Style="{StaticResource PresenterMutedLabel}" />
                        <Label Text="{Binding ConfigEditor.DerivedApp}"
                               AutomationId="ConfigDerivedApp"
                               FontSize="11"
                               Style="{StaticResource PresenterMutedLabel}" />

                        <HorizontalStackLayout Spacing="6">
                            <Button Text="Save"
                                    AutomationId="ConfigSaveButton"
                                    Command="{Binding ConfigEditor.SaveCommand}" />
                            <Button Text="Revert"
                                    AutomationId="ConfigRevertButton"
                                    Command="{Binding ConfigEditor.RevertCommand}" />
                            <Button Text="Create"
                                    AutomationId="ConfigCreateButton"
                                    IsVisible="{Binding ConfigEditor.CanCreate}"
                                    Command="{Binding ConfigEditor.CreateCommand}" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding ConfigEditor.SaveMessage}"
                               AutomationId="ConfigSaveMessage"
                               FontSize="11"
                               Style="{StaticResource PresenterMutedLabel}" />

                        <Label Text="{Binding WorkspaceConfigText}"
                               AutomationId="WorkspaceConfigText"
                               FontSize="11"
                               Style="{StaticResource PresenterMirrorLabel}" />
                    </VerticalStackLayout>
                </ScrollView>
            </Border>

            <Border Padding="10"
                    IsVisible="{Binding IsDiagnosticsTabSelected}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6" />
                </Border.StrokeShape>
                <ScrollView>
                    <Label Text="{Binding DiagnosticsText}"
                           AutomationId="DiagnosticsText"
                           FontSize="11"
                           Style="{StaticResource PresenterMutedLabel}" />
                </ScrollView>
            </Border>

            <Border Padding="10"
                    IsVisible="{Binding IsDiscoveryTabSelected}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6" />
                </Border.StrokeShape>
                <ScrollView>
                    <Label Text="{Binding DiscoveryText}"
                           AutomationId="DiscoveryText"
                           FontSize="11"
                           Style="{StaticResource PresenterMutedLabel}" />
                </ScrollView>
            </Border>

            <Border Padding="10"
                    IsVisible="{Binding IsCommandCatalogTabSelected}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6" />
                </Border.StrokeShape>
                <ScrollView>
                    <Label Text="{Binding CommandCatalogText}"
                           AutomationId="CommandCatalogText"
                           FontSize="11"
                           Style="{StaticResource PresenterMutedLabel}" />
                </ScrollView>
            </Border>
        </Grid>

        <!--
            The hidden text mirrors the UAT suite asserts against (K2): laid over the content row,
            1 px each and transparent to input, so they take no room from the layout and stay in
            the automation tree whichever tab or mode is showing.
        -->
        <VerticalStackLayout Grid.Row="3"
                             VerticalOptions="Start"
                             InputTransparent="True"
                             Spacing="0">
            <Label Text="{Binding WorkspaceTreeText}"
                   AutomationId="WorkspaceTreeText"
                   Style="{StaticResource PresenterMirrorLabel}" />
            <Label Text="{Binding AllWorkspaceTreeText}"
                   AutomationId="AllWorkspaceTreeText"
                   Style="{StaticResource PresenterMirrorLabel}" />
            <Label Text="{Binding StepListText}"
                   AutomationId="StepListText"
                   Style="{StaticResource PresenterMirrorLabel}" />
            <Label Text="{Binding ExecutionTimingText}"
                   AutomationId="ExecutionTimingText"
                   Style="{StaticResource PresenterMirrorLabel}" />
            <Label Text="{Binding RunScopeText}"
                   AutomationId="RunScopeText"
                   Style="{StaticResource PresenterMirrorLabel}" />
            <Label Text="{Binding RecentFoldersText}"
                   AutomationId="RecentFoldersText"
                   Style="{StaticResource PresenterMirrorLabel}" />
            <Label Text="{Binding AutPlacementText}"
                   AutomationId="AutPlacementText"
                   Style="{StaticResource PresenterMirrorLabel}" />
            <Label Text="{Binding Narrator.TreeText}"
                   AutomationId="NarratorTreeText"
                   Style="{StaticResource PresenterMirrorLabel}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
