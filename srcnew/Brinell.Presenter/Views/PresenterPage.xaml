<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Brinell.Presenter.Views.PresenterPage"
             Title="Brinell Presenter"
             BackgroundColor="{StaticResource PresenterBackground}">

    <Grid AutomationId="PresenterRoot"
          Padding="12"
          RowDefinitions="Auto,Auto,Auto,Auto,*"
          RowSpacing="8"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">
        <HorizontalStackLayout Grid.Row="0"
                               Spacing="6">
            <Button Text="Open"
                    AutomationId="OpenFolderButton"
                    Command="{Binding OpenFolderCommand}" />
            <Button Text="{Binding RecentFoldersButtonText}"
                    AutomationId="OpenRecentButton"
                    WidthRequest="38"
                    Command="{Binding ToggleRecentFoldersCommand}" />
            <Button Text="Reload"
                    AutomationId="ReloadButton"
                    Command="{Binding ReloadCommand}" />
            <Button Text="Validate"
                    AutomationId="ValidateButton"
                    Command="{Binding ValidateCommand}" />
        </HorizontalStackLayout>

        <Border Grid.Row="1"
                Stroke="{StaticResource PresenterBorder}"
                StrokeThickness="1"
                BackgroundColor="{StaticResource PresenterPanel}"
                Padding="6"
                IsVisible="{Binding IsRecentFoldersExpanded}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="6" />
            </Border.StrokeShape>
            <CollectionView AutomationId="RecentFoldersList"
                            ItemsSource="{Binding RecentFolders}"
                            HeightRequest="160">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Button Text="{Binding DisplayText}"
                                AutomationId="{Binding AutomationId}"
                                Command="{Binding OpenCommand}"
                                HorizontalOptions="Fill"
                                SemanticProperties.Description="{Binding AutomationText}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No recent folders"
                           TextColor="{StaticResource PresenterMuted}" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Border>

        <Border Grid.Row="2"
                Stroke="{StaticResource PresenterBorder}"
                StrokeThickness="1"
                BackgroundColor="{StaticResource PresenterPanel}"
                Padding="10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="6" />
            </Border.StrokeShape>
            <HorizontalStackLayout Spacing="6"
                                   VerticalOptions="Center">
                <Button Text="Run"
                        AutomationId="RunButton"
                        Command="{Binding RunCommand}" />
                <Button Text="Stop"
                        AutomationId="StopButton"
                        Command="{Binding StopCommand}" />
                <Button Text="Next"
                        AutomationId="NextButton"
                        Command="{Binding NextStepCommand}" />
                <Label Text="Delay"
                       Margin="10,0,0,0"
                       VerticalTextAlignment="Center" />
                <Entry AutomationId="DelayMillisecondsInput"
                       Keyboard="Numeric"
                       MaxLength="5"
                       WidthRequest="58"
                       Text="{Binding ExecutionDelayText}" />
                <Label Text="ms"
                       AutomationId="DelayMillisecondsLabel"
                       VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
        </Border>

        <HorizontalStackLayout Grid.Row="3"
                               Spacing="4">
            <Button Text="{Binding TreeTabText}"
                    AutomationId="TreeTabButton"
                    Command="{Binding ShowTreeTabCommand}" />
            <Button Text="{Binding ConfigTabText}"
                    AutomationId="ConfigTabButton"
                    Command="{Binding ShowConfigTabCommand}" />
            <Button Text="{Binding DiagnosticsTabText}"
                    AutomationId="DiagnosticsTabButton"
                    Command="{Binding ShowDiagnosticsTabCommand}" />
            <Button Text="{Binding DiscoveryTabText}"
                    AutomationId="DiscoveryTabButton"
                    Command="{Binding ShowDiscoveryTabCommand}" />
            <Button Text="{Binding CommandCatalogTabText}"
                    AutomationId="CommandCatalogTabButton"
                    Command="{Binding ShowCommandCatalogTabCommand}" />
        </HorizontalStackLayout>

        <Grid Grid.Row="4"
              VerticalOptions="Fill">
            <Grid RowDefinitions="Auto,*,Auto,Auto,Auto"
                  RowSpacing="8"
                  IsVisible="{Binding IsTreeTabSelected}">
                <VerticalStackLayout Grid.Row="0"
                                     Spacing="2">
                    <Label Text="{Binding WorkspaceSummaryText}"
                           FontSize="12"
                           TextColor="{StaticResource PresenterMuted}"
                           AutomationId="WorkspaceSummaryLabel" />
                </VerticalStackLayout>

                <Border Grid.Row="1"
                        Stroke="{StaticResource PresenterBorder}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource PresenterPanel}"
                        Padding="8"
                        VerticalOptions="Fill">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <CollectionView AutomationId="WorkspaceTree"
                                    ItemsSource="{Binding WorkspaceTreeNodes}"
                                    SelectedItem="{Binding SelectedWorkspaceNode, Mode=TwoWay}"
                                    SelectionMode="Single"
                                    VerticalOptions="Fill">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,4"
                                      ColumnDefinitions="Auto,28,42,*"
                                      AutomationId="{Binding AutomationId}">
                                    <BoxView WidthRequest="{Binding IndentWidth}"
                                             Color="Transparent" />
                                    <Button Grid.Column="1"
                                            Text="{Binding ExpansionText}"
                                            AutomationId="{Binding ToggleAutomationId}"
                                            Command="{Binding ToggleExpansionCommand}"
                                            IsEnabled="{Binding CanExpand}"
                                            WidthRequest="26"
                                            HeightRequest="26"
                                            Padding="0" />
                                    <Label Grid.Column="2"
                                           Text="{Binding Icon}"
                                           TextColor="{Binding IconColor}"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           SemanticProperties.Description="{Binding StatusDescription}" />
                                    <Label Grid.Column="3"
                                           Text="{Binding Name}"
                                           LineBreakMode="TailTruncation"
                                           VerticalTextAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>

                <VerticalStackLayout Grid.Row="2"
                                     Spacing="2">
                    <Label Text="{Binding StatusSummary}"
                           FontAttributes="Bold"
                           AutomationId="StatusSummaryLabel" />
                    <Label Text="{Binding WorkspaceTreeText}"
                           AutomationId="WorkspaceTreeText"
                           FontSize="1"
                           HeightRequest="1"
                           Opacity="0.01" />
                    <Label Text="{Binding AllWorkspaceTreeText}"
                           AutomationId="AllWorkspaceTreeText"
                           FontSize="1"
                           HeightRequest="1"
                           Opacity="0.01" />
                    <Label Text="{Binding StepListText}"
                           AutomationId="StepListText"
                           FontSize="1"
                           HeightRequest="1"
                           Opacity="0.01" />
                    <Label Text="{Binding ExecutionTimingText}"
                           AutomationId="ExecutionTimingText"
                           FontSize="1"
                           HeightRequest="1"
                           Opacity="0.01" />
                    <Label Text="{Binding RunScopeText}"
                           AutomationId="RunScopeText"
                           FontSize="1"
                           HeightRequest="1"
                           Opacity="0.01" />
                    <Label Text="{Binding RecentFoldersText}"
                           AutomationId="RecentFoldersText"
                           FontSize="1"
                           HeightRequest="1"
                           Opacity="0.01" />
                    <Label Text="{Binding AutPlacementText}"
                           AutomationId="AutPlacementText"
                           FontSize="1"
                           HeightRequest="1"
                           Opacity="0.01" />
                </VerticalStackLayout>

                <Button Grid.Row="3"
                        Text="{Binding SelectionExpanderText}"
                        AutomationId="SelectionExpander"
                        Command="{Binding ToggleSelectionCommand}" />
                <Border Grid.Row="4"
                        Stroke="{StaticResource PresenterBorder}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource PresenterPanel}"
                        Padding="10"
                        IsVisible="{Binding IsSelectionExpanded}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding SelectedWorkspaceNodeDetailsText}"
                               AutomationId="SelectionDetailsText"
                               FontSize="11"
                               TextColor="{StaticResource PresenterMuted}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Stroke="{StaticResource PresenterBorder}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource PresenterPanel}"
                    Padding="10"
                    IsVisible="{Binding IsConfigTabSelected}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6" />
                </Border.StrokeShape>
                <ScrollView>
                    <Label Text="{Binding WorkspaceConfigText}"
                           AutomationId="WorkspaceConfigText"
                           FontSize="11"
                           TextColor="{StaticResource PresenterMuted}" />
                </ScrollView>
            </Border>

            <Border Stroke="{StaticResource PresenterBorder}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource PresenterPanel}"
                    Padding="10"
                    IsVisible="{Binding IsDiagnosticsTabSelected}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6" />
                </Border.StrokeShape>
                <ScrollView>
                    <Label Text="{Binding DiagnosticsText}"
                           AutomationId="DiagnosticsText"
                           FontSize="11"
                           TextColor="{StaticResource PresenterMuted}" />
                </ScrollView>
            </Border>

            <Border Stroke="{StaticResource PresenterBorder}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource PresenterPanel}"
                    Padding="10"
                    IsVisible="{Binding IsDiscoveryTabSelected}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6" />
                </Border.StrokeShape>
                <ScrollView>
                    <Label Text="{Binding DiscoveryText}"
                           AutomationId="DiscoveryText"
                           FontSize="11"
                           TextColor="{StaticResource PresenterMuted}" />
                </ScrollView>
            </Border>

            <Border Stroke="{StaticResource PresenterBorder}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource PresenterPanel}"
                    Padding="10"
                    IsVisible="{Binding IsCommandCatalogTabSelected}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6" />
                </Border.StrokeShape>
                <ScrollView>
                    <Label Text="{Binding CommandCatalogText}"
                           AutomationId="CommandCatalogText"
                           FontSize="11"
                           TextColor="{StaticResource PresenterMuted}" />
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
