<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Emit XML doc files so kept summaries reach IntelliSense/help. CS1591 (missing
         doc on a public member) is suppressed until the public surface has its summaries.
         CS1710 (duplicate typeparam) is suppressed because Bruinell.Generator copies the
         class-level doc onto the generated .gen.cs partial of every generic control, so both
         partials legitimately carry the same <typeparam>; the doc is authored once in .tpl.cs. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1710</NoWarn>
    
    <!-- Versioning -->
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    
    <!-- Package metadata -->
    <Authors>Bruinell Contributors</Authors>
    <Company>Bruinell</Company>
    <Product>Bruinell UI Test Framework</Product>
    <Copyright>Copyright © 2024-$([System.DateTime]::Now.Year) Bruinell Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/exact-mobile-apps/test-tooling</PackageProjectUrl>
    <RepositoryUrl>https://github.com/exact-mobile-apps/test-tooling</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ui-testing;automation;wpf;maui;blazor;playwright;testing;page-object</PackageTags>
    
    <!-- Source Link -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    
    <!-- Deterministic builds -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>
