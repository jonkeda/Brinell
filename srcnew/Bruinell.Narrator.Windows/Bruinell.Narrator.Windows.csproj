<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Bruinell.Narrator.Windows</RootNamespace>
    <Description>What a narrated recording needs on Windows, both from the Windows 10 SDK: the window recorder (Windows.Graphics.Capture, which records a window while it is covered) and Windows' own voices (Windows.Media.SpeechSynthesis), offline.</Description>
    <PackageId>Bruinell.Narrator.Windows</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- Its output is a folder a net10.0 run can load it from (BRUINELL_RECORDERS): with the Windows SDK's projections. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinell.Narrator\Bruinell.Narrator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bruinell.Recording.Tests" />
  </ItemGroup>

</Project>
