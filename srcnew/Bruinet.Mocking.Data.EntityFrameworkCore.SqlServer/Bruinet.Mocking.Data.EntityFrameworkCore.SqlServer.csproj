    <RootNamespace>Bruinet.Mocking.Data.EntityFrameworkCore.SqlServer</RootNamespace>
    <Description>SQL replay for EF Core on SQL Server with NetTopologySuite: spatial columns read from a replayed reader.</Description>
    <PackageId>Bruinet.Mocking.Data.EntityFrameworkCore.SqlServer</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinet.Mocking.Data.EntityFrameworkCore\Bruinet.Mocking.Data.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer.NetTopologySuite" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

</Project>
