<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bruinell.Recording</RootNamespace>
    <Description>Screen recording for Bruinell: one recorder API, a registry of recorders per platform, the shared clock and the ffmpeg encoder.</Description>
    <PackageId>Bruinell.Recording</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinell.Core\Bruinell.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bruinell.Narrator.Windows" />
    <InternalsVisibleTo Include="Bruinell.Recording.Tests" />
    <InternalsVisibleTo Include="Bruinell.Narrator" />
  </ItemGroup>

</Project>
