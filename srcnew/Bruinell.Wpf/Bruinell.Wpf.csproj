<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <RootNamespace>Bruinell.Wpf</RootNamespace>
    <Description>WPF UI testing automation using FlaUI. Provides controls and page objects for WPF application testing.</Description>
    <PackageId>Bruinell.Wpf</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinell.Core\Bruinell.Core.csproj" />
