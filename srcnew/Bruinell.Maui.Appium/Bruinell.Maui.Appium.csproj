    <RootNamespace>Bruinell.Maui.Appium</RootNamespace>
    <Description>Appium-based driver implementation for MAUI UI testing on iOS and Android platforms.</Description>
    <PackageId>Bruinell.Maui.Appium</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinell.Maui\Bruinell.Maui.csproj" />
