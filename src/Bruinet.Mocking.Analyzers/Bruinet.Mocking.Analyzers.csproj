<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Analyzers load into the compiler, which needs netstandard2.0. -->
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <RootNamespace>Bruinet.Mocking.Analyzers</RootNamespace>
    <!-- Shipped inside the Bruinet.Mocking package (analyzers/dotnet/cs), not on its own. -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Older than the repository's Roslyn on purpose: an analyzer built against a compiler newer
         than the SDK's does not load (CS8032, an error with TreatWarningsAsErrors). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.8.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
