<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Brinell.Stride.Automation</RootNamespace>
    <Description>In-game automation hooks for Stride 3D engine UI testing. Install this in your game to enable automation.</Description>
    <PackageTags>testing;stride;automation;ui-testing;game-testing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stride.Engine" />
    <PackageReference Include="Stride.UI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Brinell.Stride\Brinell.Stride.csproj" />
  </ItemGroup>

</Project>
