<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bruinet.NativeAndroid</RootNamespace>
    <Description>Page objects, controls and the Appium driver for native Android apps (UiAutomator2), in the shape of Bruinet's MAUI and Html stacks.</Description>
    <PackageId>Bruinet.NativeAndroid</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinet.Core\Bruinet.Core.csproj" />
    <ProjectReference Include="..\Bruinet.Appium\Bruinet.Appium.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Appium.WebDriver" />
  </ItemGroup>

</Project>
