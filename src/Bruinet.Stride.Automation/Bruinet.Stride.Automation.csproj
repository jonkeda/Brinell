<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Stride packages only support net10.0 -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>Bruinet.Stride.Automation</RootNamespace>
    <Description>In-game automation server for Stride applications. Embeds into game to handle UI automation requests from Bruinet.Stride test client.</Description>
    <PackageId>Bruinet.Stride.Automation</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stride.Engine" />
    <PackageReference Include="Stride.UI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Bruinet.Core/Bruinet.Core.csproj" />
    <ProjectReference Include="../Bruinet.Stride/Bruinet.Stride.csproj" />
  </ItemGroup>

</Project>
