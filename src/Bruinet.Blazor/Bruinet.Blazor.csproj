    <Description>Blazor UI testing automation using Playwright. Provides controls and page objects for Blazor Server and WebAssembly application testing.</Description>
    <PackageId>Bruinet.Blazor</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinet.Html\Bruinet.Html.csproj" />
    <ProjectReference Include="..\Bruinet.Html.Playwright\Bruinet.Html.Playwright.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

</Project>
