<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>Bruinet.Maui.CommunityToolkit</RootNamespace>
    <Description>CommunityToolkit.Maui controls for Bruinet UI testing framework.</Description>
    <PackageId>Bruinet.Maui.CommunityToolkit</PackageId>
  </PropertyGroup>

  <!--
    No CommunityToolkit.Maui reference: control objects wrap automation elements, not MAUI
    types, so this library stays MAUI-free like Bruinet.Maui. The toolkit is referenced by
    the sample app only.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Bruinet.Maui\Bruinet.Maui.csproj" />
  </ItemGroup>

</Project>
