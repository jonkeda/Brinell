<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Brinell.Uat.Workspace</RootNamespace>
    <Description>Loads a Brinell suite one way for every tool: finds the suites, reads their config, and builds their catalogs from a shadow copy that can be unloaded.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\srcnew\Brinell.Uat\Brinell.Uat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Brinell.Uat.Workspace.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Brinell.Bdd" />
  </ItemGroup>

</Project>
