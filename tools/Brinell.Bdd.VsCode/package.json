{
  "name": "brinell-bdd",
  "displayName": "Brinell BDD",
  "description": "Brinell feature and step files: the gate's diagnostics as you type, completion, navigation, a Scenario Preview, and running and debugging scenarios from Test Explorer.",
  "version": "0.1.0",
  "publisher": "brinell",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Testing",
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:**/uat.config.md",
    "workspaceContains:**/bdd.config.md"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "brinellBdd.openPreview",
        "title": "Open Scenario Preview to the Side",
        "category": "Brinell BDD",
        "icon": "$(open-preview)"
      },
      {
        "command": "brinellBdd.toggleStepBreakpoint",
        "title": "Toggle BDD Step Breakpoint",
        "category": "Brinell BDD"
      },
      {
        "command": "brinellBdd.refreshTests",
        "title": "Refresh UAT Scenarios",
        "category": "Brinell BDD"
      },
      {
        "command": "brinellBdd.deleteSuiteResults",
        "title": "Delete All Results of a Suite",
        "category": "Brinell BDD"
      },
      {
        "command": "brinellBdd.stepOver",
        "title": "Step Over BDD Step",
        "category": "Brinell BDD",
        "enablement": "brinellBdd.paused"
      },
      {
        "command": "brinellBdd.stepInto",
        "title": "Step Into BDD Call",
        "category": "Brinell BDD",
        "enablement": "brinellBdd.pausedAtCall"
      },
      {
        "command": "brinellBdd.stepOut",
        "title": "Step Out of BDD Call",
        "category": "Brinell BDD",
        "enablement": "brinellBdd.pausedInCall"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "brinellBdd.openPreview",
          "when": "resourceFilename =~ /\\.(feature|steps|video)\\.md$/",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "brinellBdd.toggleStepBreakpoint",
          "when": "resourceFilename =~ /\\.(feature|steps)\\.md$/"
        }
      ]
    },
    "keybindings": [
      {
        "command": "brinellBdd.openPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorTextFocus && resourceFilename =~ /\\.(feature|steps|video)\\.md$/"
      },
      {
        "command": "brinellBdd.toggleStepBreakpoint",
        "key": "ctrl+k f9",
        "mac": "cmd+k f9",
        "when": "editorTextFocus && resourceFilename =~ /\\.(feature|steps)\\.md$/"
      },
      {
        "command": "brinellBdd.stepOver",
        "key": "alt+shift+f10",
        "when": "brinellBdd.paused"
      },
      {
        "command": "brinellBdd.stepInto",
        "key": "alt+shift+f11",
        "when": "brinellBdd.pausedAtCall"
      },
      {
        "command": "brinellBdd.stepOut",
        "key": "ctrl+shift+f11",
        "when": "brinellBdd.pausedInCall"
      }
    ],
    "configuration": {
      "title": "Brinell BDD",
      "properties": {
        "brinellBdd.serverPath": {
          "type": "string",
          "default": "",
          "description": "The language server's dll (Brinell.Bdd.LanguageServer.dll). Empty: the one in the extension, else the repository's build."
        },
        "brinellBdd.recordingsFolder": {
          "type": "string",
          "default": "",
          "description": "Where Record puts its videos. Empty: TestResults/recordings of the suite's results."
        },
        "brinellBdd.voice": {
          "type": "string",
          "default": "",
          "description": "The voice a recording speaks with, by (part of) its name, when the video script names none. Empty: the system's default voice."
        },
        "brinellBdd.beat": {
          "type": "number",
          "default": 600,
          "description": "How long a recording waits after a step, in milliseconds, when the video script does not say."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "npx --yes @vscode/vsce@3 package --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.95.0",
    "typescript": "^5.6.0"
  }
}
