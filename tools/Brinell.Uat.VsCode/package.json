{
  "name": "brinell-uat",
  "displayName": "Brinell UAT",
  "description": "Brinell feature and step files: the gate's diagnostics as you type, completion, navigation, a Scenario Preview, and running and debugging scenarios from Test Explorer.",
  "version": "0.1.0",
  "publisher": "brinell",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Testing",
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:**/uat.config.md",
    "workspaceContains:**/bdd.config.md"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "brinellUat.openPreview",
        "title": "Open Scenario Preview to the Side",
        "category": "Brinell UAT",
        "icon": "$(open-preview)"
      },
      {
        "command": "brinellUat.toggleStepBreakpoint",
        "title": "Toggle UAT Step Breakpoint",
        "category": "Brinell UAT"
      },
      {
        "command": "brinellUat.refreshTests",
        "title": "Refresh UAT Scenarios",
        "category": "Brinell UAT"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "brinellUat.openPreview",
          "when": "resourceFilename =~ /\\.(feature|steps)\\.md$/",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "brinellUat.toggleStepBreakpoint",
          "when": "resourceFilename =~ /\\.(feature|steps)\\.md$/"
        }
      ]
    },
    "keybindings": [
      {
        "command": "brinellUat.openPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorTextFocus && resourceFilename =~ /\\.(feature|steps)\\.md$/"
      },
      {
        "command": "brinellUat.toggleStepBreakpoint",
        "key": "ctrl+k f9",
        "mac": "cmd+k f9",
        "when": "editorTextFocus && resourceFilename =~ /\\.(feature|steps)\\.md$/"
      }
    ],
    "configuration": {
      "title": "Brinell UAT",
      "properties": {
        "brinellUat.serverPath": {
          "type": "string",
          "default": "",
          "description": "The language server's dll (Brinell.Uat.LanguageServer.dll). Empty: the one in the extension, else the repository's build."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.95.0",
    "typescript": "^5.6.0"
  }
}
