<UserControl x:Class="Brinell.Scraper.Views.SiteSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Brinell Scraper" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Select a site corpus or create a new one" FontSize="14" Foreground="Gray" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Site list -->
        <ListView Grid.Row="1" ItemsSource="{Binding Sites}"
                  x:Name="SiteList"
                  BorderBrush="LightGray" BorderThickness="1"
                  MouseDoubleClick="SiteList_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="200"
                                    DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="URL" Width="300"
                                    DisplayMemberBinding="{Binding StartUrl}"/>
                    <GridViewColumn Header="Pages" Width="60"
                                    DisplayMemberBinding="{Binding PageCount}"/>
                    <GridViewColumn Header="Controls" Width="70"
                                    DisplayMemberBinding="{Binding ControlCount}"/>
                    <GridViewColumn Header="Last Opened" Width="150"
                                    DisplayMemberBinding="{Binding LastOpenedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="New Site..." Command="{Binding NewSiteCommand}"
                    Padding="16,8" Margin="0,0,8,0"/>
            <Button Content="Edit..." Padding="16,8" Margin="0,0,8,0"
                    Command="{Binding EditSiteCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=SiteList}"/>
            <Button Content="Open" Padding="16,8"
                    Command="{Binding SelectSiteCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=SiteList}"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</UserControl>
