<UserControl x:Class="Brinell.Scraper.Views.Tabs.ScrapingTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Brinell.Scraper.Views"
             d:DesignHeight="600" d:DesignWidth="1200"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <UserControl.Resources>
        <Style x:Key="SidebarActionButton" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <!-- Top toolbar -->
        <ToolBar DockPanel.Dock="Top">
            <Button Command="{Binding Browser.GoBackCommand}" Content="◀" ToolTip="Back" Padding="6,2"/>
            <Button Command="{Binding Browser.GoForwardCommand}" Content="▶" ToolTip="Forward" Padding="6,2"/>
            <Button Command="{Binding Browser.RefreshCommand}" Content="↻" ToolTip="Refresh" Padding="6,2"/>
            <ProgressBar IsIndeterminate="True"
                         Width="44"
                         Height="10"
                         Margin="6,0,6,0"
                         VerticalAlignment="Center"
                         Visibility="{Binding Browser.IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            <TextBox x:Name="AddressBox"
                     Text="{Binding Browser.AddressUrl, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="AddressBar_KeyDown"
                     Width="560" MinWidth="260" MaxWidth="760" Margin="4,0"/>
            <Button Command="{Binding Browser.NavigateCommand}" Content="Go" Padding="8,2"/>
            <Separator/>
            <Button Command="{Binding Recording.StartRecordingCommand}"
                    Content="⏺" ToolTip="Start Recording" Padding="6,2"
                    Visibility="{Binding Recording.IsRecording, Converter={StaticResource InverseBoolToVisibility}}"/>
            <Button Command="{Binding Recording.StopRecordingCommand}"
                    Content="⏹" ToolTip="Stop Recording" Padding="6,2"
                    Visibility="{Binding Recording.IsRecording, Converter={StaticResource BoolToVisibility}}"/>
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding Recording.IsRecording, Converter={StaticResource BoolToVisibility}}">
                <Button Command="{Binding Recording.PauseRecordingCommand}"
                        Content="⏸" ToolTip="Pause" Padding="6,2"
                        Visibility="{Binding Recording.IsPaused, Converter={StaticResource InverseBoolToVisibility}}"/>
                <Button Command="{Binding Recording.ResumeRecordingCommand}"
                        Content="▶" ToolTip="Resume" Padding="6,2"
                        Visibility="{Binding Recording.IsPaused, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <Separator/>
            <ToggleButton Content="🔍" ToolTip="Inspect"
                          IsChecked="{Binding Inspector.IsInspecting, Mode=OneWay}"
                          Command="{Binding Inspector.ToggleInspectCommand}"
                          Padding="6,2"/>
            <Button Command="{Binding Inspector.CaptureSnapshotCommand}"
                    Content="📷" ToolTip="Capture DOM Snapshot (adds to session when recording, corpus otherwise)" Padding="6,2"/>
            <Separator/>
            <ToggleButton Content="📂" ToolTip="Toggle Session Panel"
                          IsChecked="{Binding IsSessionPanelVisible, Mode=OneWay}"
                          Command="{Binding ToggleSessionPanelCommand}"
                          Padding="6,2"/>
            <Separator/>
            <Button Command="{Binding Browser.OpenDevToolsCommand}" Content="F12" ToolTip="Developer Tools" Padding="6,2"/>
        </ToolBar>

        <!-- Tab-local status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Browser.StatusText}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding Session.CorpusStats, Mode=OneWay}"/>
            </StatusBarItem>
            <Separator Visibility="{Binding Inspector.IsInspecting, Converter={StaticResource BoolToVisibility}}"/>
            <StatusBarItem Visibility="{Binding Inspector.IsInspecting, Converter={StaticResource BoolToVisibility}}">
                <TextBlock>
                    <Run Text="{Binding Inspector.SelectedCount, Mode=OneWay}"/>
                    <Run Text=" selected · DOM: "/>
                    <Run Text="{Binding Inspector.TotalElementCount, Mode=OneWay}"/>
                    <Run Text=" elements"/>
                </TextBlock>
            </StatusBarItem>
            <Separator Visibility="{Binding Recording.IsRecording, Converter={StaticResource BoolToVisibility}}"/>
            <StatusBarItem Visibility="{Binding Recording.IsRecording, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Recording.RecordingStatus}" Foreground="Red"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar IsIndeterminate="{Binding Browser.IsLoading}" Width="100" Height="14"
                             Visibility="{Binding Browser.IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Body grid: Session | splitter | Browser | splitter | Inspector -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SessionColumn" Width="240" MinWidth="0"/>
                <ColumnDefinition x:Name="SessionSplitterColumn" Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="InspectorSplitterColumn" Width="4"/>
                <ColumnDefinition x:Name="InspectorColumn" Width="320" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- Session panel -->
            <DockPanel Grid.Column="0"
                       Visibility="{Binding IsSessionPanelVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Session.SiteHeader, Mode=OneWay}"
                                   FontWeight="Bold" FontSize="12"
                                   Margin="6,8,4,2" Foreground="#333"/>
                        <TextBlock Text="{Binding Session.CorpusStats, Mode=OneWay}"
                                   FontSize="11"
                                   Margin="6,0,4,2" Foreground="#666"/>

                        <TextBlock Text="🔴 Recording"
                                   FontWeight="SemiBold" FontSize="11"
                                   Margin="6,8,4,0" Foreground="#b30000"
                                   Visibility="{Binding Session.IsRecording, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding Session.SessionSummary, Mode=OneWay}"
                                   FontSize="11"
                                   Margin="6,0,4,2" Foreground="#666"/>

                        <Border Margin="6,8,6,0" Padding="6" BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="4" Background="#FAFAFA">
                            <StackPanel>
                                <TextBlock Text="This Session" FontWeight="SemiBold" FontSize="11" Foreground="#555"/>
                                <Separator Margin="0,2,0,4"/>
                                <ListView ItemsSource="{Binding Session.RecordedPages}"
                                          SelectedItem="{Binding Session.SelectedRecordingPage, Mode=TwoWay}"
                                          SelectionMode="Single"
                                          BorderThickness="0" Margin="0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="11" Margin="2,1">
                                                <Run Text="{Binding StatusIcon, Mode=OneWay}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Style="{StaticResource SidebarActionButton}" Content="Navigate"
                                            Command="{Binding Session.NavigateSelectedRecordingCommand}"/>
                                    <Button Style="{StaticResource SidebarActionButton}" Content="Remove"
                                            Command="{Binding Session.RemoveSelectedRecordingCommand}"/>
                                    <Button Style="{StaticResource SidebarActionButton}" Content="Clear All"
                                            Margin="0"
                                            Command="{Binding Session.ClearRecordingsCommand}"/>
                                </WrapPanel>
                                <Button Margin="0,6,0,0"
                                    Padding="8,2"
                                    FontSize="11"
                                    Content="Transfer to Corpus"
                                    Command="{Binding Session.TransferSessionToCorpusCommand}"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="6,8,6,8" Padding="6" BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="4" Background="#FAFAFA">
                            <StackPanel>
                                <TextBlock Text="Corpus" FontWeight="SemiBold" FontSize="11" Foreground="#555"/>
                                <Separator Margin="0,2,0,4"/>
                                <ListView ItemsSource="{Binding Session.CorpusPages}"
                                          SelectedItem="{Binding Session.SelectedCorpusPage, Mode=TwoWay}"
                                          SelectionMode="Single"
                                          BorderThickness="0" Margin="0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="11" Margin="2,1">
                                                <Run Text="{Binding StatusIcon, Mode=OneWay}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Style="{StaticResource SidebarActionButton}" Content="Navigate"
                                            Command="{Binding Session.NavigateSelectedCorpusCommand}"/>
                                    <Button Style="{StaticResource SidebarActionButton}" Content="Remove"
                                            Margin="0"
                                            Command="{Binding Session.RemoveSelectedCorpusCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          Visibility="{Binding IsSessionPanelVisible, Converter={StaticResource BoolToVisibility}}"/>

            <Border Grid.Column="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Recording.IsRecording}" Value="True">
                                <Setter Property="BorderThickness" Value="3"/>
                                <Setter Property="BorderBrush" Value="Red"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <views:BrowserView x:Name="BrowserHost"/>
            </Border>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"/>

            <Grid Grid.Column="4">
                <DockPanel Visibility="{Binding IsInspectorVisible, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                        <Button Content="Select Forms"
                                Command="{Binding Inspector.SelectAllFormsCommand}"
                                Padding="4,2" Margin="0,0,4,0" FontSize="11"/>
                        <Button Content="Select Inputs"
                                Command="{Binding Inspector.SelectAllInputsCommand}"
                                Padding="4,2" Margin="0,0,4,0" FontSize="11"/>
                        <Button Content="Clear"
                                Command="{Binding Inspector.ClearSelectionCommand}"
                                Padding="4,2" FontSize="11"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="4,2"
                               Text="{Binding Inspector.ControlGroupSummary}"
                               FontSize="11" Foreground="#666"/>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2">
                        <Button Content="Accept All"
                            Command="{Binding Inspector.AcceptAllGroupsCommand}"
                            Padding="4,2" Margin="0,0,4,0" FontSize="11"/>
                        <Button Content="Dismiss"
                            Command="{Binding Inspector.DismissGroupsCommand}"
                            Padding="4,2" FontSize="11"/>
                        </StackPanel>
                    <ScrollViewer DockPanel.Dock="Top"
                                  MaxHeight="120"
                                  Margin="4,2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Inspector.ControlGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,1">
                                        <TextBlock FontSize="11" Width="140"
                                                   Text="{Binding DisplayName, Mode=OneWay}"/>
                                        <Button Content="Accept" Padding="4,1" Margin="0,0,4,0" FontSize="10"
                                                Command="{Binding DataContext.Inspector.AcceptGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Reject" Padding="4,1" Margin="0,0,4,0" FontSize="10"
                                                Command="{Binding DataContext.Inspector.RejectGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock FontSize="10" Foreground="#888" VerticalAlignment="Center"
                                                   Text="{Binding ContainerType, Mode=OneWay}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock DockPanel.Dock="Bottom" Margin="4,2"
                               FontSize="11" Foreground="#888">
                        <Run Text="Selected: "/>
                        <Run Text="{Binding Inspector.SelectedCount, Mode=OneWay}"/>
                    </TextBlock>
                    <views:DomTreePanel DataContext="{Binding Inspector.DomTree}"/>
                </DockPanel>

                <TextBlock Visibility="{Binding IsInspectorVisible, Converter={StaticResource InverseBoolToVisibility}}"
                           Text="Start inspecting to see element details."
                           FontSize="11" Foreground="#999" Margin="8"
                           TextWrapping="Wrap" VerticalAlignment="Top"/>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
