<UserControl x:Class="Brinell.Scraper.Views.Tabs.SettingsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel Orientation="Vertical" MaxWidth="720" HorizontalAlignment="Left">

            <GroupBox Header="Site" Margin="0,0,0,12" Padding="8">
                <GroupBox.Style>
                    <Style TargetType="GroupBox">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSiteContextActive}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GroupBox.Style>
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                             Text="{Binding SiteName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Start URL:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                             Text="{Binding StartUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Output path:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Padding="8,2" Margin="4,4,0,4"
                            Command="{Binding BrowseOutputPathCommand}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Target namespace:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                             Text="{Binding TargetNamespace, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                </Grid>
            </GroupBox>

            <GroupBox Margin="0,0,0,12" Padding="8">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Models" VerticalAlignment="Center"/>
                        <Button Content="↻" Padding="4,0" Margin="8,0,0,0" FontSize="14"
                                ToolTip="Refresh available models from Copilot"
                                Command="{Binding RefreshModelsCommand}"/>
                    </StackPanel>
                </GroupBox.Header>
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Analyzer model:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,4"
                              IsEditable="True"
                              ItemsSource="{Binding AvailableModels}"
                              Text="{Binding AnalyzerModel, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Generator model:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4"
                              IsEditable="True"
                              ItemsSource="{Binding AvailableModels}"
                              Text="{Binding GeneratorModel, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Logging" Margin="0,0,0,12" Padding="8">
                <StackPanel Margin="4">
                    <CheckBox Content="Log LLM prompts"
                              IsChecked="{Binding LogLlmPrompts}" Margin="0,4"/>
                    <CheckBox Content="Log LLM responses"
                              IsChecked="{Binding LogLlmResponses}" Margin="0,4"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Paths" Margin="0,0,0,12" Padding="8">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Corpus root:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4"
                             Text="{Binding CorpusRoot, Mode=OneWay}" IsReadOnly="True"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Skills root:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4"
                             Text="{Binding SkillsRoot, Mode=OneWay}" IsReadOnly="True"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="GitHub Copilot" Margin="0,0,0,12" Padding="8">
                <StackPanel Orientation="Horizontal" Margin="4">
                    <Button Content="Sign in to GitHub" Padding="12,4"
                        Command="{Binding SignInToGitHubCommand}"/>
                    <Button Content="Refresh models" Padding="12,4" Margin="8,0,8,0"
                        Command="{Binding RefreshModelsCommand}"/>
                    <TextBlock Text="{Binding CopilotStatus}"
                           VerticalAlignment="Center"
                           Width="420"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding CopilotStatus}"/>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Reset" Padding="16,6" Margin="0,0,8,0"
                        Command="{Binding ResetCommand}"/>
                <Button Content="Save" Padding="16,6"
                        Command="{Binding SaveCommand}" IsDefault="True"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
