<Window x:Class="ClaudeSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClaudeSwitcher.ViewModels"
        Title="ClaudeSwitcher"
        Icon="{StaticResource ClaudeMark}"
        Width="620" Height="460"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header band -->
        <Border Grid.Row="0"
                Background="{StaticResource Brand.Surface}"
                BorderBrush="{StaticResource Brand.Border}"
                BorderThickness="0,0,0,1"
                Padding="16,14">
            <StackPanel Orientation="Horizontal">
                <Image Source="{StaticResource ClaudeMark}"
                       Width="32" Height="32"
                       VerticalAlignment="Center" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ClaudeSwitcher"
                               FontSize="18" FontWeight="SemiBold"
                               Margin="0" />
                    <TextBlock Text="Switch between Claude Code accounts"
                               Foreground="{StaticResource Brand.TextMuted}"
                               FontSize="12"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="16,12,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Profiles"
                       FontSize="14" FontWeight="SemiBold"
                       Margin="4,0,4,6" />

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Profiles}"
                     SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                     DisplayMemberPath="DisplayName"
                     Margin="4" />

            <WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                <Button Content="Activate"
                        Style="{StaticResource BrandPrimaryButton}"
                        Command="{Binding ActivateCommand}" />
                <Button Content="Capture current as..."
                        Command="{Binding CaptureCommand}" />
                <Button Content="Delete"
                        Style="{StaticResource BrandDangerButton}"
                        Command="{Binding DeleteCommand}" />
                <Button Content="Clear current login"
                        Style="{StaticResource BrandDangerButton}"
                        Command="{Binding ClearLiveCommand}" />
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}" />
            </WrapPanel>

            <TextBlock Grid.Row="3"
                       Text="{Binding Status}"
                       Margin="4,10,4,0"
                       Foreground="{Binding StatusBrush}" />
        </Grid>
    </Grid>
</Window>
