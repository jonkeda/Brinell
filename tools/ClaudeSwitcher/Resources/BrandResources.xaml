<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette (Claude-inspired: warm terracotta on cream) -->
    <Color x:Key="Brand.Primary.Color">#FFC15F3C</Color>
    <Color x:Key="Brand.PrimaryHover.Color">#FFA84E2E</Color>
    <Color x:Key="Brand.PrimaryPressed.Color">#FF8E4023</Color>
    <Color x:Key="Brand.Cream.Color">#FFF5F0E8</Color>
    <Color x:Key="Brand.CreamAlt.Color">#FFEDE5D6</Color>
    <Color x:Key="Brand.Surface.Color">#FFFAF7F1</Color>
    <Color x:Key="Brand.Text.Color">#FF2B1F1A</Color>
    <Color x:Key="Brand.TextMuted.Color">#FF6B5B52</Color>
    <Color x:Key="Brand.Border.Color">#FFE0D3C1</Color>
    <Color x:Key="Brand.Success.Color">#FF3F6B3A</Color>
    <Color x:Key="Brand.Error.Color">#FFB03A2E</Color>

    <SolidColorBrush x:Key="Brand.Primary"        Color="{StaticResource Brand.Primary.Color}"/>
    <SolidColorBrush x:Key="Brand.PrimaryHover"   Color="{StaticResource Brand.PrimaryHover.Color}"/>
    <SolidColorBrush x:Key="Brand.PrimaryPressed" Color="{StaticResource Brand.PrimaryPressed.Color}"/>
    <SolidColorBrush x:Key="Brand.Cream"          Color="{StaticResource Brand.Cream.Color}"/>
    <SolidColorBrush x:Key="Brand.CreamAlt"       Color="{StaticResource Brand.CreamAlt.Color}"/>
    <SolidColorBrush x:Key="Brand.Surface"        Color="{StaticResource Brand.Surface.Color}"/>
    <SolidColorBrush x:Key="Brand.Text"           Color="{StaticResource Brand.Text.Color}"/>
    <SolidColorBrush x:Key="Brand.TextMuted"      Color="{StaticResource Brand.TextMuted.Color}"/>
    <SolidColorBrush x:Key="Brand.Border"         Color="{StaticResource Brand.Border.Color}"/>
    <SolidColorBrush x:Key="Brand.Success"        Color="{StaticResource Brand.Success.Color}"/>
    <SolidColorBrush x:Key="Brand.Error"          Color="{StaticResource Brand.Error.Color}"/>

    <!-- Stylized 8-ray starburst (Claude-inspired, drawn in XAML). -->
    <DrawingImage x:Key="ClaudeMark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource Brand.Primary}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup FillRule="Nonzero">
                            <PathGeometry Figures="M32,3 C35,20 35,44 32,61 C29,44 29,20 32,3 Z"/>
                            <PathGeometry Figures="M32,3 C35,20 35,44 32,61 C29,44 29,20 32,3 Z">
                                <PathGeometry.Transform>
                                    <RotateTransform Angle="22.5" CenterX="32" CenterY="32"/>
                                </PathGeometry.Transform>
                            </PathGeometry>
                            <PathGeometry Figures="M32,3 C35,20 35,44 32,61 C29,44 29,20 32,3 Z">
                                <PathGeometry.Transform>
                                    <RotateTransform Angle="45" CenterX="32" CenterY="32"/>
                                </PathGeometry.Transform>
                            </PathGeometry>
                            <PathGeometry Figures="M32,3 C35,20 35,44 32,61 C29,44 29,20 32,3 Z">
                                <PathGeometry.Transform>
                                    <RotateTransform Angle="67.5" CenterX="32" CenterY="32"/>
                                </PathGeometry.Transform>
                            </PathGeometry>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource Brand.Primary}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="32,32" RadiusX="5" RadiusY="5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Primary button -->
    <Style x:Key="BrandPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brand.Primary}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brand.Primary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brand.PrimaryHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brand.PrimaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brand.PrimaryPressed}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brand.PrimaryPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brand.CreamAlt}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brand.Border}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brand.TextMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary (outline) button -->
    <Style x:Key="BrandSecondaryButton" TargetType="Button" BasedOn="{StaticResource BrandPrimaryButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brand.Primary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brand.Primary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brand.CreamAlt}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brand.Border}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brand.Border}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brand.TextMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger (outline red) button -->
    <Style x:Key="BrandDangerButton" TargetType="Button" BasedOn="{StaticResource BrandSecondaryButton}">
        <Setter Property="Foreground" Value="{StaticResource Brand.Error}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brand.Error}"/>
    </Style>

    <!-- Default button style: secondary. -->
    <Style TargetType="Button" BasedOn="{StaticResource BrandSecondaryButton}"/>

    <!-- TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource Brand.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brand.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brand.Primary}"/>
    </Style>

    <!-- TextBlock -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brand.Text}"/>
        <Setter Property="Margin" Value="4"/>
    </Style>

    <!-- ListBox + item -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource Brand.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brand.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Foreground" Value="{StaticResource Brand.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="4"
                            Margin="0,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brand.CreamAlt}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brand.Primary}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Brand.Cream}"/>
        <Setter Property="Foreground" Value="{StaticResource Brand.Text}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

</ResourceDictionary>
