<UserControl x:Class="Brinell.Scraper.Views.ControlsManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4">
            <TextBlock Text="🧩 Controls Manager" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Generate Pending" Command="{Binding GeneratePendingCommand}" Padding="8,4" Margin="0,0,4,0"/>
            <Button Content="Regenerate" Command="{Binding RegenerateCommand}" Padding="8,4"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Controls list -->
            <ListBox Grid.Column="0" ItemsSource="{Binding Controls}"
                     SelectedItem="{Binding SelectedControl}"
                     DisplayMemberPath="Name"
                     Margin="8,4"/>

            <GridSplitter Grid.Column="1" Width="4" ResizeBehavior="PreviousAndNext"/>

            <!-- Code preview -->
            <TextBox Grid.Column="2" Text="{Binding CodePreview, Mode=OneWay}"
                     IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" AcceptsReturn="True"
                     Margin="8,4"/>
        </Grid>
    </DockPanel>
</UserControl>
