<Window x:Class="Brinell.Scraper.Views.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="800" Height="600"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <!-- Summary bar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8" Background="#F5F5F5">
            <TextBlock Margin="8,4">
                <Run Text="Added: " FontWeight="Bold" Foreground="Green"/>
                <Run Text="{Binding AddedCount, Mode=OneWay}"/>
                <Run Text="   Removed: " FontWeight="Bold" Foreground="Red"/>
                <Run Text="{Binding RemovedCount, Mode=OneWay}"/>
                <Run Text="   Changed: " FontWeight="Bold" Foreground="#FF8C00"/>
                <Run Text="{Binding ChangedCount, Mode=OneWay}"/>
                <Run Text="   Unchanged: " FontWeight="Bold" Foreground="Gray"/>
                <Run Text="{Binding UnchangedCount, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>

        <TabControl Margin="8,0,8,8">
            <!-- Added elements -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock>
                        <Run Text="Added ("/>
                        <Run Text="{Binding AddedCount, Mode=OneWay}"/>
                        <Run Text=")"/>
                    </TextBlock>
                </TabItem.Header>
                <ListBox ItemsSource="{Binding Added}" Foreground="Green" FontFamily="Consolas" FontSize="12"/>
            </TabItem>

            <!-- Removed elements -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock>
                        <Run Text="Removed ("/>
                        <Run Text="{Binding RemovedCount, Mode=OneWay}"/>
                        <Run Text=")"/>
                    </TextBlock>
                </TabItem.Header>
                <ListBox ItemsSource="{Binding Removed}" Foreground="Red" FontFamily="Consolas" FontSize="12"/>
            </TabItem>

            <!-- Changed elements -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock>
                        <Run Text="Changed ("/>
                        <Run Text="{Binding ChangedCount, Mode=OneWay}"/>
                        <Run Text=")"/>
                    </TextBlock>
                </TabItem.Header>
                <ListBox ItemsSource="{Binding Changed}" FontFamily="Consolas" FontSize="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#FF8C00"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
