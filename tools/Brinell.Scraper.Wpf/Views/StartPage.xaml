<UserControl x:Class="Brinell.Scraper.Views.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="Background" Value="#F4F4F6"/>
            <Setter Property="BorderBrush" Value="#DADADD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SiteCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Width" Value="290"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#7C9CF8"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Black" Opacity="0.18" BlurRadius="14" ShadowDepth="2"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F8F9FC" Offset="0"/>
                <GradientStop Color="#EAEEF7" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" MaxWidth="960"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Margin="40,48,40,40" MaxWidth="900">
                    <!-- Title -->
                    <TextBlock Text="🔍 Brinell Scraper"
                               FontSize="36" FontWeight="Bold"
                               Foreground="#1F2330"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Manage and explore your scraping sites"
                               FontSize="14" Foreground="#6B7280"
                               Margin="0,0,0,28"/>

                    <!-- Search -->
                    <Border CornerRadius="8" Background="White"
                            BorderBrush="#DADADD" BorderThickness="1"
                            Padding="12,8" Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔎" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="14" VerticalAlignment="Center"
                                     ToolTip="Search sites by name or URL"/>
                        </Grid>
                    </Border>

                    <!-- Header row -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Recent Sites"
                                   FontSize="18" FontWeight="SemiBold" Foreground="#1F2330"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="+ New Site"
                                Command="{Binding NewSiteCommand}"
                            Padding="14,6" MinWidth="100" Background="#3B6BF0" Foreground="White"
                                BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                    </Grid>

                    <!-- Empty state -->
                    <Border Background="White" CornerRadius="8" Padding="32"
                            BorderBrush="#E2E2E6" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Sites.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="No sites yet" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#1F2330" HorizontalAlignment="Center"/>
                            <TextBlock Text="Click + New Site to start scraping a website."
                                       Foreground="#6B7280" Margin="0,6,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Site cards -->
                    <ItemsControl ItemsSource="{Binding FilteredSites}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SiteCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="#1F2330"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DomainShort}"
                                                   FontSize="12" Foreground="#6B7280"
                                                   Margin="0,2,0,12"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="📄" FontSize="12" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding PageCount}" FontSize="12" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                            <TextBlock Text="pages" FontSize="12" Foreground="#6B7280" Margin="0,0,12,0"/>
                                            <TextBlock Text="🧩" FontSize="12" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding ControlCount}" FontSize="12" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                            <TextBlock Text="controls" FontSize="12" Foreground="#6B7280"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding LastOpenedRelative, StringFormat='Last opened {0}'}"
                                                   FontSize="11" Foreground="#9098A4"
                                                   Margin="0,0,0,12"/>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Open"
                                                    Style="{StaticResource CardButtonStyle}"
                                                    Background="#3B6BF0" Foreground="White" BorderBrush="#3B6BF0"
                                                    Command="{Binding DataContext.OpenSiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="⚙"
                                                    Style="{StaticResource CardButtonStyle}"
                                                    ToolTip="Edit site"
                                                    Command="{Binding DataContext.EditSiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="🗑"
                                                    Style="{StaticResource CardButtonStyle}"
                                                    ToolTip="Delete site"
                                                    Command="{Binding DataContext.DeleteSiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Bottom bar -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E2E6" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="⚙ Settings"
                        Command="{Binding OpenSettingsCommand}"
                        HorizontalAlignment="Left"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#3B6BF0" FontWeight="SemiBold"
                        Padding="6,2" Cursor="Hand"/>
                <TextBlock Grid.Column="1" x:Name="VersionLabel"
                           Foreground="#9098A4" FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
