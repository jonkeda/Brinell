<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="Bruinet.Bdd.VisualStudio.720464a3-8754-41d5-ac15-22ba895fcd17" Version="0.1.0" Language="en-US" Publisher="Bruinet Contributors" />
    <DisplayName>Bruinet BDD</DisplayName>
    <Description xml:space="preserve">A preview of Bruinet feature and step files: readable steps, what the gate sees, and the last run's results.</Description>
    <Tags>Bruinet, BDD, Gherkin, UAT, feature</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.10,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.10,19.0)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,19.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
    <!-- The step breakpoints' glyphs in the editor (a tagger and a glyph factory). -->
    <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%|" />
    <!-- The BDD CodeLens on C# members, loaded by Visual Studio's CodeLens process. -->
    <Asset Type="Microsoft.VisualStudio.CodeLensComponent" d:Source="Project" d:ProjectName="Bruinet.Bdd.VisualStudio.CodeLens" Path="|Bruinet.Bdd.VisualStudio.CodeLens|" />
  </Assets>
</PackageManifest>
