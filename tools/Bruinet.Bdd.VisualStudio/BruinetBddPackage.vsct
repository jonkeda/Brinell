<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidBruinetBddPackage">
    <Groups>
      <!-- The editor's context menu, shown for feature and step files only. -->
      <Group guid="guidBruinetUatCommandSet" id="EditorContextGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" />
      </Group>
      <!-- The Debug menu: stepping through a scenario's steps while a debugged run is paused at one. -->
      <Group guid="guidBruinetUatCommandSet" id="DebugStepGroup" priority="0x0700">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_DEBUG" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidBruinetUatCommandSet" id="ShowScenarioPreview" priority="0x0100" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
        <Strings>
          <ButtonText>Scenario Preview</ButtonText>
          <CommandName>Bruinet.ScenarioPreview</CommandName>
        </Strings>
      </Button>
      <Button guid="guidBruinetUatCommandSet" id="ShowBddExplorer" priority="0x0101" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
        <Strings>
          <ButtonText>BDD Explorer</ButtonText>
          <CommandName>Bruinet.BddExplorer</CommandName>
        </Strings>
      </Button>
      <Button guid="guidBruinetUatCommandSet" id="ShowScraper" priority="0x0102" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
        <Strings>
          <ButtonText>Scraper</ButtonText>
          <CommandName>Bruinet.Scraper</CommandName>
        </Strings>
      </Button>
      <Button guid="guidBruinetUatCommandSet" id="OpenScenarioPreview" priority="0x0100" type="Button">
        <Parent guid="guidBruinetUatCommandSet" id="EditorContextGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Show/Hide Scenario Preview</ButtonText>
          <CommandName>Bruinet.OpenScenarioPreview</CommandName>
        </Strings>
      </Button>
      <Button guid="guidBruinetUatCommandSet" id="ToggleStepBreakpoint" priority="0x0200" type="Button">
        <Parent guid="guidBruinetUatCommandSet" id="EditorContextGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Toggle BDD Step Breakpoint</ButtonText>
          <CommandName>Bruinet.ToggleUatStepBreakpoint</CommandName>
        </Strings>
      </Button>
      <Button guid="guidBruinetUatCommandSet" id="StepOverBdd" priority="0x0100" type="Button">
        <Parent guid="guidBruinetUatCommandSet" id="DebugStepGroup" />
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Step Over BDD Step</ButtonText>
          <CommandName>Bruinet.StepOverBddStep</CommandName>
        </Strings>
      </Button>
      <Button guid="guidBruinetUatCommandSet" id="StepIntoBdd" priority="0x0101" type="Button">
        <Parent guid="guidBruinetUatCommandSet" id="DebugStepGroup" />
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Step Into BDD Call</ButtonText>
          <CommandName>Bruinet.StepIntoBddCall</CommandName>
        </Strings>
      </Button>
      <Button guid="guidBruinetUatCommandSet" id="StepOutBdd" priority="0x0102" type="Button">
        <Parent guid="guidBruinetUatCommandSet" id="DebugStepGroup" />
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Step Out of BDD Call</ButtonText>
          <CommandName>Bruinet.StepOutOfBddCall</CommandName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <KeyBindings>
    <!-- Shows or hides the preview beside the editor's text (BddPreviewMargin).
         Alt+Shift+V, free in every scope. Also Ctrl+K, V, as VS Code opens a Markdown preview; not
         Ctrl+K, Ctrl+V, which is Visual Studio's (Class View's search box). -->
    <KeyBinding guid="guidBruinetUatCommandSet" id="OpenScenarioPreview" editor="guidVSStd97" key1="V" mod1="Alt Shift" />
    <KeyBinding guid="guidBruinetUatCommandSet" id="OpenScenarioPreview" editor="guidVSStd97" key1="K" mod1="Control" key2="V" />
    <!-- Ctrl+K, F9 (or Ctrl+K, Ctrl+F9): beside F9, which the debugger keeps for C# breakpoints. -->
    <KeyBinding guid="guidBruinetUatCommandSet" id="ToggleStepBreakpoint" editor="guidVSStd97" key1="K" mod1="Control" key2="VK_F9" />
    <KeyBinding guid="guidBruinetUatCommandSet" id="ToggleStepBreakpoint" editor="guidVSStd97" key1="K" mod1="Control" key2="VK_F9" mod2="Control" />
    <!-- Stepping through BDD steps: single chords, free in every scope (Ctrl+F10 is Run To Cursor,
         Ctrl+F11 Toggle Disassembly); Step out cannot be Alt+Shift+F11, which is Step into. -->
    <KeyBinding guid="guidBruinetUatCommandSet" id="StepOverBdd" editor="guidVSStd97" key1="VK_F10" mod1="Alt Shift" />
    <KeyBinding guid="guidBruinetUatCommandSet" id="StepIntoBdd" editor="guidVSStd97" key1="VK_F11" mod1="Alt Shift" />
    <KeyBinding guid="guidBruinetUatCommandSet" id="StepOutBdd" editor="guidVSStd97" key1="VK_F11" mod1="Control Shift" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidBruinetBddPackage" value="{3f45aa33-e8c9-4927-830b-6ba9b74c9467}" />
    <GuidSymbol name="guidBruinetUatCommandSet" value="{68a7da07-ac82-47a1-bd70-257d5ba3b27c}">
      <IDSymbol name="EditorContextGroup" value="0x1020" />
      <IDSymbol name="ShowScenarioPreview" value="0x0100" />
      <IDSymbol name="OpenScenarioPreview" value="0x0101" />
      <IDSymbol name="ToggleStepBreakpoint" value="0x0102" />
      <IDSymbol name="ShowBddExplorer" value="0x0103" />
      <IDSymbol name="StepOverBdd" value="0x0104" />
      <IDSymbol name="StepIntoBdd" value="0x0105" />
      <IDSymbol name="StepOutBdd" value="0x0106" />
      <IDSymbol name="ShowScraper" value="0x0107" />
      <IDSymbol name="DebugStepGroup" value="0x1030" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
