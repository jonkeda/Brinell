<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Brinell.Uat.Preview</RootNamespace>
    <Description>Renders a feature or step file as the preview shows it: readable steps, what the gate sees, and the last run's results, as HTML with a themable stylesheet.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Parsing and binding only: the preview needs no page machinery (AD-021). -->
    <ProjectReference Include="..\..\srcnew\Brinell.Bdd\Brinell.Bdd.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="preview.css" LogicalName="Brinell.Uat.Preview.preview.css" />
    <EmbeddedResource Include="preview-host.js" LogicalName="Brinell.Uat.Preview.preview-host.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Brinell.Uat.Preview.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Brinell.Bdd" />
  </ItemGroup>

</Project>
