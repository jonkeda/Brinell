{
  "name": "bruinet-bdd",
  "displayName": "Bruinet BDD",
  "description": "Bruinet feature and step files: the gate's diagnostics as you type, completion, navigation, a Scenario Preview, and running and debugging scenarios from Test Explorer, and the Scraper: record an app's pages into a UI test project for page objects.",
  "version": "0.1.0",
  "publisher": "bruinet",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Testing",
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:**/uat.config.md",
    "workspaceContains:**/bdd.config.md",
    "workspaceContains:**/scraper.config.md"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bruinetBdd.openPreview",
        "title": "Open Scenario Preview to the Side",
        "category": "Bruinet BDD",
        "icon": "$(open-preview)"
      },
      {
        "command": "bruinetBdd.openScraper",
        "title": "Open Scraper",
        "category": "Bruinet BDD",
        "icon": "$(record)"
      },
      {
        "command": "bruinetBdd.toggleStepBreakpoint",
        "title": "Toggle BDD Step Breakpoint",
        "category": "Bruinet BDD"
      },
      {
        "command": "bruinetBdd.refreshTests",
        "title": "Refresh UAT Scenarios",
        "category": "Bruinet BDD"
      },
      {
        "command": "bruinetBdd.deleteSuiteResults",
        "title": "Delete All Results of a Suite",
        "category": "Bruinet BDD"
      },
      {
        "command": "bruinetBdd.stepOver",
        "title": "Step Over BDD Step",
        "category": "Bruinet BDD",
        "enablement": "bruinetBdd.paused"
      },
      {
        "command": "bruinetBdd.stepInto",
        "title": "Step Into BDD Call",
        "category": "Bruinet BDD",
        "enablement": "bruinetBdd.pausedAtCall || bruinetBdd.stepPaused"
      },
      {
        "command": "bruinetBdd.stepOut",
        "title": "Step Out of BDD Call",
        "category": "Bruinet BDD",
        "enablement": "bruinetBdd.pausedInCall || bruinetBdd.stepPaused"
      },
      {
        "command": "bruinetBdd.stepThrough",
        "title": "Step Through Scenario",
        "category": "Bruinet BDD"
      },
      {
        "command": "bruinetBdd.debugFromHere",
        "title": "Debug From Here",
        "category": "Bruinet BDD",
        "enablement": "bruinetBdd.stepPaused"
      },
      {
        "command": "bruinetBdd.runScenario",
        "title": "Run Scenario on the Runner",
        "category": "Bruinet BDD"
      },
      {
        "command": "bruinetBdd.continue",
        "title": "Continue BDD Run",
        "category": "Bruinet BDD",
        "enablement": "bruinetBdd.paused"
      },
      {
        "command": "bruinetBdd.stop",
        "title": "Stop BDD Run",
        "category": "Bruinet BDD",
        "enablement": "bruinetBdd.paused"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bruinetBdd.openPreview",
          "when": "resourceFilename =~ /\\.(feature|steps|video)\\.md$/",
          "group": "navigation"
        },
        {
          "command": "bruinetBdd.openScraper",
          "when": "resourceFilename == scraper.config.md",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "bruinetBdd.toggleStepBreakpoint",
          "when": "resourceFilename =~ /\\.(feature|steps)\\.md$/"
        }
      ]
    },
    "keybindings": [
      {
        "command": "bruinetBdd.openPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorTextFocus && resourceFilename =~ /\\.(feature|steps|video)\\.md$/"
      },
      {
        "command": "bruinetBdd.toggleStepBreakpoint",
        "key": "ctrl+k f9",
        "mac": "cmd+k f9",
        "when": "editorTextFocus && resourceFilename =~ /\\.(feature|steps)\\.md$/"
      },
      {
        "command": "bruinetBdd.stepOver",
        "key": "alt+shift+f10",
        "when": "bruinetBdd.paused"
      },
      {
        "command": "bruinetBdd.stepInto",
        "key": "alt+shift+f11",
        "when": "bruinetBdd.pausedAtCall"
      },
      {
        "command": "bruinetBdd.stepOut",
        "key": "ctrl+shift+f11",
        "when": "bruinetBdd.pausedInCall"
      },
      {
        "command": "bruinetBdd.stepOver",
        "key": "f10",
        "when": "bruinetBdd.stepPaused && !inDebugMode"
      },
      {
        "command": "bruinetBdd.stepInto",
        "key": "f11",
        "when": "bruinetBdd.stepPaused && !inDebugMode"
      },
      {
        "command": "bruinetBdd.stepOut",
        "key": "shift+f11",
        "when": "bruinetBdd.stepPaused && !inDebugMode"
      },
      {
        "command": "bruinetBdd.continue",
        "key": "f5",
        "when": "bruinetBdd.stepPaused && !inDebugMode"
      },
      {
        "command": "bruinetBdd.stop",
        "key": "shift+f5",
        "when": "bruinetBdd.stepPaused && !inDebugMode"
      }
    ],
    "configuration": {
      "title": "Bruinet BDD",
      "properties": {
        "bruinetBdd.serverPath": {
          "type": "string",
          "default": "",
          "description": "bruinet's dll (bruinet.dll, started with lsp). Empty: the one in the extension, else the repository's build."
        },
        "bruinetBdd.recordingsFolder": {
          "type": "string",
          "default": "",
          "description": "Where Record puts its videos. Empty: TestResults/recordings of the suite's results."
        },
        "bruinetBdd.voice": {
          "type": "string",
          "default": "",
          "description": "The voice a recording speaks with, by (part of) its name, when the video script names none: a Windows voice, or a cloud voice as azure:<voice> (azure:coral; its key in voice.secrets.json). Empty: the cloud voice when one is set up, else the system's default voice."
        },
        "bruinetBdd.beat": {
          "type": "number",
          "default": 600,
          "description": "How long a recording waits after a step, in milliseconds, when the video script does not say."
        },
        "bruinetBdd.touchColor": {
          "type": "string",
          "default": "",
          "pattern": "^(#[0-9A-Fa-f]{6})?$",
          "description": "The colour of a recording's touch marks, as #RRGGBB, when the video script does not say (TouchColor). Empty: Exact red, #E8111E."
        },
        "bruinetBdd.warmRunner": {
          "type": "boolean",
          "default": true,
          "description": "Start a suite's runner, from a copy of its build output, when one of its feature files opens and after each build, so Run and Step start at once. Off: each run starts its own."
        },
        "bruinetBdd.warmRunnerIdleMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "How long a suite's warm runner waits after its last feature file closes before it ends."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test:ide": "tsc -p . && node out/test/run.js",
    "package": "npx --yes @vscode/vsce@3 package --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.95.0",
    "typescript": "^5.6.0"
  }
}
