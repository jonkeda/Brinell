<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Brinell.Uat.LanguageServer</RootNamespace>
    <Description>The one process every IDE talks to about feature and step files: JSON-RPC over stdio, serving the preview now and the language features later.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Brinell.Uat.Workspace\Brinell.Uat.Workspace.csproj" />
    <ProjectReference Include="..\Brinell.Uat.Preview\Brinell.Uat.Preview.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Brinell.Uat.LanguageServer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Brinell.Bdd" />
  </ItemGroup>

</Project>
