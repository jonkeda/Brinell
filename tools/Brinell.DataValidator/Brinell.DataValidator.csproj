<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Brinell.DataValidator</RootNamespace>
    <Description>brinell-data: validates, describes and lists an app's Brinell test data, loading the app's test-support assembly at run time.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>brinell-data</ToolCommandName>
    <PackageId>Brinell.DataValidator</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Brinell.TestData is shared with the loaded assemblies, so their definitions are the tool's ITestDataDefinition. -->
    <ProjectReference Include="..\..\srcnew\Brinell.TestData\Brinell.TestData.csproj" />
    <!-- For reading uat.config.md and the scenario files' metadata. -->
    <ProjectReference Include="..\..\srcnew\Brinell.Uat\Brinell.Uat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Brinell.DataValidator.Tests" />
  </ItemGroup>

</Project>
