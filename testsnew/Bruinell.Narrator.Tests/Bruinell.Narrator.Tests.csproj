<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bruinell.Narrator.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\srcnew\Bruinell.Narrator\Bruinell.Narrator.csproj" />
    <!-- Built, not referenced: a net10.0 run loads the Windows voice and recorder from a folder (BRUINELL_RECORDERS). -->
    <ProjectReference Include="..\..\srcnew\Bruinell.Narrator.Windows\Bruinell.Narrator.Windows.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=net10.0-windows10.0.19041.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Bruinell.Bdd" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
