<Project Sdk="Microsoft.NET.Sdk">

  <!-- Drives the native Android sample (samples/Bruinell.Samples.NativeAndroid.App) on an emulator
       through Appium, and holds the platform's UAT suite (AD-026). Needs a device, so it stays out
       of CI's unit test list. -->
  <PropertyGroup>
    <RootNamespace>Bruinell.NativeAndroid.UITests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\srcnew\Bruinell.NativeAndroid\Bruinell.NativeAndroid.csproj" />
    <!-- The UAT suite: uat.config.md, Features/ and Uat/ (the scenario test class). -->
    <ProjectReference Include="..\..\srcnew\Bruinell.Uat\Bruinell.Uat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="uat.config.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Features\**\*.feature.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
