<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bruinet.Cli.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\Bruinet.Cli\Bruinet.Cli.csproj" />
    <!-- scrape: the site the commands explore, served by TestSiteServer; its files come along. -->
    <ProjectReference Include="..\Bruinet.Scraper.TestSite\Bruinet.Scraper.TestSite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- controls generate: the inputs and expected outputs are files to read, not code; under TestData\ in the output. -->
    <Compile Remove="Generate/TestData/**/*.cs" />
    <Content Include="Generate/TestData/**/*" CopyToOutputDirectory="PreserveNewest" Link="TestData/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Bruinet.Bdd" />
    <Using Include="Bruinet.Uat" />
  </ItemGroup>

</Project>
