<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bruinell.Presenter.Bdd.Tests</RootNamespace>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!--
      This is a test host, not an app: it needs no image assets of its own. Left on, the
      resizetizer collects MauiIcon items from every referenced project - the Presenter and the
      sample app both ship an `appicon` - and fails the build on the duplicate output name.
    -->
    <DisableResizetizer>true</DisableResizetizer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\srcnew\Bruinell.Uat\Bruinell.Uat.csproj" />
    <ProjectReference Include="..\..\srcnew\Bruinell.Maui\Bruinell.Maui.csproj" />
    <ProjectReference Include="..\..\srcnew\Bruinell.Maui.FlaUI\Bruinell.Maui.FlaUI.csproj" />
    <ProjectReference Include="..\..\srcnew\Bruinell.Presenter\Bruinell.Presenter.csproj" />
    <!-- Built first, not referenced: it is Presenter's default workspace. Private=false keeps its config and feature files out of this project's output, which has its own. -->
    <ProjectReference Include="..\Bruinell.Maui.UITests\Bruinell.Maui.UITests.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="uat.config.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Features\**\*.feature.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestSettings\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="BuildPresenterSampleAut" BeforeTargets="Build">
    <MSBuild Projects="..\..\samples\Bruinell.Samples.Maui.App\Bruinell.Samples.Maui.App.csproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=net10.0-windows10.0.19041.0" />
  </Target>

  <ItemGroup>
    <Using Include="Bruinell.Bdd" />
  </ItemGroup>

</Project>
