<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Visual Studio extension in a real Visual Studio, driven from outside: DTE over COM, the
       preview over CDP (Brinell.Html). Opt-in: BRINELL_IDE_TESTS=1 and a desktop; the fixture builds
       with Visual Studio's MSBuild (tools\Brinell.Bdd.VisualStudio). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Brinell.Bdd.VisualStudio.UITests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\srcnew\Brinell.Core\Brinell.Core.csproj" />
    <ProjectReference Include="..\..\srcnew\Brinell.Html\Brinell.Html.csproj" />
    <ProjectReference Include="..\..\srcnew\Brinell.Html.Playwright\Brinell.Html.Playwright.csproj" />
  </ItemGroup>

  <!-- The preview's page object, shared with the page's own tests in Chromium. -->
  <ItemGroup>
    <Compile Include="..\Brinell.Bdd.Workspace.UITests\PageObjects\ScenarioPreviewPage.cs" Link="PageObjects\ScenarioPreviewPage.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
