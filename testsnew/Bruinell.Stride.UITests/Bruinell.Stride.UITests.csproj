<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bruinell.Stride.UITests</RootNamespace>
    <!-- The game it drives is a Windows app, and the UAT suite references it. -->
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\srcnew\Bruinell.Core\Bruinell.Core.csproj" />
    <ProjectReference Include="..\..\srcnew\Bruinell.Stride\Bruinell.Stride.csproj" />
    <ProjectReference Include="..\..\srcnew\Bruinell.Stride.Automation\Bruinell.Stride.Automation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The UAT suite: uat.config.md, Features/ and Uat/ (the fixture and the scenario test class). -->
  <ItemGroup>
    <ProjectReference Include="..\..\srcnew\Bruinell.Uat\Bruinell.Uat.csproj" />
    <ProjectReference Include="..\..\samples\Bruinell.Samples.Stride.App\Bruinell.Samples.Stride.App.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="uat.config.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Features\**\*.feature.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestSettings\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildStrideSampleApp" BeforeTargets="Build">
    <MSBuild Projects="..\..\samples\Bruinell.Samples.Stride.App\Bruinell.Samples.Stride.App.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>

  <ItemGroup>
    <Using Include="Bruinell.Bdd" />
  </ItemGroup>

</Project>
