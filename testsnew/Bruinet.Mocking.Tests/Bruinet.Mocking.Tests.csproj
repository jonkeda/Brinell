<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bruinet.Mocking.Tests</RootNamespace>
    <!-- These tests exercise the mock server itself with throwaway bodies, not an API's contract (AD-012). -->
    <NoWarn>$(NoWarn);BRUINET001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Moq" />
    <!-- The analyzer tests compile snippets against Bruinet.Mocking. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\srcnew\Bruinet.Core\Bruinet.Core.csproj" />
    <ProjectReference Include="..\..\srcnew\Bruinet.Mocking\Bruinet.Mocking.csproj" />
    <ProjectReference Include="..\..\srcnew\Bruinet.Mocking.Analyzers\Bruinet.Mocking.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ContractSamples\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
