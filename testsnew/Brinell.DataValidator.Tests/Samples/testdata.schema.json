{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shelf test set",
  "type": "object",
  "properties": {
    "books": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          },
          "title": {
            "type": "string"
          },
          "genre": {
            "enum": [
              "Novel",
              "Poetry"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "genre"
        ],
        "additionalProperties": false
      }
    },
    "$schema": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  },
  "required": [
    "books"
  ],
  "additionalProperties": false
}
