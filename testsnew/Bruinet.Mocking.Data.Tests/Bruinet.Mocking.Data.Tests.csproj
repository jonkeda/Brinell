<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bruinet.Mocking.Data.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\srcnew\Bruinet.Mocking.Data\Bruinet.Mocking.Data.csproj" />
    <ProjectReference Include="..\..\srcnew\Bruinet.Mocking.Data.EntityFrameworkCore\Bruinet.Mocking.Data.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- The schema snapshot's and Extended Events' tests, on the local SQL Server (SqlServerFact). -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- SqlClient brings 9.0.11, which has known vulnerabilities: lifted to the repository's pinned version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
