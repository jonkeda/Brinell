<Project Sdk="Microsoft.NET.Sdk">

  <!-- MauiUnit on NUnit: the same examples, to show MauiUnit needs no xUnit. -->
  <PropertyGroup>
    <RootNamespace>MauiUnit.Tests.NUnit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- testsnew/Directory.Build.props adds xUnit to every test project. -->
    <PackageReference Remove="xunit" />
    <PackageReference Remove="xunit.runner.visualstudio" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\srcnew\MauiUnit\MauiUnit.csproj" />
    <ProjectReference Include="..\..\samples\MauiUnit.Samples.App\MauiUnit.Samples.App.csproj" />
  </ItemGroup>

</Project>
