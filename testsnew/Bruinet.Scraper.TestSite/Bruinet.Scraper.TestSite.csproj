<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Scraper's test site: served by the Scraper tests, and on its own by the loop (tools/Scripts/scrape-loop.ps1). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>false</IsTestProject>
    <RootNamespace>Bruinet.Scraper.TestSite</RootNamespace>
    <!-- testsnew adds the test SDK, whose own Main would clash with this one. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <None Update="TestSite\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
