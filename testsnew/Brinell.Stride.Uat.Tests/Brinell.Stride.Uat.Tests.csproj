<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Brinell.Stride.Uat.Tests</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\srcnew\Brinell.Uat\Brinell.Uat.csproj" />
    <ProjectReference Include="..\Brinell.Stride.UITests\Brinell.Stride.UITests.csproj" />
    <ProjectReference Include="..\..\samples\Brinell.Samples.Stride.App\Brinell.Samples.Stride.App.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="uat.config.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Scenarios\**\*.uat.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestSettings\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildStrideSampleApp" BeforeTargets="Build">
    <MSBuild Projects="..\..\samples\Brinell.Samples.Stride.App\Brinell.Samples.Stride.App.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
  </Target>

</Project>
