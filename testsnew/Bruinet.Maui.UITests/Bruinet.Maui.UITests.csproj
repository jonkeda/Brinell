<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bruinet.Maui.UITests</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\srcnew\Bruinet.Core\Bruinet.Core.csproj" />
    <ProjectReference Include="..\..\srcnew\Bruinet.Maui.CommunityToolkit\Bruinet.Maui.CommunityToolkit.csproj" />
    <ProjectReference Include="..\..\srcnew\Bruinet.Maui\Bruinet.Maui.csproj" />
    <ProjectReference Include="..\..\srcnew\Bruinet.Maui.FlaUI\Bruinet.Maui.FlaUI.csproj" />
    <!-- Android and iOS. MauiDriverFactory loads this by assembly name at runtime, so the
         compile-time reference is optional but the assembly must reach the output directory;
         without it an APPIUM_PLATFORM=android run fails in the fixture constructor. -->
    <ProjectReference Include="..\..\srcnew\Bruinet.Maui.Appium\Bruinet.Maui.Appium.csproj" />
    <!-- The MauiUnit head (BRUINET_HEAD=mauiunit, .my/mUnit): both sample apps compiled for plain net10.0,
         their files linked from the apps, rendered in memory by the fixtures' CreateInMemoryOptions. -->
    <ProjectReference Include="..\..\srcnew\Bruinet.Maui.MauiUnit\Bruinet.Maui.MauiUnit.csproj" />
    <ProjectReference Include="..\..\samples\Bruinet.Samples.Maui.App.Headless\Bruinet.Samples.Maui.App.Headless.csproj" />
    <ProjectReference Include="..\..\samples\Bruinet.Samples.Maui.ShellApp.Headless\Bruinet.Samples.Maui.ShellApp.Headless.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Pages\ViewPages\" />
  </ItemGroup>

  <!--
    Step 35: the per-class timing baseline the report compares against. Refresh it by copying a good
    run's TestResults/.../attachments/test-timings-baseline-candidate.json over this file.
  -->
  <ItemGroup>
    <None Include="timing-baseline.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('timing-baseline.json')" />
  </ItemGroup>

  <!-- The UAT suite: uat.config.md, Features/ and Uat/ (the fixture and the scenario test class). -->
  <ItemGroup>
    <ProjectReference Include="..\..\srcnew\Bruinet.Uat\Bruinet.Uat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="uat.config.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Features\**\*.feature.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Features\**\*.video.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="ExpectedFailures\**\*.feature.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestSettings\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Bruinet.Bdd" />
  </ItemGroup>

</Project>
