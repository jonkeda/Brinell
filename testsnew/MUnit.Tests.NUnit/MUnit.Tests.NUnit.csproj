<Project Sdk="Microsoft.NET.Sdk">

  <!-- MUnit on NUnit: the same examples, to show MUnit needs no xUnit. -->
  <PropertyGroup>
    <RootNamespace>MUnit.Tests.NUnit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- testsnew/Directory.Build.props adds xUnit to every test project. -->
    <PackageReference Remove="xunit" />
    <PackageReference Remove="xunit.runner.visualstudio" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\srcnew\MUnit\MUnit.csproj" />
    <ProjectReference Include="..\..\samples\MUnit.Samples.App\MUnit.Samples.App.csproj" />
  </ItemGroup>

</Project>
