@* One element per driver member (.my/bunit/plan.md step 2); each echoes what reached it. *@
<input data-testid="name" @bind="name" />
<span data-testid="name-echo">@name</span>

<input data-testid="live" @bind="live" @bind:event="oninput" />
<span data-testid="live-echo">@live</span>

<input data-testid="plain" value="first" />

<textarea data-testid="notes" @bind="notes"></textarea>
<span data-testid="notes-echo">@notes</span>

<input type="checkbox" data-testid="agree" @bind="agree" />
<span data-testid="agree-echo">@agree</span>

<input type="checkbox" data-testid="tick" checked="@tick" @onclick="() => tick = !tick" />
<span data-testid="tick-echo">@tick</span>

<select data-testid="colour" @bind="colour">
    <option value="red">Red</option>
    <option value="green">Green</option>
</select>
<span data-testid="colour-echo">@colour</span>

<select data-testid="sizes" multiple @onchange="Sizes">
    <option value="s">S</option>
    <option value="m">M</option>
    <option value="l">L</option>
</select>
<span data-testid="sizes-echo">@string.Join(",", sizes)</span>

<button data-testid="off" disabled @onclick="() => offClicks++">Off</button>
<span data-testid="off-echo">@offClicks</span>

<div data-testid="pointer" @ondblclick="Double" @oncontextmenu="Right">Pointer</div>
<span data-testid="pointer-echo">@pointer</span>

<input data-testid="keys" @onkeydown="e => keys += e.Key" @onfocus="FocusIn" @onblur="FocusOut" />
<span data-testid="keys-echo">@keys</span>
<span data-testid="focus-echo">@focus</span>

<form data-testid="form" @onsubmit="() => submitted++">
    <input data-testid="form-field" />
    <button data-testid="form-submit">Send</button>
</form>
<span data-testid="submit-echo">@submitted</span>

<form @onsubmit="() => submitted++">
    <button data-testid="form-handled" @onclick="() => handled++">Handled</button>
    <button type="button" data-testid="form-plain" @onclick="() => handled++">Plain</button>
</form>
<span data-testid="handled-echo">@handled</span>

<a data-testid="link" href="/elsewhere">Elsewhere</a>
<a data-testid="link-handled" href="/handled" @onclick="() => linkClicks++">Handled link</a>
<a data-testid="link-prevented" href="/prevented" @onclick="() => linkClicks++" @onclick:preventDefault>Prevented link</a>
<span data-testid="link-echo">@linkClicks</span>

<input type="radio" name="size" data-testid="size-s" value="small" @onchange="e => size = e.Value?.ToString() ?? string.Empty" />
<input type="radio" name="size" data-testid="size-plain" @onchange="e => size = e.Value?.ToString() ?? string.Empty" />
<span data-testid="size-echo">@size</span>

<EditForm Model="this">
    <InputRadioGroup @bind-Value="pet">
        <InputRadio data-testid="pet-cat" Value="@("cat")" />
        <InputRadio data-testid="pet-dog" Value="@("dog")" />
    </InputRadioGroup>
</EditForm>
<span data-testid="pet-echo">@pet</span>

<button data-testid="wrap" @onclick="() => wrapped++"><span data-testid="wrap-inner">Inner</span></button>
<span data-testid="wrap-echo">@wrapped</span>

<input data-testid="refuse" value="@refused" @onchange="Refuse" />

<select data-testid="adder" @onchange="Add">
    <option value="">Add</option>
    <option value="dog">Dog</option>
</select>
<span data-testid="added-echo">@string.Join(",", added)</span>

<input data-testid="number" @bind="number" />

<div data-testid="hidden" hidden>Hidden</div>
<div id="blazor-error-ui" data-testid="error-ui">An unhandled error has occurred.</div>
<div style="display: none"><span data-testid="hidden-child">Hidden child</span></div>
<div data-testid="invisible" style="visibility:hidden">Invisible</div>

<ul data-testid="list">
    <li class="item first" id="one" name="one" data-automation-id="auto-one">Apple pie</li>
    <li class="item">Banana <b>split</b></li>
</ul>

<button data-testid="throws" @onclick="Throws">Throws</button>
<button data-testid="throws-later" @onclick="ThrowsLater">Throws later</button>

@code {
    private string name = string.Empty;
    private string live = string.Empty;
    private string notes = string.Empty;
    private bool agree;
    private bool tick;
    private string colour = "red";
    private string[] sizes = [];
    private int offClicks;
    private string pointer = string.Empty;
    private string keys = string.Empty;
    private string focus = string.Empty;
    private int submitted;
    private int wrapped;
    private string refused = "20";
    private List<string> added = [];
    private int number;
    private int handled;
    private int linkClicks;
    private string size = string.Empty;
    private string pet = "cat";

    // The rules refuse every try: the value stays what it was.
    private void Refuse(ChangeEventArgs e) => refused = "20";

    // Adds the pick and leaves the picker on its placeholder.
    private void Add(ChangeEventArgs e) => added.Add(e.Value?.ToString() ?? string.Empty);

    private void Double() => pointer = "double";

    private void Right() => pointer = "right";

    private void FocusIn() => focus = "in";

    private void FocusOut() => focus = "out";

    private void Sizes(ChangeEventArgs e) => sizes = e.Value as string[] ?? [];

    private void Throws() => throw new InvalidOperationException("the handler broke");

    private async Task ThrowsLater()
    {
        await Task.Delay(300);
        throw new InvalidOperationException("the handler broke later");
    }
}
