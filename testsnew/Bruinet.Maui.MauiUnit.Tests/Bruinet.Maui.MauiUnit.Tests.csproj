<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The MauiUnit head on the sample app's own pages and the device suite's own page objects: the
    XAML views, their view models and the page objects are linked from where they live, not copied,
    so a change there is tested here too. The sample app itself targets platforms only, which is why
    its files are linked into this plain net10.0 MAUI project instead of referenced.
  -->
  <PropertyGroup>
    <RootNamespace>Bruinet.Maui.MauiUnit.Tests</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\srcnew\Bruinet.Maui.MauiUnit\Bruinet.Maui.MauiUnit.csproj" />
    <ProjectReference Include="..\..\samples\Bruinet.Samples.Shared\Bruinet.Samples.Shared.csproj" />
  </ItemGroup>

  <!-- The app's pages, views and view models under test. -->
  <ItemGroup>
    <Compile Include="..\..\samples\Bruinet.Samples.Maui.App\ViewModels\ButtonsViewModel.cs" Link="App\ButtonsViewModel.cs" />
    <Compile Include="..\..\samples\Bruinet.Samples.Maui.App\ViewModels\ToggleViewModel.cs" Link="App\ToggleViewModel.cs" />
    <MauiXaml Include="..\..\samples\Bruinet.Samples.Maui.App\Pages\ButtonsPage.xaml" Link="App\ButtonsPage.xaml" />
    <Compile Include="..\..\samples\Bruinet.Samples.Maui.App\Pages\ButtonsPage.xaml.cs" Link="App\ButtonsPage.xaml.cs" DependentUpon="ButtonsPage.xaml" />
    <MauiXaml Include="..\..\samples\Bruinet.Samples.Maui.App\Views\ButtonsView.xaml" Link="App\ButtonsView.xaml" />
    <Compile Include="..\..\samples\Bruinet.Samples.Maui.App\Views\ButtonsView.xaml.cs" Link="App\ButtonsView.xaml.cs" DependentUpon="ButtonsView.xaml" />
    <MauiXaml Include="..\..\samples\Bruinet.Samples.Maui.App\Pages\TogglePage.xaml" Link="App\TogglePage.xaml" />
    <Compile Include="..\..\samples\Bruinet.Samples.Maui.App\Pages\TogglePage.xaml.cs" Link="App\TogglePage.xaml.cs" DependentUpon="TogglePage.xaml" />
    <MauiXaml Include="..\..\samples\Bruinet.Samples.Maui.App\Views\ToggleView.xaml" Link="App\ToggleView.xaml" />
    <Compile Include="..\..\samples\Bruinet.Samples.Maui.App\Views\ToggleView.xaml.cs" Link="App\ToggleView.xaml.cs" DependentUpon="ToggleView.xaml" />
  </ItemGroup>

  <!-- The device suite's page objects, unchanged. -->
  <ItemGroup>
    <Compile Include="..\Bruinet.Maui.UITests\Pages\ButtonsTestPage.cs" Link="PageObjects\ButtonsTestPage.cs" />
    <Compile Include="..\Bruinet.Maui.UITests\Pages\ToggleTestPage.cs" Link="PageObjects\ToggleTestPage.cs" />
  </ItemGroup>

</Project>
