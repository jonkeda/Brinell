<Project Sdk="Microsoft.NET.Sdk">

  <!-- L5 of .my/sql-replay/plan.md: the SQL log's netstandard2.0 build in a .NET Framework app, over the framework's own
       System.Data.SqlClient. Windows only, so outside Brinell.sln: dotnet test this project. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Brinell.Mocking.Data.Net48.Tests</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\srcnew\Brinell.Mocking.Data\Brinell.Mocking.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Data" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
